{"id": "EUVD-2026-105103", "enisaUuid": "6b1de927-b0be-30b1-96aa-116aa53f9567", "description": "ApostropheCMS is an open-source Node.js content management system. Prior to 3.7.1 of the import-export module, predictable export archive filenames allow an unauthenticated requester to download another user's export from publicly readable export storage before the archive expires or is removed. A user with export permission must first create the archive, and sites with exports disabled, private upload storage, or authenticated upload delivery are not exposed through this network-download path. This issue is fixed in version 3.7.1.", "datePublished": "2026-10-20T15:47:25", "dateUpdated": "2026-10-20T16:22:21", "baseScore": 6.0, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:P/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/apostrophecms/apostrophe/security/advisories/GHSA-5gc8-frw3-3vqm", "https://github.com/apostrophecms/apostrophe/commit/06e4b377f3c360f9e89c32dccd7e505ad5ddf498", "https://github.com/apostrophecms/apostrophe/commit/40b989b1a9dd23d30029b8ce7668634265cfe5ea", "https://github.com/apostrophecms/apostrophe/releases/tag/@apostrophecms/import-export@3.7.1"], "aliases": ["CVE-2026-112953", "GHSA-5gc8-frw3-3vqm"], "assigner": "GitHub_M", "epss": 0.57, "enisaIdProduct": [{"id": "93ce2f3f-6782-3158-a191-c9df0a6dc107", "product": {"name": "import-export", "vendor": {"name": "apostrophecms"}}, "product_version": "< 3.7.1"}, {"id": "dfff142c-5ab7-37d8-8648-7ecd8d23666b", "product": {"name": "Apostrophe ", "vendor": {"name": "apostrophecms"}}, "product_version": "< 4.34.0"}], "enisaIdVendor": [{"id": "ba9149c5-603c-3889-b0ec-f0c1082f6f1b", "vendor": {"name": "apostrophecms"}}, {"id": "ebfc6b97-b62d-35b9-a240-c01d0647ee87", "vendor": {"name": "@apostrophecms"}}], "isExploited": false}