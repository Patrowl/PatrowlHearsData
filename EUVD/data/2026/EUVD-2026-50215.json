{"id": "EUVD-2026-50215", "enisaUuid": "58e289f1-a97a-3edd-ae69-d517ade752ae", "description": "Keycloak provides a way to manage identity providers and organizations through its administrative API. A flaw was discovered where an administrator with permission to manage identity providers could link a new provider to an organization without having the required permissions to manage that organization. This could allow an unauthorized administrator to influence how users log into specific organizations.", "datePublished": "2026-07-29T08:34:47", "dateUpdated": "2026-09-16T18:34:26", "baseScore": 5.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:L/I:H/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:68277", "https://access.redhat.com/errata/RHSA-2026:68278", "https://access.redhat.com/security/cve/CVE-2026-18201", "https://bugzilla.redhat.com/show_bug.cgi?id=2508290"], "aliases": ["CVE-2026-18201", "GHSA-fvjx-r757-3r6r"], "assigner": "redhat", "epss": 0.38, "enisaIdProduct": [{"id": "36fcef44-47d9-3d22-acdd-a2235fbdf7d2", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6.7-3"}, {"id": "aba2bd9a-2d6d-3d0e-b57f-fbb88f047cda", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6-20"}], "enisaIdVendor": [{"id": "c2745125-5bfd-351f-9bef-79dee01d9094", "vendor": {"name": "Red Hat"}}], "isExploited": false}