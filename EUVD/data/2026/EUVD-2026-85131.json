{"id": "EUVD-2026-85131", "enisaUuid": "c262e1fd-dc13-3dcb-813c-6cc91332699d", "description": "When processing a specially crafted PDF file, Foxit PDF Editor/Reader may encounter a reentrant execution condition involving JavaScript triggered by page-visibility events. This can cause the application to access a released page-view object while calculating annotation boundaries, resulting in an invalid memory read and application crash.", "datePublished": "2026-09-23T07:51:25", "dateUpdated": "2026-09-23T14:47:49", "baseScore": 7.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H", "references": ["https://www.foxit.com/support/security-bulletins.html"], "aliases": ["GHSA-3595-pphf-q59v", "CVE-2026-91791"], "assigner": "Foxit", "epss": 0.14, "enisaIdProduct": [{"id": "135c8c30-a2e7-38f3-944e-c797bf88b18e", "product": {"name": "Foxit PDF Editor", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 2026.2 and earlier"}, {"id": "5fc5602f-fd5b-314a-af5f-f8d565b36eea", "product": {"name": "Foxit PDF Editor", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 13.2.6 and earlier"}, {"id": "70469d18-4345-3a2e-896e-96b2fbecc9c4", "product": {"name": "Foxit PDF Reader", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 2026.2 and earlier"}, {"id": "ae81c299-deab-3db7-9426-0de644aaf258", "product": {"name": "Foxit PDF Editor", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 14.0.7 and earlier"}], "enisaIdVendor": [{"id": "4f9f8f60-41af-3c70-80fd-990a3efa7deb", "vendor": {"name": "Foxit Software Inc."}}], "isExploited": false}