{"id": "EUVD-2026-94388", "enisaUuid": "aa899c09-544e-3ab0-8e48-de80fac2cc7f", "description": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-32, missing validation and resource checks in the ASE decoder allow a crafted ASE image to cause a crash or a long-running operation. This issue is fixed in version 7.1.2-32.", "datePublished": "2026-10-07T15:25:46", "dateUpdated": "2026-10-07T16:19:05", "baseScore": 5.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L", "references": ["https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-gwj6-pm7x-3r63", "https://github.com/ImageMagick/ImageMagick/commit/0691546106f4c7e8857da9f21a0e4a8f41915388", "https://github.com/ImageMagick/ImageMagick/commit/5ecd5b047cee7ccfe4e14a733a0755c7b2a90c7d", "https://github.com/ImageMagick/ImageMagick/releases/tag/7.1.2-32"], "aliases": ["CVE-2026-106569"], "assigner": "GitHub_M", "epss": 0.38, "enisaIdProduct": [{"id": "599bd1d5-7e72-3844-a10c-5dcb1f8cf506", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "< 7.1.2-32"}], "enisaIdVendor": [{"id": "dc3a96fa-850b-3b47-b664-5a730aed4499", "vendor": {"name": "ImageMagick"}}], "isExploited": false}