{"id": "EUVD-2026-108277", "enisaUuid": "62efb87a-bed0-3dbc-bc31-9b7ab0929c5c", "description": "LiteLLM is a proxy server (AI Gateway) to call LLM APIs in OpenAI (or native) format. From 1.87.0 until 1.100.4, 1.101.3, 1.102.2, 1.103.1, and 1.104.0-rc.2, the proxy reuses one cryptographic context for at-rest secrets and session tokens, allowing an authenticated internal user to have crafted metadata containing a forged administrator credential encrypted and returned by the API-key flow. Replaying that ciphertext as a bearer token causes the proxy to trust the forged proxy administrator identity, permitting administrative access and arbitrary commands through the MCP stdio endpoint. Versions 1.87.0 through 1.90.x require EXPERIMENTAL_UI_LOGIN to be enabled, while versions after 1.91.0 are exploitable in the default configuration. This issue was fixed in LiteLLM 1.100.4, 1.101.3, 1.102.2, 1.103.1, and 1.104.0-rc.2.", "datePublished": "2026-10-22T18:01:52", "dateUpdated": "2026-10-22T18:01:52", "baseScore": 9.9, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:H", "references": ["https://github.com/BerriAI/litellm/security/advisories/GHSA-7hp6-4w63-5g45", "https://github.com/BerriAI/litellm/commit/1d5fdc87fed66b49e1df8cf7d708ad93249eb7d0", "https://github.com/BerriAI/litellm/commit/9161d7f9d6073603ba61ee4aa5e2c0ef5b37a81b", "https://github.com/BerriAI/litellm/commit/9fa1a641119dd0d4fe43e93622eae5f482ceb63f", "https://github.com/BerriAI/litellm/commit/a80eacacee118fbed54e3d98f239d17a63fac818", "https://github.com/BerriAI/litellm/commit/f7cd90f09e9716652b38daec9f0640cdf49d582b", "https://github.com/BerriAI/litellm/releases/tag/v1.100.4", "https://github.com/BerriAI/litellm/releases/tag/v1.101.3", "https://github.com/BerriAI/litellm/releases/tag/v1.102.2", "https://github.com/BerriAI/litellm/releases/tag/v1.103.1", "https://github.com/BerriAI/litellm/releases/tag/v1.104.0-rc.2"], "aliases": ["CVE-2026-114612"], "assigner": "GitHub_M", "epss": 0.0, "enisaIdProduct": [{"id": "0a29932c-2315-34f1-ba11-fa682b1f627e", "product": {"name": "LiteLLM", "vendor": {"name": "berriai"}}, "product_version": "1.87.0, < 1.100.4"}, {"id": "1943941d-2ce7-3bbd-b804-fee37e54d21f", "product": {"name": "LiteLLM", "vendor": {"name": "berriai"}}, "product_version": "1.103.0, < 1.103.1"}, {"id": "30f78758-34ba-390e-b289-f690e2d4550a", "product": {"name": "LiteLLM", "vendor": {"name": "berriai"}}, "product_version": "1.101.0, < 1.101.3"}, {"id": "7b892409-2b21-3131-85f1-c961b9736f07", "product": {"name": "LiteLLM", "vendor": {"name": "berriai"}}, "product_version": "1.102.0, < 1.102.2"}, {"id": "bad2849f-02df-342c-87fe-22141fe0a2bf", "product": {"name": "LiteLLM", "vendor": {"name": "berriai"}}, "product_version": "1.104.0-rc.1, < 1.104.0-rc.2"}], "enisaIdVendor": [{"id": "f24a2386-3479-38f4-8783-8f922a0666f7", "vendor": {"name": "berriai"}}], "isExploited": false}