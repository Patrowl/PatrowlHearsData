{"id": "EUVD-2026-42382", "enisaUuid": "ddcae011-4482-38e4-bd4b-f81f4384e075", "description": "A flaw was found in `guardrails-detectors`, a component of Red Hat OpenShift AI. This vulnerability, known as Regular Expression Denial of Service (ReDoS), allows a remote attacker to provide specially crafted regular expressions to the public detection API. This can cause catastrophic backtracking, leading to a worker process consuming 100% CPU indefinitely and resulting in a denial of service for the entire guardrails-mediated LLM pipeline.", "datePublished": "2026-07-08T19:50:51", "dateUpdated": "2026-09-30T16:55:29", "baseScore": 6.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:A/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:53261", "https://access.redhat.com/errata/RHSA-2026:53262", "https://access.redhat.com/errata/RHSA-2026:53263", "https://access.redhat.com/errata/RHSA-2026:60520", "https://access.redhat.com/errata/RHSA-2026:65126", "https://access.redhat.com/errata/RHSA-2026:73987", "https://access.redhat.com/security/cve/CVE-2026-15154", "https://bugzilla.redhat.com/show_bug.cgi?id=2498188"], "aliases": ["CVE-2026-15154", "GHSA-jm96-7wvj-j3r9"], "assigner": "redhat", "epss": 0.48, "enisaIdProduct": [{"id": "6d7c0039-b721-3bdb-95a2-6c804b0aeffc", "product": {"name": "Red Hat OpenShift AI 2.25", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1787235925"}, {"id": "7e20a181-23de-33dd-bece-81f41ae56601", "product": {"name": "Red Hat OpenShift AI 3.4", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1783569145"}, {"id": "a15dd9c0-8ce9-3e41-8d9c-9f582af3c562", "product": {"name": "Red Hat OpenShift AI 3.4", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1786617316"}, {"id": "c849aa4e-dee6-3b65-b912-cac3815bddb2", "product": {"name": "Red Hat OpenShift AI 3.3", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1785137880"}, {"id": "d5eea126-f821-3b3e-a88a-dc116ecfd7a9