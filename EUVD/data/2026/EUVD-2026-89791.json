{"id": "EUVD-2026-89791", "enisaUuid": "0047c75e-2c1d-3fc3-95f7-a42416827e56", "description": "Apache WSS4J accepted attacker-controlled derived-key lengths and offsets without adequate bounds. This could permit cryptographically weak keys or excessive CPU and memory consumption when processing crafted WS-Security messages. The fixes enforce a minimum key length of 16 bytes, a maximum length of 512 bytes, and a maximum offset of 4096 bytes.\nUsers are recommended to upgrade to versions 4.0.2 or 3.0.6 or 2.4.4, which fix this issue.", "datePublished": "2026-09-30T11:55:53", "dateUpdated": "2026-09-30T19:46:00", "baseScore": 7.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://lists.apache.org/thread.html/7jllcpbf4nbzhdp2vchz5yplnl5w6vd6"], "aliases": ["GHSA-5x6j-m6jc-q2r5", "CVE-2026-85532"], "assigner": "apache", "epss": 0.55, "enisaIdProduct": [{"id": "0c46dcd8-20af-389d-9813-919b26e2bee9", "product": {"name": "Apache WSS4J", "vendor": {"name": "Apache Software Foundation"}}, "product_version": "3.0.0 <3.0.6"}, {"id": "937d2b14-2832-3f23-9c54-81da7a3e7b44", "product": {"name": "Apache WSS4J", "vendor": {"name": "Apache Software Foundation"}}, "product_version": "0 <2.4.4"}, {"id": "e12f6098-8624-3285-b44b-3d1a24bd31de", "product": {"name": "Apache WSS4J", "vendor": {"name": "Apache Software Foundation"}}, "product_version": "4.0.0 <4.0.2"}], "enisaIdVendor": [{"id": "18d4bed2-5731-33b4-be63-cca403417943", "vendor": {"name": "Apache Software Foundation"}}], "isExploited": false}