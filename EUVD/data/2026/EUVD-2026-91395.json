{"id": "EUVD-2026-91395", "enisaUuid": "fa6d2ef5-d373-391b-8e3e-3d8493e91064", "description": "YesWiki before 4.6.7 contains a missing authorization vulnerability in the attachment download handler that allows unauthenticated attackers to bypass page read ACLs. Attackers can request the download handler with a known page tag and file parameter to retrieve confidential attachments from read-restricted pages.", "datePublished": "2026-10-02T11:38:36", "dateUpdated": "2026-10-02T14:09:06", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/YesWiki/yeswiki/security/advisories/GHSA-7cj2-9pgf-vcw2", "https://www.vulncheck.com/advisories/yeswiki-before-4.6.7-missing-authorization-via-attachment-download-handler"], "aliases": ["CVE-2026-104472", "GHSA-m45w-rvq4-f22g"], "assigner": "VulnCheck", "epss": 0.35, "enisaIdProduct": [{"id": "b750f019-12bc-3a6b-8a7d-5e2c3edcb887", "product": {"name": "yeswiki", "vendor": {"name": "YesWiki"}}, "product_version": "0 <4.6.7"}], "enisaIdVendor": [{"id": "400ff3a2-8400-3abf-ac76-5b27fe2e67dc", "vendor": {"name": "YesWiki"}}], "isExploited": false}