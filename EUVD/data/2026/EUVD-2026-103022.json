{"id": "EUVD-2026-103022", "enisaUuid": "390d8156-72b3-3d17-b3d7-14fc1f4b5475", "description": "Improper verification of the source of a communication channel in the DNS resolver in Amazon FreeRTOS-Plus-TCP before V4.4.2 might allow remote third-party to insert a chosen address into the device's DNS cache via a forged DNS reply.\n\n\n\nTo remediate this issue, users should upgrade to version V4.4.2 and enable ipconfigDNS_CHECK_REPLY_SOURCE_IP.", "datePublished": "2026-10-16T17:28:47", "dateUpdated": "2026-10-19T12:54:33", "baseScore": 8.2, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:H/AT:N/PR:N/UI:N/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/FreeRTOS/FreeRTOS-Plus-TCP/releases/tag/V4.4.2", "https://aws.amazon.com/security/security-bulletins/2026-139-aws/", "https://github.com/FreeRTOS/FreeRTOS-Plus-TCP/security/advisories/GHSA-h4fw-pv82-p7h5"], "aliases": ["CVE-2026-102552"], "assigner": "AMZN", "epss": 0.23, "enisaIdProduct": [{"id": "1e080df1-667c-3b9e-8434-401f79936890", "product": {"name": "FreeRTOS-Plus-TCP", "vendor": {"name": "aws"}}, "product_version": "0 \u22644.4.1"}], "enisaIdVendor": [{"id": "8bdff228-36e0-3287-86fd-ca7296efc9d5", "vendor": {"name": "FreeRTOS"}}], "isExploited": false}