{"id": "EUVD-2026-78060", "enisaUuid": "e8492a43-e0f2-3f7e-a926-9591b160754c", "description": "IBM WebSphere Application Server 8.5 and 9.0, and IBM WebSphere Application Server - Liberty 17.0.0.3\u00a0through 26.0.0.8\u00a0are vulnerable to HTTP request smuggling, caused by improper parsing of the HTTP transfer-encoding request header. By sending a specially crafted HTTP transfer-encoding request header, an attacker could exploit this vulnerability to poison the web cache, bypass web application firewall protection, and conduct XSS attacks.", "datePublished": "2026-09-14T20:01:35", "dateUpdated": "2026-10-22T18:53:54", "baseScore": 6.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:N", "references": ["https://www.ibm.com/support/pages/node/7286610", "https://www.ibm.com/support/pages/node/7286611"], "aliases": ["GHSA-mq4f-p367-w4xc", "CVE-2026-15634"], "assigner": "ibm", "epss": 0.25, "enisaIdProduct": [{"id": "90ecab94-c1fb-3171-b816-2cdfd8467ca9", "product": {"name": "WebSphere Application Server", "vendor": {"name": "IBM"}}, "product_version": "8.5"}, {"id": "aec9f49e-e8bb-3d2e-98a9-b4eb5dfbef58", "product": {"name": "WebSphere Application Server", "vendor": {"name": "IBM"}}, "product_version": "9.0"}, {"id": "e2a55230-400a-3df8-9c14-7d4b61006adb", "product": {"name": "WebSphere Application Server - Liberty", "vendor": {"name": "IBM"}}, "product_version": "17.0.0.3 \u226426.0.0.5"}], "enisaIdVendor": [{"id": "066883d9-56f3-3b35-9326-7c0de1ef5a80", "vendor": {"name": "IBM"}}], "isExploited": false}