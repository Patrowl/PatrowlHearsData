{"id": "EUVD-2026-106999", "enisaUuid": "26c7a404-f7a1-30bf-8e5c-afadfbd45536", "description": "WWBN AVideo before 24.0 contains a cross-site request forgery vulnerability in legacy endpoints like playlistStatus.php that bypass the .json.php-only autoCSRFGuard() check. Attackers can lure logged-in users to a page with an auto-submitting form to make private playlists public, remove playlist videos, or forge video suggestions.", "datePublished": "2026-10-21T00:36:26", "dateUpdated": "2026-10-21T00:36:26", "baseScore": 5.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:P/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/WWBN/AVideo/security/advisories/GHSA-9pf9-6jr6-fvjr", "https://www.vulncheck.com/advisories/wwbn-avideo-before-24.0-csrf-via-legacy-playlist-and-video-endpoints"], "aliases": ["GHSA-c2pw-6qrh-h3c9", "CVE-2026-114048"], "assigner": "VulnCheck", "epss": 0.13, "enisaIdProduct": [{"id": "d3266db9-77cf-338f-83c1-6226f2ccbcd3", "product": {"name": "AVideo", "vendor": {"name": "WWBN"}}, "product_version": "0 <24.0"}], "enisaIdVendor": [{"id": "70457fdd-bccf-3341-ae2f-632d76ddd2e7", "vendor": {"name": "WWBN"}}], "isExploited": false}