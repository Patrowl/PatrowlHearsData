{"id": "EUVD-2026-6850", "enisaUuid": "b6bcfd0e-21a6-3436-ba11-3caf0e53848d", "description": "Axios is a promise based HTTP client for the browser and Node.js. Prior to versions 0.30.3 and 1.13.5, the mergeConfig function in axios crashes with a TypeError when processing configuration objects containing __proto__ as an own property. An attacker can trigger this by providing a malicious configuration object created via JSON.parse(), causing complete denial of service. This vulnerability is fixed in versions 0.30.3 and 1.13.5.", "datePublished": "2026-02-09T20:11:22", "dateUpdated": "2026-09-10T12:05:02", "baseScore": 7.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://github.com/axios/axios/security/advisories/GHSA-43fc-jf86-j433", "https://github.com/axios/axios/pull/7369", "https://github.com/axios/axios/pull/7388", "https://github.com/axios/axios/commit/28c721588c7a77e7503d0a434e016f852c597b57", "https://github.com/axios/axios/commit/d7ff1409c68168d3057fc3891f911b2b92616f9e", "https://github.com/axios/axios/releases/tag/v0.30.3", "https://github.com/axios/axios/releases/tag/v1.13.5"], "aliases": ["GHSA-43fc-jf86-j433", "CVE-2026-25639"], "assigner": "GitHub_M", "epss": 1.99, "enisaIdProduct": [{"id": "16e57894-27d3-3637-a340-8600ba956ca1", "product": {"name": "axios", "vendor": {"name": "axios"}}, "product_version": "< 0.30.3"}, {"id": "d9c38e9f-2419-37ed-a880-161691051dbd", "product": {"name": "axios", "vendor": {"name": "axios"}}, "product_version": "1.0.0, < 1.13.5"}], "enisaIdVendor": [{"id": "86e77a8b-dd36-3cc1-a999-1aa70094505b", "vendor": {"name": "axios"}}], "isExploited": false}