{"id": "EUVD-2026-88167", "enisaUuid": "b81e8407-4b72-3147-ab76-bb9767fcfbc4", "description": "A vulnerability was detected in Trusted Domain Project OpenDMARC up to 1.4.2. Affected by this vulnerability is the function opendmarc_util_cleanup in the library libopendmarc/opendmarc_util.c of the component DMARC Record Parser. Performing a manipulation results in off-by-one. The attack may be initiated remotely. The exploit is now public and may be used. The patch is named b3b1da9264bc80324094a27c71e7369bdedc62ae. To fix this issue, it is recommended to deploy a patch.", "datePublished": "2026-09-28T08:15:13", "dateUpdated": "2026-09-28T12:43:21", "baseScore": 6.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:L/VA:L/SC:N/SI:N/SA:N/E:P", "references": ["https://vuldb.com/vuln/410884", "https://vuldb.com/vuln/410884/cti", "https://vuldb.com/cve/CVE-2026-101014", "https://vuldb.com/submit/917100", "https://github.com/trusteddomainproject/OpenDMARC/pull/188", "https://github.com/trusteddomainproject/OpenDMARC/pull/344", "https://weitongli.com/share/opendmarc-cleanup-off-by-one.html", "https://github.com/trusteddomainproject/OpenDMARC/commit/b3b1da9264bc80324094a27c71e7369bdedc62ae"], "aliases": ["GHSA-ccpv-xp3h-j99v", "CVE-2026-101014"], "assigner": "VulDB", "epss": 0.31, "enisaIdProduct": [{"id": "3e965ae7-7375-3174-955c-856ffc4ec3aa", "product": {"name": "OpenDMARC", "vendor": {"name": "Trusted Domain Project"}}, "product_version": "1.4.1"}, {"id": "994566d0-b5a5-3b98-8925-eea1d59b6fd7", "product": {"name": "OpenDMARC", "vendor": {"name": "Trusted Domain Project"}}, "product_version": "1.4.2"}, {"id": "a391156b-6267-366c-9978-395b009852ea", "product": {"name": "OpenDMARC", "vendor": {"name": "Trusted Domain Project"}}, "product_version": "1.4.0"}], "enisaIdVendor": [{"id": "9ac4fcdb-96eb-3e90-afea-f78660a53648", "vendor": {"name": "Trusted Domain Project"}}], "isExploited": false}