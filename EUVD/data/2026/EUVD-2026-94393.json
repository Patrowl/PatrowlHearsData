{"id": "EUVD-2026-94393", "enisaUuid": "ba711207-58e9-3f4c-bebb-3dc24f74f326", "description": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-31, a client connected to the distributed pixel cache server can send crafted pixel data that triggers an integer-size calculation error and a heap buffer overwrite, crashing the server. This issue is fixed in version 7.1.2-31.", "datePublished": "2026-10-07T15:35:22", "dateUpdated": "2026-10-07T16:17:22", "baseScore": 5.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:A/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-4fq9-vrx7-gv92", "https://github.com/ImageMagick/ImageMagick/commit/c69f54e1c8660e45f2ff83c354bf924a946d9356", "https://github.com/ImageMagick/ImageMagick/releases/tag/7.1.2-31"], "aliases": ["CVE-2026-106574"], "assigner": "GitHub_M", "epss": 0.21, "enisaIdProduct": [{"id": "f50b539e-7c86-38e3-ab4a-9cd2d615ebcc", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "< 7.1.2-31"}], "enisaIdVendor": [{"id": "2ee5d1a0-8047-3d78-baa0-4723063b83b5", "vendor": {"name": "ImageMagick"}}], "isExploited": false}