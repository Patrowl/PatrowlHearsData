{"id": "EUVD-2026-105209", "enisaUuid": "18f6b282-e578-3b51-8057-6445a94fd693", "description": "ApostropheCMS is an open-source Node.js content management system, and sanitize-html provides a simple HTML sanitizer with a clear API. Prior to sanitize-html 2.18.0, a non-default configuration that allows meta refresh elements and their http-equiv and content attributes can retain unsafe script or redirect destinations embedded in the refresh content value. This issue is fixed in sanitize-html 2.18.0.", "datePublished": "2026-10-20T17:11:20", "dateUpdated": "2026-10-21T15:53:24", "baseScore": 5.4, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:C/C:L/I:L/A:N", "references": ["https://github.com/apostrophecms/apostrophe/security/advisories/GHSA-cv27-6wvh-8x7j", "https://github.com/apostrophecms/apostrophe/commit/9500b8b0e1d630d5e07fbb5fd2c25ed0943845ce", "https://github.com/apostrophecms/apostrophe/commit/f84fd41cbf6c22eb8d0008fc9c25df1f7130b350", "https://github.com/apostrophecms/apostrophe/releases/tag/sanitize-html@2.18.0"], "aliases": ["CVE-2026-113661", "GHSA-cv27-6wvh-8x7j"], "assigner": "GitHub_M", "epss": 0.26, "enisaIdProduct": [{"id": "92d1e9b7-8bee-3a4e-be1d-3039fe80efa3", "product": {"name": "Apostrophe ", "vendor": {"name": "apostrophecms"}}, "product_version": "< 4.33.0"}, {"id": "bb9a3b60-924d-3d1f-b4c2-3fc877f2b4b3", "product": {"name": "sanitize-html", "vendor": {"name": "apostrophecms"}}, "product_version": "< 2.18.0"}], "enisaIdVendor": [{"id": "bde1ec66-9541-3c30-a57a-90d10e9f4b1a", "vendor": {"name": "apostrophecms"}}], "isExploited": false}