{"id": "EUVD-2026-107999", "enisaUuid": "cb9c0d79-904c-311c-99aa-5c7b1ebb2678", "description": "Roundcube Webmail before 1.6.20 and 1.7.x before 1.7.5 is affected by an improper authentication vulnerability in multi-host installations. When a user logs in with an alias address, rcube_user::query() matched the address against identity records without qualifying the lookup by IMAP host, so a login could be resolved to a user account belonging to a different IMAP host. Upstream fixed this in the commit \u201cFix bug where an alias login wasn\u2019t qualified by IMAP host\u201d.", "datePublished": "2026-10-22T02:16:51", "dateUpdated": "2026-10-22T02:16:51", "baseScore": 6.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:N", "references": ["https://bugs.debian.org/1151279", "https://github.com/roundcube/roundcubemail/commit/453c413d6851cf603bebdb15e58381f5ef9b8094", "https://roundcube.net/news/2026/10/19/security-updates-1.6.20-and-1.7.5", "https://github.com/roundcube/roundcubemail/releases/tag/1.7.5", "https://github.com/roundcube/roundcubemail/releases/tag/1.6.20", "https://github.com/roundcube/roundcubemail/commit/cb235cbfef88cbf78236dc67d3b667bf3dc61ddd"], "aliases": ["CVE-2026-114732", "GHSA-qc6m-xxcv-cwh2"], "assigner": "mitre", "epss": 0.36, "enisaIdProduct": [{"id": "20e0f19e-e073-3ce8-ac98-fb07ef615797", "product": {"name": "Webmail", "vendor": {"name": "bulwarkmail"}}, "product_version": "1.6.0 <1.6.20"}, {"id": "2b73774b-5548-3771-a34a-fa6b9ed0ad48", "product": {"name": "Webmail", "vendor": {"name": "bulwarkmail"}}, "product_version": "1.7.0 <1.7.5"}], "enisaIdVendor": [{"id": "dc5b86b9-67c2-38f9-8698-14b141f62f45", "vendor": {"name": "Roundcube"}}], "isExploited": false}