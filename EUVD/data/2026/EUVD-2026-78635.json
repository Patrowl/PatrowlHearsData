{"id": "EUVD-2026-78635", "enisaUuid": "e02ac3e2-f5d5-3f3a-a278-7e2501dc22ab", "description": "FreeRDP before 3.31.0 contains a buffer over-read vulnerability in the rts_read_result function within the RPC gateway transport parser. Attackers can send a malicious BIND_ACK PDU with a truncated result entry to trigger an out-of-bounds read causing process abort.", "datePublished": "2026-09-15T15:18:13", "dateUpdated": "2026-09-20T00:35:29", "baseScore": 7.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:P/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/FreeRDP/FreeRDP/security/advisories/GHSA-pj8w-fh79-f438", "https://www.vulncheck.com/advisories/freerdp-before-3.31.0-buffer-over-read-via-rts-gateway"], "aliases": ["GHSA-c7qq-9mg2-ccx2", "CVE-2026-91959"], "assigner": "VulnCheck", "epss": 0.38, "enisaIdProduct": [{"id": "cdbb24ab-3d26-3457-9565-07982112ecbb", "product": {"name": "FreeRDP", "vendor": {"name": "FreeRDP"}}, "product_version": "0 <3.31.0"}], "enisaIdVendor": [{"id": "0c9edfa2-7fb0-338a-afc6-a372c102cd70", "vendor": {"name": "FreeRDP"}}], "isExploited": false}