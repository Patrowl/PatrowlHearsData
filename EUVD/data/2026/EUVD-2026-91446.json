{"id": "EUVD-2026-91446", "enisaUuid": "2d2d2680-bee5-3293-b0f3-19ade3202e53", "description": "Zebra before 4.5.0 contains an uncontrolled resource consumption vulnerability that allows remote P2P peers to exhaust blocking-pool threads by sending oversized block locator vectors. Attackers can send getblocks or getheaders messages with up to 65,535 locator hashes, triggering per-hash chain lookups that degrade block validation, RPC, and mempool performance.", "datePublished": "2026-10-02T11:38:13", "dateUpdated": "2026-10-02T14:51:28", "baseScore": 6.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/ZcashFoundation/zebra/security/advisories/GHSA-443g-gwgp-49x4", "https://www.vulncheck.com/advisories/zebra-before-4.5.0-cpu-amplification-via-uncapped-getblocks-getheaders-locator-length"], "aliases": ["GHSA-4m38-rccq-j8gv", "CVE-2026-104436"], "assigner": "VulnCheck", "epss": 0.27, "enisaIdProduct": [{"id": "3a42eb4c-9d8a-3998-abf4-fd60b30dc922", "product": {"name": "zebra", "vendor": {"name": "ZcashFoundation"}}, "product_version": "0 <8.0.0"}, {"id": "46c10cb2-d3cb-38f5-bcd8-0891f80b61e5", "product": {"name": "zebra", "vendor": {"name": "ZcashFoundation"}}, "product_version": "0 <4.5.0"}], "enisaIdVendor": [{"id": "3253bccc-159c-340e-b2c7-b923c0ff17f7", "vendor": {"name": "ZcashFoundation"}}], "isExploited": false}