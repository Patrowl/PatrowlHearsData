{"id": "EUVD-2026-10009", "enisaUuid": "1a717106-0cbb-3174-87b2-a696e2fbf0a7", "description": "Authlib is a Python library which builds OAuth and OpenID Connect servers. From version 1.6.5 to before version 1.6.7, previous tests involving passing a malicious JWT containing alg: none and an empty signature was passing the signature verification step without any changes to the application code when a failure was expected.. This issue has been patched in version 1.6.7.", "datePublished": "2026-03-06T06:44:26", "dateUpdated": "2026-09-10T12:05:07", "baseScore": 7.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N/E:P", "references": ["https://github.com/authlib/authlib/security/advisories/GHSA-7wc2-qxgw-g8gg", "https://github.com/authlib/authlib/commit/a61c2acb807496e67f32051b5f1b1d5ccf8f0a75", "https://github.com/authlib/authlib/commit/b87c32ed07b8ae7f805873e1c9cafd1016761df7"], "aliases": ["GHSA-7wc2-qxgw-g8gg", "CVE-2026-28802", "PYSEC-2026-2118"], "assigner": "GitHub_M", "epss": 0.57, "enisaIdProduct": [{"id": "88b1921f-b8fe-3c51-a8ed-12e100773f8c", "product": {"name": "authlib", "vendor": {"name": "authlib"}}, "product_version": "1.6.5, < 1.6.7"}], "enisaIdVendor": [{"id": "6fb16302-65ad-30b1-94cc-24630494ecf0", "vendor": {"name": "authlib"}}], "isExploited": false}