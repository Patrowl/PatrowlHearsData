{"id": "EUVD-2026-42020", "enisaUuid": "4494a1d4-01e3-3404-af11-d8708c515ac0", "description": "A flaw was found in GIMP's PSD parser. An integer overflow in read_RLE_channel() can cause an undersized heap allocation for the RLE row-length table, after which subsequent per-row writes corrupt heap memory. This could lead to memory corruption, potentially resulting in denial of service or arbitrary code execution.", "datePublished": "2026-07-07T07:44:28", "dateUpdated": "2026-10-12T02:08:06", "baseScore": 7.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:L/UI:R/S:U/C:H/I:H/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:40751", "https://access.redhat.com/errata/RHSA-2026:73768", "https://access.redhat.com/errata/RHSA-2026:80509", "https://access.redhat.com/security/cve/CVE-2026-58384", "https://bugzilla.redhat.com/show_bug.cgi?id=2497431", "https://gitlab.gnome.org/GNOME/gimp/-/commit/da29e217", "https://gitlab.gnome.org/GNOME/gimp/-/issues/16216"], "aliases": ["CVE-2026-58384", "GHSA-pp89-6qxc-wh8f"], "assigner": "redhat", "epss": 0.26, "enisaIdProduct": [{"id": "0e7e0651-91db-30ef-b6dc-9b2360901207", "product": {"name": "Red Hat Enterprise Linux 9.4 Update Services for SAP Solutions", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 2:2.99.8-4.el9_4.19"}, {"id": "a56a2dcd-de8f-3bb2-b80e-f2231c3972dc", "product": {"name": "Red Hat Enterprise Linux 9.6 Extended Update Support", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 2:2.99.8-4.el9_6.20"}, {"id": "faa7dec7-a507-381d-8cc4-bcb2d2cd36a3", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 2:3.0.4-4.el9_8.7"}], "enisaIdVendor": [{"id": "18450d1d-63a6-3291-a52d-36fb6af57bfe", "vendor": {"name": "Red Hat"}}], "isExploited": false}