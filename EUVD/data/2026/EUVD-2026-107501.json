{"id": "EUVD-2026-107501", "enisaUuid": "6c21bb57-2961-30b6-a73e-e9bbfc269fe4", "description": "Apache Traffic Server 9.2.15, 10.1.4 and 10.2.0 write one unthrottled diagnostic log line for every internal @ header they strip, so a request carrying many such headers makes the proxy write far more log data than the request contains.\n\n\n\nThis issue affects Apache Traffic Server: 9.2.15, 10.1.4, 10.2.0.\n\n\n\nUsers are recommended to upgrade to version 9.2.16, 10.1.5, or 10.2.1, which fix the issue.", "datePublished": "2026-10-21T19:14:50", "dateUpdated": "2026-10-21T19:14:50", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://lists.apache.org/thread/r95dq29ywcd1f4x30snxlqmb12z4s4kc"], "aliases": ["CVE-2026-111810", "GHSA-fx98-vw52-fjmw"], "assigner": "apache", "epss": 0.26, "enisaIdProduct": [{"id": "45d49139-9b88-3857-b74d-fc76c64e13d6", "product": {"name": "Apache Traffic Server", "vendor": {"name": "Apache Software Foundation"}}, "product_version": "10.2.0"}, {"id": "6c783d8b-2516-3dfd-91bc-ef6c02f7b2a8", "product": {"name": "Apache Traffic Server", "vendor": {"name": "Apache Software Foundation"}}, "product_version": "10.1.4"}, {"id": "d4e742c1-01d8-30c2-b3c0-ecba5e4058cc", "product": {"name": "Apache Traffic Server", "vendor": {"name": "Apache Software Foundation"}}, "product_version": "9.2.15"}], "enisaIdVendor": [{"id": "2d6ef5bd-31b2-3fc3-b2d9-26f689177991", "vendor": {"name": "Apache Software Foundation"}}], "isExploited": false}