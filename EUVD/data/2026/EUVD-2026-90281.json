{"id": "EUVD-2026-90281", "enisaUuid": "5d56ec0f-8c3b-3ab7-b7da-2ea5f05888cb", "description": "Kiteworks Core did not apply its gateway-level API security controls to every request authenticated through the platform's central authentication service. An authenticated user could reach REST API functionality over a request path on which those controls, including enforcement of signed-out and revoked sessions, were not applied.", "datePublished": "2026-09-30T20:12:39", "dateUpdated": "2026-10-01T13:37:06", "baseScore": 5.4, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N", "references": ["https://github.com/kiteworks/security-advisories/security/advisories/GHSA-8q58-vrwm-jxhq", "https://raw.githubusercontent.com/cisagov/CSAF/develop/csaf_files/VA/white/2026/va-26-274-01.json"], "aliases": ["CVE-2026-102134"], "assigner": "cisa-cg", "epss": 0.21, "enisaIdProduct": [{"id": "1a88a203-be69-314f-93b8-da05e4006c2b", "product": {"name": "core", "vendor": {"name": "OPNsense"}}, "product_version": "0 <9.5.1"}], "enisaIdVendor": [{"id": "e2b73123-152c-3e88-abf0-28071d421c12", "vendor": {"name": "Kiteworks"}}], "isExploited": false}