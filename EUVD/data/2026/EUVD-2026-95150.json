{"id": "EUVD-2026-95150", "enisaUuid": "fd61fe5c-8cb2-338a-89b9-83e2ffd7b5d4", "description": "MariaDB Connector/Node.js is used to connect applications developed on Node.js to MariaDB and MySQL databases. Prior to 3.2.5, 3.3.4, 3.4.7, and 3.5.4, text-protocol escaping always prefixes quotes with a backslash and does not honor the session's NO_BACKSLASH_ESCAPES mode, including in Connection.escape(). When that mode is enabled, the backslash is an ordinary character, so an attacker-controlled placeholder value can close the SQL string literal and inject arbitrary SQL with the application's database privileges. The vulnerable configuration may be enabled server-wide, through connector initialization options, or with an application-issued SET sql_mode; execute() and batch() use binary protocols and are not affected. This issue is fixed in versions 3.2.5, 3.3.4, 3.4.7, and 3.5.4.", "datePublished": "2026-10-08T18:38:29", "dateUpdated": "2026-10-09T11:45:28", "baseScore": 7.4, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:H/A:H", "references": ["https://github.com/mariadb-corporation/mariadb-connector-nodejs/security/advisories/GHSA-r3rv-jm3r-62q2", "https://github.com/mariadb-corporation/mariadb-connector-nodejs/commit/6995c8cf8e51b2ad055de63dcaa4094eebbef5ce", "https://github.com/mariadb-corporation/mariadb-connector-nodejs/commit/7670d90949307e735c0ae148d80b3776478a599d", "https://github.com/mariadb-corporation/mariadb-connector-nodejs/commit/95886df9fa0cca991e2be339caa6c3979be61553", "https://github.com/mariadb-corporation/mariadb-connector-nodejs/commit/e5a9d732d9574177749488336319b73074072779", "https://hackerone.com/reports/3889197", "https://github.com/mariadb-corporation/mariadb-connector-nodejs/releases/tag/3.2.5", "https://github.com/mariadb-corporation/mariadb-connector-nodejs/releases/tag/3.3.4", "https://github.com/mariadb-corporation/mariadb-connector-nodejs/releases/tag/3.4.7", "https://github.com/mariadb-corporation/mariadb-connector-nodejs/releases/tag/3.5.4", "https://jira.mariadb.org/browse/CONJS-368"], "aliases": ["CVE-2026-107385", "GHSA-r3rv-jm3r-62q2"], "assigner": "GitHub_M", "epss": 0.44, "enisaIdProduct": [{"id": "2d97076b-343c-3469-8718-7dbdb912da30", "product": {"name": "mariadb-connector-nodejs", "vendor": {"name": "mariadb-corporation"}}, "product_version": "3.3.0, < 3.3.4"}, {"id": "737fbf43-0e75-3957-be49-1294d1cc0c4c", "product": {"name": "mariadb-connector-nodejs", "vendor": {"name": "mariadb-corporation"}}, "product_version": "< 3.2.5"}, {"id": "903f45a4-e5b2-3e4c-a53f-c090e6ea2883", "product": {"name": "mariadb-connector-nodejs", "vendor": {"name": "mariadb-corporation"}}, "product_version": "3.4.0, < 3.4.7"}, {"id": "a033f0c5-9414-32a3-a317-1b46c07188c5", "product": {"name": "mariadb-connector-nodejs", "vendor": {"name": "mariadb-corporation"}}, "product_version": "3.5.0-rc.0, < 3.5.4"}], "enisaIdVendor": [{"id": "5e522c16-f958-3587-be4f-fd62e07ca887", "vendor": {"name": "mariadb-corporation"}}], "isExploited": false}