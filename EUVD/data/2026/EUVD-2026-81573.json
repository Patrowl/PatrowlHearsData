{"id": "EUVD-2026-81573", "enisaUuid": "e27f62f5-e862-3b93-ac80-e73952c34e51", "description": "admin3 through 3.0.0 persists user session tokens in the audit log event body when publishing UserLoggedIn domain events. Attackers with log:view permission can read the JSON response from the GET /logs endpoint to harvest session tokens and replay them as bearer credentials for full user access.", "datePublished": "2026-09-17T12:33:23", "dateUpdated": "2026-09-24T14:22:55", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/LinYuanyi1/cve-request-poc/blob/master/admin3/C02_log_session_token_disclosure.py", "https://github.com/cjbi/admin3/blob/3.0.0/admin3-server/src/main/java/tech/wetech/admin3/sys/service/LogService.java", "https://github.com/cjbi/admin3/blob/3.0.0/admin3-server/src/main/java/tech/wetech/admin3/infra/service/DefaultSessionService.java", "https://github.com/cjbi/admin3/blob/3.0.0/admin3-server/src/main/resources/data.sql", "https://github.com/cjbi/admin3", "https://www.vulncheck.com/advisories/admin3-through-3.0.0-session-token-disclosure-via-audit-log"], "aliases": ["CVE-2026-92918", "GHSA-f5hf-9xjh-p8xq"], "assigner": "VulnCheck", "epss": 0.65, "enisaIdProduct": [{"id": "ae863024-74dd-3ab3-ba62-3eb56da75e45", "product": {"name": "admin3", "vendor": {"name": "cjbi"}}, "product_version": "0 \u22643.0.0"}], "enisaIdVendor": [{"id": "9bb1514f-cb6e-3836-83fa-6303c21e3f53", "vendor": {"name": "cjbi"}}], "isExploited": false}