{"id": "EUVD-2026-103990", "enisaUuid": "bde70f24-fb4f-3361-acf4-44284db0b4bf", "description": "The visibility check of Gitea user profiles was applied to GET requests only, while `POST /{username}` (follow and unfollow) required only a signed-in user. Any authenticated user could therefore obtain the full name, location, website and description of a user with a private profile from the response. The issue was fixed in 28.1.0 and disclosed with 28.2.0.", "datePublished": "2026-10-18T18:57:20", "dateUpdated": "2026-10-19T20:17:32", "baseScore": 6.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N", "references": ["https://github.com/go-gitea/gitea/security/advisories/GHSA-xmfc-hqq8-33wh", "https://github.com/go-gitea/gitea/pull/39501", "https://github.com/go-gitea/gitea/pull/39507", "https://blog.gitea.com/release-of-28.2.0/", "https://github.com/go-gitea/gitea/releases/tag/v28.2.0"], "aliases": ["CVE-2026-110324"], "assigner": "Gitea", "epss": 0.26, "enisaIdProduct": [{"id": "0351fa18-9924-3baa-ac56-6cdbee0ebce5", "product": {"name": "Gitea", "vendor": {"name": "Gitea"}}, "product_version": "1.22.0 \u226428.0.0"}], "enisaIdVendor": [{"id": "31699c01-8532-33a9-8e41-5c17028cf203", "vendor": {"name": "Gitea"}}], "isExploited": false}