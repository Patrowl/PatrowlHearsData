{"id": "EUVD-2026-87286", "enisaUuid": "9b07cb94-bd63-3624-ad49-0c30ff4f36cb", "description": "GLPI is a free asset and IT management software package. From 0.70 until 10.0.26 and 11.0.8, a technician can manipulate the authtype value through the API to change another user's authentication method. Under configurations using the legacy API REST interface or SSO logins, this can change a super-administrator's authentication method and enable account takeover. This issue is fixed in versions 11.0.8 and 10.0.26.", "datePublished": "2026-09-25T18:35:36", "dateUpdated": "2026-09-25T19:06:26", "baseScore": 7.5, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:H/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/glpi-project/glpi/security/advisories/GHSA-94rp-v9f2-5rj7", "https://github.com/glpi-project/glpi/commit/9329f1ecac8099b54c2ca4dd770d78f82e1e6db8", "https://github.com/glpi-project/glpi/commit/eb1b4299e81abeac764902b422cf7fcd59ac85d0", "https://github.com/glpi-project/glpi/releases/tag/10.0.26", "https://github.com/glpi-project/glpi/releases/tag/11.0.8"], "aliases": ["CVE-2026-53625"], "assigner": "GitHub_M", "epss": 0.57, "enisaIdProduct": [{"id": "662a815f-9f16-3ec5-955e-33de013eaa1b", "product": {"name": "glpi", "vendor": {"name": "glpi-project"}}, "product_version": "0.70, < 10.0.26"}, {"id": "e2b11815-3b76-3cfd-bdf6-49e86028ea97", "product": {"name": "glpi", "vendor": {"name": "glpi-project"}}, "product_version": "11.0.0, < 11.0.8"}], "enisaIdVendor": [{"id": "1b0e1763-7643-3087-aa43-ee41de0f0a3a", "vendor": {"name": "glpi-project"}}], "isExploited": false}