{"id": "EUVD-2026-70858", "enisaUuid": "91273404-f603-3c4c-8edd-534e7d5ad86b", "description": "Kernel software installed and running inside a Guest VM may post improper commands to the GPU Firmware to trigger a read and/or write data outside the Guest's virtualised GPU memory.\n\n\n\nThe firmware uses data provided by the Guest VM to set up accesses to memory. It validated this before use, but a TOCTOU bug was present which allowed the earlier check results to be invalidated.", "datePublished": "2026-09-04T01:53:55", "dateUpdated": "2026-09-08T14:29:16", "baseScore": 2.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:H/PR:L/UI:N/S:U/C:L/I:N/A:N", "references": ["https://www.imaginationtech.com/gpu-driver-vulnerabilities/"], "aliases": ["GHSA-49pq-rgj7-q6mh", "CVE-2026-45197"], "assigner": "imaginationtech", "epss": 0.09, "enisaIdProduct": [{"id": "1f1ec88d-9ac4-3eac-8466-48ad2c59fa2f", "product": {"name": "Graphics DDK", "vendor": {"name": "Imagination Technologies"}}, "product_version": "23.2 RTM2"}, {"id": "5e45d111-d9f9-334d-9ca1-9fa75bf2e170", "product": {"name": "Graphics DDK", "vendor": {"name": "Imagination Technologies"}}, "product_version": "25.1 RTM2 \u226425.3 RTM"}, {"id": "887a372a-263c-346d-91c3-7d0f398019a5", "product": {"name": "Graphics DDK", "vendor": {"name": "Imagination Technologies"}}, "product_version": "26.1 RTM1"}, {"id": "af4e3dde-9b7b-32bc-9ac1-67728edcbdc8", "product": {"name": "Graphics DDK", "vendor": {"name": "Imagination Technologies"}}, "product_version": "24.2 RTM2"}, {"id": "c093ac73-0197-32ba-afda-99b9d5f523ac", "product": {"name": "Graphics DDK", "vendor": {"name": "Imagination Technologies"}}, "product_version": "1.18 RTM2"}], "enisaIdVendor": [{"id": "e15a02a6-0b0e-392f-ab0c-57a3141fb317", "vendor": {"name": "Imagination Technologies"}}], "isExploited": false}