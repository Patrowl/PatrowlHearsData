{"id": "EUVD-2026-93514", "enisaUuid": "998144df-739d-3a70-889f-844e9adccc41", "description": "Payload is a free and open source headless content management system. In versions before 3.90.0 and canary versions before 4.0.0-canary.34, local upload configurations that accept XML files can store an XML file and stylesheet that execute JavaScript in the Payload origin when a logged-in user opens the file. This issue is fixed in versions 3.90.0 and 4.0.0-canary.34.", "datePublished": "2026-10-06T16:51:34", "dateUpdated": "2026-10-09T01:17:45", "baseScore": 8.6, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:P/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/payloadcms/payload/security/advisories/GHSA-9qpg-3cf8-w33x", "https://github.com/payloadcms/payload/commit/a8c3a8e8e2680c96ec4f66f5b3854c5df6c35adf", "https://github.com/payloadcms/payload/releases/tag/v3.90.0"], "aliases": ["GHSA-9qpg-3cf8-w33x", "CVE-2026-105868"], "assigner": "GitHub_M", "epss": 0.17, "enisaIdProduct": [{"id": "1cddf656-7626-3af9-8ebf-ace484f54029", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "< 3.90.0"}, {"id": "1e174809-ecb3-30d8-9b09-1b80e31c5e64", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "4.0.0-canary.0, < 4.0.0-canary.34"}], "enisaIdVendor": [{"id": "35be642b-8ec6-3ad2-b315-30d5827a6c5f", "vendor": {"name": "payloadcms"}}], "isExploited": false}