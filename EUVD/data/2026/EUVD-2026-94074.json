{"id": "EUVD-2026-94074", "enisaUuid": "1cc10bd0-c1d0-33a7-bb43-72bbdba15d3e", "description": "Backstage is an open framework for building developer portals. Prior to 1.14.6, the @backstage/plugin-techdocs-node package is affected by improper validation of mkdocs theme configuration in techdocs. When TechDocs is configured to build documentation locally or in a container, a user with write access to a registered repository can include configuration values in mkdocs.yml that cause arbitrary code execution during the documentation build process. This issue is fixed in versions 1.14.6 and 1.15.4.", "datePublished": "2026-10-06T21:50:07", "dateUpdated": "2026-10-07T18:01:48", "baseScore": 7.7, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:C/C:H/I:L/A:L", "references": ["https://github.com/backstage/backstage/security/advisories/GHSA-8w7q-29mw-gf5c", "https://github.com/backstage/backstage/commit/02cd7cdbb18b687446277b5602adaee7f1d53cbb", "https://github.com/backstage/backstage/commit/a900a9953c8f7ad3ba1906d1d257725a9996cc9d", "https://github.com/backstage/backstage/releases/tag/v1.50.5", "https://github.com/backstage/backstage/releases/tag/v1.54.6"], "aliases": ["GHSA-8w7q-29mw-gf5c", "CVE-2026-106509"], "assigner": "GitHub_M", "epss": 0.37, "enisaIdProduct": [{"id": "28bac6e0-b217-34ac-8c4f-c3d7196f288a", "product": {"name": "backstage", "vendor": {"name": "backstage"}}, "product_version": "< 1.50.5"}, {"id": "74ef2121-465e-3370-a762-16714097aede", "product": {"name": "backstage", "vendor": {"name": "backstage"}}, "product_version": "1.51.0-next.0, < 1.54.6"}, {"id": "7bd6645f-c1a2-333b-82f8-a5dd4e969d27", "product": {"name": "plugin-techdocs-node", "vendor": {"name": "@backstage"}}, "product_version": "< 1.14.6"}, {"id": "a0ff5749-4632-3111-9a9a-5aad02808f9f", "product": {"name": "plugin-techdocs-node", "vendor": {"name": "@backstage"}}, "product_version": "1.15.0, < 1.15.4"}], "enisaIdVendor": [{"id": "001763db-d8d8-39bb-8eff-76d14ea70