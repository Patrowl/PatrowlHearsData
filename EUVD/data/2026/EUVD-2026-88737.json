{"id": "EUVD-2026-88737", "enisaUuid": "78a31e26-e729-37a6-bbd5-8774737c5742", "description": "Apache XmlSchema doesn't limit how deeply schema imports and includes can be nested, so a malicious schema can make parsing recurse until the stack overflows. This causes a denial of service.\nUsers are recommended to upgrade to version 2.3.3, which fixes this issue.", "datePublished": "2026-09-29T11:33:51", "dateUpdated": "2026-09-29T20:06:21", "baseScore": 7.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://lists.apache.org/thread/l339q3oldm0cd2lph4b6f93fd07x9g6s"], "aliases": ["CVE-2026-102495", "GHSA-p4rx-69jj-g5w2"], "assigner": "apache", "epss": 0.53, "enisaIdProduct": [{"id": "2b53f8d8-d112-35dd-8ac7-7774f4d5a98c", "product": {"name": "Apache XMLSchema", "vendor": {"name": "Apache Software Foundation"}}, "product_version": "0 <2.3.3"}], "enisaIdVendor": [{"id": "9f3d8aa4-2f5b-3617-8fbb-318730eec661", "vendor": {"name": "Apache Software Foundation"}}], "isExploited": false}