{"id": "EUVD-2026-68525", "enisaUuid": "79e308fd-8417-3773-b2ef-6035943af2db", "description": "A flaw was found in SmallRye GraphQL. The number scalar coercion for BigInteger does not properly validate the magnitude of float or string inputs. An unauthenticated remote attacker can exploit this by sending a GraphQL query containing a large exponent float literal. This can lead to the allocation of extremely large BigInteger objects, causing CPU exhaustion or an OutOfMemoryError, resulting in a denial of service.", "datePublished": "2026-08-31T13:54:18", "dateUpdated": "2026-10-20T04:32:14", "baseScore": 7.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:62515", "https://access.redhat.com/errata/RHSA-2026:62555", "https://access.redhat.com/security/cve/CVE-2026-76763", "https://bugzilla.redhat.com/show_bug.cgi?id=2519767"], "aliases": ["CVE-2026-76763"], "assigner": "redhat", "epss": 0.79, "enisaIdProduct": [{"id": "a9ce998e-033e-372f-a4f8-fa6c90428e1d", "product": {"name": "Red Hat build of Quarkus 3.33.3.SP1", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 2.17.0.redhat-00003"}, {"id": "c718a992-9b38-3061-bae5-2ef0c4b7e020", "product": {"name": "Red Hat build of Quarkus 3.27.5.SP1", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 2.14.2.redhat-00002"}], "enisaIdVendor": [{"id": "37d1e256-99ee-3a5d-92d0-24ec01a2a898", "vendor": {"name": "Red Hat"}}], "isExploited": false}