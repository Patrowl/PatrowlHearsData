{"id": "EUVD-2026-101721", "enisaUuid": "a24a78ad-c893-31c6-9937-699d17b8cb1f", "description": "FreeRDP shadow server from 3.0.0 before 3.32.0 dispatches input PDUs during the Confirm Active state before authentication, allowing unauthenticated attackers to inject keyboard input. Attackers can negotiate TLS-only RDP and send an input PDU without Confirm Active to inject synthetic keystrokes into the host user's X11 session via XTEST.", "datePublished": "2026-10-14T22:52:13", "dateUpdated": "2026-10-16T17:15:12", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/FreeRDP/FreeRDP/security/advisories/GHSA-m998-cvfm-9444", "https://www.vulncheck.com/advisories/freerdp-shadow-before-3.32.0-pre-authentication-input-injection-via-confirm-active-bypass"], "aliases": ["CVE-2026-110838", "GHSA-5xxg-89r9-vf9v"], "assigner": "VulnCheck", "epss": 0.26, "enisaIdProduct": [{"id": "9ed51f85-115b-3b14-9ba6-e9913a23e309", "product": {"name": "FreeRDP", "vendor": {"name": "FreeRDP"}}, "product_version": "3.0.0 <3.32.0"}], "enisaIdVendor": [{"id": "ebeb77b6-ccc0-3c79-9cce-8b59f05e4c57", "vendor": {"name": "FreeRDP"}}], "isExploited": false}