{"id": "EUVD-2026-63240", "enisaUuid": "2e948a11-e8f6-3ab6-9c43-53d50cf5b0fb", "description": "A flaw was found in FreeIPA. A remote, unauthenticated attacker can exploit this vulnerability by sending oversized form POST requests to the `/ipa/migration/migration.py` endpoint. This can force the migration handler to read attacker-controlled request bodies fully into memory, leading to increased memory usage, slower request handling, and potential service disruption or denial of service.", "datePublished": "2026-08-20T10:31:31", "dateUpdated": "2026-10-15T05:08:01", "baseScore": 7.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:70564", "https://access.redhat.com/errata/RHSA-2026:72279", "https://access.redhat.com/errata/RHSA-2026:82935", "https://access.redhat.com/errata/RHSA-2026:83083", "https://access.redhat.com/errata/RHSA-2026:83084", "https://access.redhat.com/errata/RHSA-2026:83085", "https://access.redhat.com/errata/RHSA-2026:83460", "https://access.redhat.com/errata/RHSA-2026:83461", "https://access.redhat.com/security/cve/CVE-2026-73197", "https://bugzilla.redhat.com/show_bug.cgi?id=2474697"], "aliases": ["GHSA-m6vw-rcwj-pg9q", "CVE-2026-73197"], "assigner": "redhat", "epss": 0.54, "enisaIdProduct": [{"id": "344c20c0-6117-3667-b911-65b2a89c3999", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:4.13.4-1.el9_8"}, {"id": "43a0804e-01fb-3cb9-a849-27877d91a256", "product": {"name": "Red Hat Enterprise Linux 8.8 Telecommunications Update Service", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 8080020261007080925.e581a9e4"}, {"id": "4816fe3f-a39b-33f8-bf53-fccfc1cf18f2", "product": {"name": "Red Hat Enterprise Linux 9.4 Update Services for SAP Solutions", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:4.11.0-15.el9_4.9"}, {"id": "53a7fbbb-52dc-3ac4-8985-8195d10d940f", "p