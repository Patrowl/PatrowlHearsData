{"id": "EUVD-2026-75445", "enisaUuid": "fcf51c64-efeb-3a6d-b11d-1cbbd1944713", "description": "CyberPanel before 3.0.5 fails to enforce two-factor authentication on API endpoints, allowing attackers to bypass TOTP requirements using password-derived tokens. Attackers who obtain an administrator's password can derive API tokens and perform administrative operations or create authenticated sessions without the second factor.", "datePublished": "2026-09-10T13:05:42", "dateUpdated": "2026-09-11T19:22:51", "baseScore": 8.6, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:H/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/usmannasir/cyberpanel/security/advisories/GHSA-h2f7-38ww-5pwc", "https://www.vulncheck.com/advisories/cyberpanel-before-3.0.5-authentication-bypass-via-api"], "aliases": ["GHSA-mmcx-mj26-p5c9", "CVE-2026-88895"], "assigner": "VulnCheck", "epss": 0.65, "enisaIdProduct": [{"id": "18109cbe-e52c-3e33-a582-6841e356de9e", "product": {"name": "CyberPanel", "vendor": {"name": "Cyberpanel"}}, "product_version": "0 <3.0.5"}], "enisaIdVendor": [{"id": "7bce9c6e-1441-32ed-aab7-d418deb717fa", "vendor": {"name": "usmannasir"}}], "isExploited": false}