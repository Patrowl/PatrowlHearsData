{"id": "EUVD-2026-87700", "enisaUuid": "a9c0b3a1-789b-3136-b1b0-ad4d882a70e6", "description": "Flowise through 3.1.4 contains missing route-level RBAC checks on chat message endpoints that allow low-privileged API keys to read and delete chat history. Attackers with valid but low-privileged API keys can access GET and DELETE chat message routes without required flow permissions to read chat histories, prompts, model responses, and delete messages.", "datePublished": "2026-09-26T13:22:49", "dateUpdated": "2026-09-30T12:48:59", "baseScore": 7.5, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:P/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/FlowiseAI/Flowise/security/advisories/GHSA-ppmg-4cx6-95hh", "https://www.vulncheck.com/advisories/flowise-through-3.1.4-missing-authorization-via-chat-message-routes"], "aliases": ["GHSA-fx3r-9cwr-p5w6", "CVE-2026-100605"], "assigner": "VulnCheck", "epss": 0.22, "enisaIdProduct": [{"id": "5ffb12b2-ec5c-3fd4-b097-8e3feb80623a", "product": {"name": "Flowise", "vendor": {"name": "FlowiseAI"}}, "product_version": "0 \u22643.1.4"}], "enisaIdVendor": [{"id": "20fd22f6-62df-3908-bd84-8327d3487d1e", "vendor": {"name": "FlowiseAI"}}], "isExploited": false}