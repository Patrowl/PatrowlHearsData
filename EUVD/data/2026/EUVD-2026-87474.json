{"id": "EUVD-2026-87474", "enisaUuid": "8719bd42-7c46-3f38-b03a-44af0a0dbec1", "description": "OpenClaw versions before 2026.8.1 fail to validate video asset URLs returned by providers, allowing server-side requests to private destinations. A malicious or compromised provider can return private or loopback URLs to cause the CLI to make requests to internal services accessible from the OpenClaw host.", "datePublished": "2026-09-26T02:19:04", "dateUpdated": "2026-09-30T00:27:11", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:P/VC:L/VI:L/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/openclaw/openclaw/security/advisories/GHSA-fvxr-9g24-x3hf", "https://www.vulncheck.com/advisories/openclaw-before-2026.8.1-server-side-request-forgery-via-video-asset"], "aliases": ["GHSA-3qmc-rwv9-q36h", "CVE-2026-100577"], "assigner": "VulnCheck", "epss": 0.14, "enisaIdProduct": [{"id": "994ff03b-67de-39fe-9d48-6b45922f610c", "product": {"name": "OpenClaw", "vendor": {"name": "n/a"}}, "product_version": "0 <2026.8.1"}], "enisaIdVendor": [{"id": "79eafd95-4950-304c-85a5-7739ffcb7dc9", "vendor": {"name": "OpenClaw"}}], "isExploited": false}