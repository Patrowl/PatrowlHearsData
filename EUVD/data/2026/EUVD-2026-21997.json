{"id": "EUVD-2026-21997", "enisaUuid": "a80459ca-8dab-350b-b526-760e33492a5b", "description": "An issue was discovered in HAProxy before 3.3.6. The HTTP/3 parser does not check that the received body length matches a previously announced content-length when the stream is closed via a frame with an empty payload. This can cause desynchronization issues with the backend server and could be used for request smuggling. The earliest affected version is 2.6.", "datePublished": "2026-04-13T00:00:00", "dateUpdated": "2026-10-18T20:07:07", "baseScore": 4.0, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:C/C:N/I:L/A:N", "references": ["https://www.haproxy.org", "https://www.haproxy.com/documentation/haproxy-aloha/changelog/", "https://github.com/haproxy/haproxy/commit/05a295441c621089ffa4318daf0dbca2dd756a84", "https://www.mail-archive.com/haproxy@formilux.org/msg46752.html", "https://r3verii.github.io/cve/2026/04/14/haproxy-h3-standalone-fin-smuggling.html"], "aliases": ["CVE-2026-33555", "GHSA-5mp8-rq5m-pj7m"], "assigner": "mitre", "epss": 0.6, "enisaIdProduct": [{"id": "b8dc0a41-caa0-3d4a-b1dd-2b2e8201cbcc", "product": {"name": "haproxy", "vendor": {"name": "HAProxy"}}, "product_version": "2.6 <3.3.6"}], "enisaIdVendor": [{"id": "011b18cb-0e3e-3976-ab66-eb4030a00b00", "vendor": {"name": "HAProxy"}}], "isExploited": false}