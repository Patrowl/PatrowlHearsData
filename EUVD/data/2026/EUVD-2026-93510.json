{"id": "EUVD-2026-93510", "enisaUuid": "a1054dc8-b7cd-3f4b-8898-0ace6b6775a8", "description": "Payload is a free and open source headless content management system. In @payloadcms/plugin-multi-tenant versions before 3.90.0 and canary versions before 4.0.0-canary.34, an authenticated user limited to one tenant can create a record in another tenant when at least one tenant-enabled collection exists. Reads and direct edits of existing documents in the target tenant are not bypassed. This issue is fixed in versions 3.90.0 and 4.0.0-canary.34.", "datePublished": "2026-10-06T16:42:27", "dateUpdated": "2026-10-06T17:25:18", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/payloadcms/payload/security/advisories/GHSA-xhm9-gwgw-3q2q", "https://github.com/payloadcms/payload/commit/b8fc06a18afb6974dc07f95ac1e541c716e5926b", "https://github.com/payloadcms/payload/releases/tag/v3.90.0"], "aliases": ["CVE-2026-105864", "GHSA-xhm9-gwgw-3q2q"], "assigner": "GitHub_M", "epss": 0.2, "enisaIdProduct": [{"id": "4d4c69f0-29c5-3092-b1ca-90d5b249cc7f", "product": {"name": "plugin-multi-tenant", "vendor": {"name": "@payloadcms"}}, "product_version": "< 3.90.0"}, {"id": "4e0d2617-b3ff-3f7b-93b2-d43e61ad9940", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "4.0.0-canary.0, < 4.0.0-canary.34"}, {"id": "be3353bc-2472-3ffe-8ee0-ed51f3e8729c", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "< 3.90.0"}, {"id": "dbede2f8-8b74-33fe-9b8b-9c539d876d10", "product": {"name": "plugin-multi-tenant", "vendor": {"name": "@payloadcms"}}, "product_version": "4.0.0-canary.0, < 4.0.0-canary.34"}], "enisaIdVendor": [{"id": "755b2b44-9b3a-32e7-8069-8db057979389", "vendor": {"name": "payloadcms"}}, {"id": "9ae5e6a9-e72a-38e1-b0d2-bda9fa7bbcff", "vendor": {"name": "@payloadcms"}}], "isExploited": false}