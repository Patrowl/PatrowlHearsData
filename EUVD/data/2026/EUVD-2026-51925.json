{"id": "EUVD-2026-51925", "enisaUuid": "cf471241-6b71-37f2-bacd-0045df33ce95", "description": "A flaw was found in the user creation component of Keycloak when Fine-Grained Admin Permissions V2 (FGAP V2) is enabled. This issue allows a sub-administrator with permission to create users to add those users to any group, even groups the sub-administrator is not authorized to manage. This could lead to unauthorized access to sensitive information or elevated privileges for the newly created users.", "datePublished": "2026-08-02T05:18:50", "dateUpdated": "2026-09-16T18:34:41", "baseScore": 6.6, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:H/UI:N/S:U/C:H/I:H/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:68277", "https://access.redhat.com/errata/RHSA-2026:68278", "https://access.redhat.com/security/cve/CVE-2026-18571", "https://bugzilla.redhat.com/show_bug.cgi?id=2509759"], "aliases": ["GHSA-5vmc-qhfj-qxc3", "CVE-2026-18571"], "assigner": "redhat", "epss": 0.55, "enisaIdProduct": [{"id": "8bc4dc5c-c322-3d89-bf97-c32f37d3de06", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6.7-3"}, {"id": "cb33025c-a81d-313f-947b-bc1410617668", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6-20"}], "enisaIdVendor": [{"id": "d87032b1-e7b7-3c62-aae5-3e6765de1a57", "vendor": {"name": "Red Hat"}}], "isExploited": false}