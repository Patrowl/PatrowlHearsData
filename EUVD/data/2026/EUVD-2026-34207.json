{"id": "EUVD-2026-34207", "enisaUuid": "1490d3fa-fcdc-3814-8f7d-32c3286d3a25", "description": "A flaw was found in NetworkManager. This local privilege escalation vulnerability exists in NetworkManager's dhclient backend when processing malformed Manufacturer Usage Description (MUD) URLs. A local user can exploit this flaw to escalate privileges by triggering a script via a crafted MUD URL, provided an administrator has explicitly configured NetworkManager to use dhclient. This issue does not affect default configurations of NetworkManager.", "datePublished": "2026-06-04T05:21:34", "dateUpdated": "2026-09-25T01:26:26", "baseScore": 6.7, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:H/PR:L/UI:R/S:U/C:H/I:H/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:58555", "https://access.redhat.com/errata/RHSA-2026:58572", "https://access.redhat.com/errata/RHSA-2026:61239", "https://access.redhat.com/errata/RHSA-2026:61243", "https://access.redhat.com/errata/RHSA-2026:61244", "https://access.redhat.com/errata/RHSA-2026:61341", "https://access.redhat.com/errata/RHSA-2026:61572", "https://access.redhat.com/errata/RHSA-2026:61580", "https://access.redhat.com/security/cve/CVE-2026-10805", "https://bugzilla.redhat.com/show_bug.cgi?id=2484613"], "aliases": ["CVE-2026-10805", "GHSA-rwc7-7qq8-w477"], "assigner": "redhat", "epss": 0.17, "enisaIdProduct": [{"id": "26cdb42b-e59a-3d11-82cd-e6b2d4b92cb2", "product": {"name": "Red Hat Enterprise Linux 8.4 Extended Update Support Long-Life Add-On", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1:1.30.0-19.el8_4.1"}, {"id": "2ba4ed54-9d5f-3459-b6da-9143269427e6", "product": {"name": "Red Hat Enterprise Linux 8.6 Extended Update Support Long-Life Add-On", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1:1.36.0-18.el8_6.1"}, {"id": "42acccc2-303f-3470-a01a-03bc10b199f8", "product": {"name": "Red Hat Enterprise Linux 9.6 Extended Update Support", "vendor": {"name": "Red Hat"}}, "product_