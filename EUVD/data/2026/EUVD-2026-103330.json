{"id": "EUVD-2026-103330", "enisaUuid": "2b95e1c1-0531-366e-a9e4-0c14827e99f6", "description": "phpMyFAQ from 4.1.0 before 4.1.9 and 4.2.0-alpha before 4.2.0-beta contains a missing authorization vulnerability in the admin dashboard that allows authenticated users without admin rights to view restricted data. Attackers with any activated account can request /admin/index.php/ to read unpublished FAQ questions, admin edit URLs, recent user identities, and site statistics.", "datePublished": "2026-10-17T18:46:13", "dateUpdated": "2026-10-18T13:26:41", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/thorsten/phpMyFAQ/security/advisories/GHSA-4378-pcwq-fc29", "https://www.vulncheck.com/advisories/phpmyfaq-4.1.0-before-4.1.9-and-4.2.0-alpha-before-4.2.0-beta-missing-authorization-via-admin-dashboard"], "aliases": ["GHSA-c672-4mmj-vq8q", "CVE-2026-111889"], "assigner": "VulnCheck", "epss": 0.2, "enisaIdProduct": [{"id": "39113c76-8e34-3149-b52d-cabccab64aa1", "product": {"name": "phpMyFAQ", "vendor": {"name": "thorsten"}}, "product_version": "4.1.0 <4.1.9"}, {"id": "a1d24eca-4036-3d7d-bf62-2e8d77d09db9", "product": {"name": "phpMyFAQ", "vendor": {"name": "thorsten"}}, "product_version": "4.2.0-alpha <4.2.0-beta"}], "enisaIdVendor": [{"id": "be2a6a96-58e7-3834-bf45-65d2d51ca1d0", "vendor": {"name": "thorsten"}}], "isExploited": false}