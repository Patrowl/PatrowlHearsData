{"id": "EUVD-2026-98228", "enisaUuid": "6eae393e-6677-31cb-baea-69ba73811302", "description": "GitLab has remediated an issue in GitLab CE/EE affecting all versions from 13.11 before 19.2.8, 19.3 before 19.3.5, and 19.4 before 19.4.2 that, under certain conditions, could have allowed an authenticated user controlling a Kubernetes agent to cause sensitive authentication tokens to be sent to an unintended server due to improper redirect validation in the Kubernetes proxy.", "datePublished": "2026-10-13T01:09:21", "dateUpdated": "2026-10-14T19:06:40", "baseScore": 5.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:R/S:C/C:H/I:N/A:N", "references": ["https://gitlab.com/gitlab-org/gitlab/-/work_items/598965", "https://hackerone.com/reports/3597095", "https://docs.gitlab.com/releases/patches/patch-release-gitlab-19-4-2-released/"], "aliases": ["CVE-2026-7767", "GHSA-vrcj-7whq-6c76"], "assigner": "GitLab", "epss": 0.29, "enisaIdProduct": [{"id": "624fa30e-56f4-3c8f-bfad-a8af229cb23a", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.3 <19.3.5"}, {"id": "7ddf5baf-d691-3085-bd4e-3e150a7f586a", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "13.11 <19.2.8"}, {"id": "d3cf7f6d-7b6f-3ed3-9cd7-f0c00f9f67ee", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.4 <19.4.2"}], "enisaIdVendor": [{"id": "dfa41663-523d-3bc7-8363-78d7604854ec", "vendor": {"name": "GitLab"}}], "isExploited": false}