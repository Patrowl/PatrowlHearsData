{"id": "EUVD-2026-104319", "enisaUuid": "7bc2ed46-33a4-3361-ae0b-9acf04bdf03b", "description": "KitchenOwl through 0.7.10 contains a server-side request forgery vulnerability in recipe import that allows authenticated household members to bypass IP filtering via a second unfiltered fetch. Attackers can host a page titled KitchenOwl at a URL matching /recipe/<id>. The follow-up requests.get() call can then be redirected or DNS-rebound to loopback, private-network, or cloud-metadata addresses, exposing internal services.", "datePublished": "2026-10-19T13:55:07", "dateUpdated": "2026-10-19T18:12:44", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/TomBursch/kitchenowl/issues/1169", "https://github.com/TomBursch/kitchenowl/commit/292f6f50a8e8bfa487292e9fd0ea0c54a860c28f", "https://github.com/TomBursch/kitchenowl/blob/v0.7.10/backend/app/service/recipe_scraping.py", "https://www.vulncheck.com/advisories/kitchenowl-through-0.7.10-ssrf-via-recipe-import-scrapekitchenowl-fetch"], "aliases": ["CVE-2026-111899", "GHSA-h74m-472f-x5gj"], "assigner": "VulnCheck", "epss": 0.27, "enisaIdProduct": [{"id": "36dc245c-9bc2-3793-926b-f84026c0b6cd", "product": {"name": "kitchenowl", "vendor": {"name": "TomBursch"}}, "product_version": "0 \u22640.7.10"}], "enisaIdVendor": [{"id": "05819988-6945-3da2-9a34-7fabc6afd0e7", "vendor": {"name": "TomBursch"}}], "isExploited": false}