{"id": "EUVD-2026-107368", "enisaUuid": "0299836d-1c2a-3a78-843a-9480d8131551", "description": "Electron is a framework for writing cross-platform desktop applications using JavaScript, HTML and CSS. Prior to versions 42.11.3, 43.7.0, 44.3.0, and 45.0.0-alpha.6, Electron treated pages opened into a new window from links as application-initiated navigations instead of preserving the page containing the link as the initiator. The resulting top-level request could be classified as same-site, causing SameSite=Strict cookies to be sent and Sec-Fetch-Site not to identify the initiating page. An application that loads untrusted content and permits it to open new windows could therefore allow that content to make a credentialed request to another site that relies on SameSite cookies for CSRF protection. This issue is fixed in versions 42.11.3, 43.7.0, 44.3.0, and 45.0.0-alpha.6.", "datePublished": "2026-10-21T16:04:42", "dateUpdated": "2026-10-21T16:04:42", "baseScore": 4.2, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:L/I:L/A:N", "references": ["https://github.com/electron/electron/security/advisories/GHSA-2p8c-gr87-2676", "https://github.com/electron/electron/pull/53683", "https://github.com/electron/electron/pull/53717", "https://github.com/electron/electron/pull/53718", "https://github.com/electron/electron/pull/53719", "https://github.com/electron/electron/pull/53721", "https://github.com/electron/electron/commit/079b9b1594ee62c336adc3aa430d4c1cf62bd51e", "https://github.com/electron/electron/commit/0e6aca0618eeae50a18cfd50548b8688820629ed", "https://github.com/electron/electron/commit/652ef79ac79c6767b31e59b2f28d0d46114645e5", "https://github.com/electron/electron/commit/98940cb274bb6adcb7cdb2da2d4495ac83119670", "https://github.com/electron/electron/commit/a86ae4205ba2ba7ae60a6caa9d5d3a44321f2f9b", "https://github.com/electron/electron/releases/tag/v42.11.3", "https://github.com/electron/electron/releases/tag/v43.7.0", "https://github.com/electron/electron/releases/tag/v44.3.0", "https://github.com/electron/electron/releases/tag/v45.0.0-alpha.6"], "aliases": ["GHSA-2p8c-gr87-2676", "CVE-2026-113796"], "assigner": "GitHub_M", "epss": 0.18, "enisaIdProduct": [{"id": "2a2e046f-94d3-3903-a951-fe1422e65e8f", "product": {"name": "electron", "vendor": {"name": "electron"}}, "product_version": "44.0.0-alpha.1, < 44.3.0"}, {"id": "55a6cff0-e0c3-3dd5-ba45-d89adda0bda4", "product": {"name": "electron", "vendor": {"name": "electron"}}, "product_version": "< 42.11.3"}, {"id": "b2eca81e-3b2d-3644-a8c7-bf737f044fca", "product": {"name": "electron", "vendor": {"name": "electron"}}, "product_version": "43.0.0-alpha.1, < 43.7.0"}, {"id": "f8dedf9f-f669-3127-8ca5-31370c9f1b1e", "product": {"name": "electron", "vendor": {"name": "electron"}}, "product_version": "45.0.0-alpha.1, < 45.0.0-alpha.6"}], "enisaIdVendor": [{"id": "5e7b4278-e3bf-3b5e-99c1-68f6b234e32d", "vendor": {"name": "electron"}}], "isExploited": false}