{"id": "EUVD-2026-101103", "enisaUuid": "e4a47cf8-71ef-3d62-82fd-4d4532ab6dca", "description": "Gitea's Maven upload handler reads checksum uploads entirely into memory and returns before enforcing package-size quotas. An authenticated user with package-publish permission can submit an oversized body to a checksum endpoint despite legitimate checksum values being at most 128 bytes. This bypasses the upload quota on that path and can exhaust server memory.", "datePublished": "2026-10-14T14:37:30", "dateUpdated": "2026-10-14T15:03:16", "baseScore": 4.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:L", "references": ["https://github.com/go-gitea/gitea/security/advisories/GHSA-5xcq-p92v-43rf", "https://blog.gitea.com/release-of-1.27.3/", "https://github.com/go-gitea/gitea/pull/39028", "https://github.com/go-gitea/gitea/pull/39031", "https://github.com/go-gitea/gitea/releases/tag/v1.27.3"], "aliases": ["CVE-2026-73273"], "assigner": "Gitea", "epss": 0.39, "enisaIdProduct": [{"id": "631c1359-a69c-3238-a868-a3ed143271a5", "product": {"name": "Gitea", "vendor": {"name": "Gitea"}}, "product_version": "0 \u22641.27.2"}], "enisaIdVendor": [{"id": "87c8b8a6-0f95-32e4-b073-0c2adc621c2a", "vendor": {"name": "Gitea"}}], "isExploited": false}