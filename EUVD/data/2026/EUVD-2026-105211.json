{"id": "EUVD-2026-105211", "enisaUuid": "bae7d7d7-cbbf-36ea-af61-a34c66b00f5d", "description": "ApostropheCMS is an open-source Node.js content management system. Prior to 3.7.0 of the import-export module, an authenticated importer can submit a tar entry whose normalized destination targets a directory while bypassing the literal parent-path substring guard. Opening that directory as a write stream emits an unhandled filesystem error that can terminate the Node.js process; the source establishes this static primitive but not an end-to-end exploit or controlled arbitrary file read or write. This issue is fixed in version 3.7.0.", "datePublished": "2026-10-20T17:15:01", "dateUpdated": "2026-10-23T01:56:12", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:L/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/apostrophecms/apostrophe/security/advisories/GHSA-97wv-p4xx-c7mg", "https://github.com/apostrophecms/apostrophe/commit/9500b8b0e1d630d5e07fbb5fd2c25ed0943845ce", "https://github.com/apostrophecms/apostrophe/commit/f84fd41cbf6c22eb8d0008fc9c25df1f7130b350", "https://github.com/apostrophecms/apostrophe/releases/tag/@apostrophecms/import-export@3.7.0"], "aliases": ["CVE-2026-113664", "GHSA-97wv-p4xx-c7mg"], "assigner": "GitHub_M", "epss": 0.41, "enisaIdProduct": [{"id": "87aa24fc-1d35-33ec-9d30-b69e539f5c23", "product": {"name": "import-export", "vendor": {"name": "apostrophecms"}}, "product_version": "< 3.7.0"}, {"id": "a931a596-b2a6-3020-9535-cc26f1b2b42e", "product": {"name": "Apostrophe ", "vendor": {"name": "apostrophecms"}}, "product_version": "< 4.33.0"}], "enisaIdVendor": [{"id": "4bdb4316-3b66-3538-8cf3-c54a3a129717", "vendor": {"name": "apostrophecms"}}, {"id": "b963f283-0b26-32a5-b9b3-1c222657919e", "vendor": {"name": "@apostrophecms"}}], "isExploited": false}