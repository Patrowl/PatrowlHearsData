{"id": "EUVD-2026-87834", "enisaUuid": "1f843802-aaa5-3648-b322-7c11d52f14a3", "description": "AzuraCast before 0.23.6 lacks RequireInternalConnection middleware on the Liquidsoap API endpoint and incorrectly derives the AutoDJ flag from header presence rather than validated value. Users with View station permission can inject arbitrary now-playing metadata, disrupt live broadcasts, and disclose filesystem paths.", "datePublished": "2026-09-27T01:28:46", "dateUpdated": "2026-10-08T15:22:03", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:L/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/AzuraCast/AzuraCast/security/advisories/GHSA-4fm3-ggg2-c6qx", "https://www.vulncheck.com/advisories/azuracast-before-0.23.6-metadata-injection-via-liquidsoap-api"], "aliases": ["GHSA-m6mg-63cr-44jj", "CVE-2026-100854"], "assigner": "VulnCheck", "epss": 0.16, "enisaIdProduct": [{"id": "43fabb38-86d5-3d3b-bbbe-3c82afaaf19e", "product": {"name": "AzuraCast", "vendor": {"name": "azuracast"}}, "product_version": "0 <0.23.6"}], "enisaIdVendor": [{"id": "552396f7-699d-3aec-89ea-aefcd413e139", "vendor": {"name": "azuracast"}}], "isExploited": false}