{"id": "EUVD-2026-106895", "enisaUuid": "f3b50a1b-b619-3363-9191-33b7ad6728be", "description": "Trigger.dev before 4.5.0 performs no authentication or organization check in the action handler of the dashboard run replay route (resources.taskruns.$runParam.replay) and looks up the run by friendlyId alone. A remote attacker who knows a victim's run friendlyId can replay it into an environment of their choosing, exposing the victim's task payload or running the task again with the victim's secrets.", "datePublished": "2026-10-21T00:36:56", "dateUpdated": "2026-10-22T15:54:22", "baseScore": 8.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:H/VI:L/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/triggerdotdev/trigger.dev/security/advisories/GHSA-pp95-gc86-jq6q", "https://github.com/triggerdotdev/trigger.dev/security/advisories/GHSA-9fq3-68cw-r7p2", "https://www.vulncheck.com/advisories/trigger-dev-before-4.5.0-missing-authentication-in-dashboard-run-replay-action"], "aliases": ["CVE-2026-114092", "GHSA-4ggh-4c33-wrjj"], "assigner": "VulnCheck", "epss": 0.44, "enisaIdProduct": [{"id": "3d5a8ab6-6702-3455-a05f-06d3bac3411a", "product": {"name": "trigger.dev", "vendor": {"name": "triggerdotdev"}}, "product_version": "0 <4.5.0"}], "enisaIdVendor": [{"id": "c70f5015-a5db-3299-9096-eda6f2c4a1d5", "vendor": {"name": "triggerdotdev"}}], "isExploited": false}