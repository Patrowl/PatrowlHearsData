{"id": "EUVD-2026-97678", "enisaUuid": "4f2ced5b-2fa6-363b-9dd7-b74d563eae5e", "description": "Quarkus REST Data Panache provides a way to automatically generate REST endpoints for data entities. A flaw was found where certain endpoints do not properly check the sort parameter provided by users. This could allow an attacker to learn information they should not have access to or slow down the system by forcing the database to perform complex tasks, potentially causing a denial of service.", "datePublished": "2026-10-12T16:26:59", "dateUpdated": "2026-10-15T23:41:42", "baseScore": 6.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:L", "references": ["https://access.redhat.com/errata/RHSA-2026:83082", "https://access.redhat.com/errata/RHSA-2026:83520", "https://access.redhat.com/security/cve/CVE-2026-94451", "https://bugzilla.redhat.com/show_bug.cgi?id=2537516"], "aliases": ["GHSA-3wcv-hrpc-mxp8", "CVE-2026-94451"], "assigner": "redhat", "epss": 0.27, "enisaIdProduct": [{"id": "44ef4833-9d5a-3b1a-a73a-802667cff519", "product": {"name": "Red Hat build of Quarkus 3.33.4.redhat", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 3.33.4.redhat-00004"}, {"id": "ead26a12-2b60-35fd-9f3f-c411176e1c2a", "product": {"name": "Red Hat build of Quarkus 3.27.6.redhat", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 3.27.6.redhat-00004"}], "enisaIdVendor": [{"id": "2b3543dd-24f1-3eb1-8060-1bfc22fd38e4", "vendor": {"name": "Red Hat"}}], "isExploited": false}