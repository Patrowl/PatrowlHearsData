{"id": "EUVD-2026-86451", "enisaUuid": "f2067212-264d-39a1-a56f-c4e8001edfd7", "description": "The Botslab G980H dash camera firmware accepts a reusable authentication value without adequately verifying its freshness or association with the requesting client. An unauthenticated attacker with adjacent network access who captures a valid authentication value could replay it from another client to establish an authenticated session and access privileged device functionality.", "datePublished": "2026-09-24T19:51:27", "dateUpdated": "2026-09-25T16:29:47", "baseScore": 8.6, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:A/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://www.botslab.com/pages/about-botslab", "https://www.cisa.gov/news-events/ics-advisories/icsa-26-267-01", "https://github.com/cisagov/CSAF/blob/develop/csaf_files/OT/white/2026/icsa-26-267-01.json"], "aliases": ["GHSA-vf9h-pg8f-h64m", "CVE-2026-77967"], "assigner": "icscert", "epss": 0.24, "enisaIdProduct": [{"id": "120c2182-f21a-3357-b357-5352d3ff1965", "product": {"name": "G980H", "vendor": {"name": "Botslab"}}, "product_version": "30010_QHG980HN5294SysFW+"}, {"id": "df7d2bd5-d2f1-3eec-bc7f-ebff1ffe61f3", "product": {"name": "G980H", "vendor": {"name": "Botslab"}}, "product_version": "58_QHG980HMCN5291SysFW+"}], "enisaIdVendor": [{"id": "31b5a8b2-8b53-3368-ab68-4ed59b1bd978", "vendor": {"name": "Botslab"}}], "isExploited": false}