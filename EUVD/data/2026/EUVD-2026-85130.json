{"id": "EUVD-2026-85130", "enisaUuid": "c1a89f05-0463-3706-8be5-7a0cfb3fa7d6", "description": "When processing a specially crafted PDF, Foxit PDF Editor/Reader may perform reentrant zoom and layout operations through page- and annotation-related JavaScript actions. This can cause the application to access page objects after they have been released, resulting in a use-after-free condition and an application crash.", "datePublished": "2026-09-23T07:51:21", "dateUpdated": "2026-09-23T14:47:31", "baseScore": 7.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H", "references": ["https://www.foxit.com/support/security-bulletins.html"], "aliases": ["GHSA-p2r2-w9fr-r7r8", "CVE-2026-91792"], "assigner": "Foxit", "epss": 0.13, "enisaIdProduct": [{"id": "2ce99251-7cbc-3247-bca5-77d067a3b8de", "product": {"name": "Foxit PDF Editor", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 13.2.6 and earlier"}, {"id": "503e5520-0c86-3a95-a767-d92144231aba", "product": {"name": "Foxit PDF Editor", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 2026.2 and earlier"}, {"id": "e9dd54aa-5acd-31e0-a5fb-3078f22c4259", "product": {"name": "Foxit PDF Editor", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 14.0.7 and earlier"}, {"id": "f3eda48a-b6f1-3295-8064-72edbbfd2da6", "product": {"name": "Foxit PDF Reader", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 2026.2 and earlier"}], "enisaIdVendor": [{"id": "79676301-14ef-32ba-8c6f-073744bc64d5", "vendor": {"name": "Foxit Software Inc."}}], "isExploited": false}