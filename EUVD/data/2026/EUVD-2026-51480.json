{"id": "EUVD-2026-51480", "enisaUuid": "5974709f-7ce6-36b7-a7cf-8a0efea09ebc", "description": "Keycloak provides a way to let users log in using Microsoft accounts while restricting access to a specific organization (tenant). A flaw was discovered where this restriction is ignored when using the token exchange feature. This means an attacker with a valid Microsoft token from a completely different organization could gain access to the Keycloak realm, potentially accessing sensitive data or performing unauthorized actions.", "datePublished": "2026-07-31T06:48:14", "dateUpdated": "2026-09-16T18:34:34", "baseScore": 6.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:68277", "https://access.redhat.com/errata/RHSA-2026:68278", "https://access.redhat.com/security/cve/CVE-2026-18215", "https://bugzilla.redhat.com/show_bug.cgi?id=2508309"], "aliases": ["CVE-2026-18215", "GHSA-v8h5-7wp9-qxxv"], "assigner": "redhat", "epss": 0.4, "enisaIdProduct": [{"id": "7529131f-40ac-3879-b2b0-a02274fcff01", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6-20"}, {"id": "a55cd3d1-71bd-3913-b97c-002a43801a35", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6.7-3"}], "enisaIdVendor": [{"id": "b574d700-cfb0-34c0-8b8e-5de6537cb78e", "vendor": {"name": "Red Hat"}}], "isExploited": false}