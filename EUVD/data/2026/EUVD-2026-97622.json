{"id": "EUVD-2026-97622", "enisaUuid": "44f05a5f-f24f-34b0-b7ff-8c9f587e47f7", "description": "The Grav API plugin (grav-plugin-api) before 1.0.36 contains an improper session validation vulnerability that allows disabled accounts to keep API access, because SessionAuthenticator does not enforce account state. Disabled users can reuse an already authorized browser or remember-me session to call API endpoints until expiry, defeating operator revocation.", "datePublished": "2026-10-12T16:05:12", "dateUpdated": "2026-10-13T18:12:07", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:L/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/getgrav/grav/security/advisories/GHSA-7qfj-82q8-frw6", "https://www.vulncheck.com/advisories/grav-api-plugin-before-1.0.36-disabled-account-session-access-bypass"], "aliases": ["GHSA-wcc2-xcpr-vc5h", "CVE-2026-109320"], "assigner": "VulnCheck", "epss": 0.25, "enisaIdProduct": [{"id": "be868202-2e71-313b-8f30-5b7c7344e147", "product": {"name": "grav-plugin-api", "vendor": {"name": "getgrav"}}, "product_version": "0 <1.0.36"}], "enisaIdVendor": [{"id": "32fbfd55-3caa-320e-a529-97815dd2981c", "vendor": {"name": "getgrav"}}], "isExploited": false}