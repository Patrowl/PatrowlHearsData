{"id": "EUVD-2026-101716", "enisaUuid": "bc4ad12a-b5bf-3691-ad22-d2c21fe3db5c", "description": "FreeRDP from 3.0.0-beta1 before 3.32.0 fails to enforce cumulative or absolute size limits when reassembling RDPDR channel fragments in the proxy. Attackers can send a FIRST fragment followed by continuation fragments without LAST, growing per-session heap streams proportional to traffic and exhausting proxy memory.", "datePublished": "2026-10-14T22:52:08", "dateUpdated": "2026-10-16T17:15:19", "baseScore": 8.2, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/FreeRDP/FreeRDP/security/advisories/GHSA-m7g5-gw57-cwcr", "https://www.vulncheck.com/advisories/freerdp-before-3.32.0-unbounded-memory-retention-via-rdpdr-proxy"], "aliases": ["CVE-2026-110833", "GHSA-qh7g-q627-6q97"], "assigner": "VulnCheck", "epss": 0.25, "enisaIdProduct": [{"id": "27ddf330-753f-36c1-b90f-b1378b952afc", "product": {"name": "FreeRDP", "vendor": {"name": "FreeRDP"}}, "product_version": "3.0.0-beta1 <3.32.0"}], "enisaIdVendor": [{"id": "80dd5118-e0d1-31a8-a048-98154a33817e", "vendor": {"name": "FreeRDP"}}], "isExploited": false}