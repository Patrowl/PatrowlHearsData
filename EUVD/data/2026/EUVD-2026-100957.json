{"id": "EUVD-2026-100957", "enisaUuid": "17d4f202-b8af-3883-a514-ed5554622136", "description": "A flaw was found in BusyBox dpkg. The write_status_file() function does not reset a field cursor between package stanzas. When two packages are removed in a single invocation and the first stanza is larger than the second, the second package stanza can be dropped from the status file, causing limited data corruption.", "datePublished": "2026-10-14T10:02:05", "dateUpdated": "2026-10-15T19:33:22", "baseScore": 3.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:L/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:81391", "https://access.redhat.com/security/cve/CVE-2026-88842", "https://bugzilla.redhat.com/show_bug.cgi?id=2531355"], "aliases": ["GHSA-9p9q-94fg-r728", "CVE-2026-88842"], "assigner": "redhat", "epss": 0.17, "enisaIdProduct": [{"id": "2b6599c3-731d-37f9-bfd1-028b447ff945", "product": {"name": "Red Hat Hardened Images", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1.37.0-9.4.hum1"}], "enisaIdVendor": [{"id": "ca4e6c4a-5152-3c32-b45f-f1e36f956337", "vendor": {"name": "Red Hat"}}], "isExploited": false}