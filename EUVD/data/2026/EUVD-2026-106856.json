{"id": "EUVD-2026-106856", "enisaUuid": "e8eec299-1024-3658-b44c-10ccb40871e7", "description": "IBM Carbon Charts 0.4.0 through 1.27.19 is vulnerable to cross-site scripting. The MeterChart component's Title.truncateTitle() function re-inserts a substring of user-supplied label text into the DOM via an unsanitized innerHTML write when the title exceeds the available container width. A remote attacker could exploit this vulnerability to execute arbitrary JavaScript in the victim's browser session.", "datePublished": "2026-10-20T21:31:46", "dateUpdated": "2026-10-20T21:31:46", "baseScore": 6.1, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N", "references": ["https://www.ibm.com/support/pages/node/7291785"], "aliases": ["GHSA-xgrw-h689-334j", "CVE-2026-94402"], "assigner": "ibm", "epss": 0.3, "enisaIdProduct": [{"id": "249955d9-4088-39f7-b410-626bce674568", "product": {"name": "@carbon/charts-vue", "vendor": {"name": "IBM"}}, "product_version": "0.4.0 \u22641.27.19"}, {"id": "51d5e406-d117-36df-87e4-92fd12e1fc26", "product": {"name": "@carbon/charts-angular", "vendor": {"name": "IBM"}}, "product_version": "0.4.0 \u22641.27.19"}, {"id": "664c3ae8-317c-30d0-a37b-0555d404bc3a", "product": {"name": "@carbon/charts", "vendor": {"name": "IBM"}}, "product_version": "0.4.0 \u22641.27.19"}, {"id": "9d35d9ea-d91f-31db-9e38-a4b4414d300a", "product": {"name": "@carbon/charts-react", "vendor": {"name": "IBM"}}, "product_version": "0.4.0 \u22641.27.19"}, {"id": "f83cf7f7-1827-3274-ac59-25cd55453f3e", "product": {"name": "@carbon/charts-svelte", "vendor": {"name": "IBM"}}, "product_version": "0.4.0 \u22641.27.19"}], "enisaIdVendor": [{"id": "a2532d4b-8296-3a67-bf6f-9116fdadd1ab", "vendor": {"name": "IBM"}}], "isExploited": false}