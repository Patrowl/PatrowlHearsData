{"id": "EUVD-2026-99251", "enisaUuid": "5cad4c45-079a-3655-b468-a52b5b2d0755", "description": "Phase Console through 2.77.3 contains a missing authorization vulnerability that allows organisation members without Secrets read permission to read secret history via the secretHistory GraphQL query. Attackers holding an environment key can supply a known secret identifier to retrieve encrypted secret events and decrypt values using their wrapped environment key.", "datePublished": "2026-10-13T18:50:00", "dateUpdated": "2026-10-13T18:50:00", "baseScore": 6.0, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://hackmd.io/@1ExmmukzRMWN7B4gQ4W-4Q/SyZJ_mjize", "https://github.com/phasehq/console/blob/v2.77.3/backend/backend/schema.py#L1022-L1052", "https://github.com/phasehq/console/blob/v2.77.3/backend/backend/schema.py#L985-L1009", "https://github.com/phasehq/console/blob/v2.77.3/backend/api/utils/access/permissions.py#L78-L92", "https://github.com/phasehq/console", "https://www.vulncheck.com/advisories/phase-console-through-2.77.3-missing-authorization-via-secrethistory-graphql-query"], "aliases": ["CVE-2026-110210", "GHSA-mw5f-8wgh-2m29"], "assigner": "VulnCheck", "epss": 0.43, "enisaIdProduct": [{"id": "4c2d7203-f6df-37a4-a4f9-7ee7b7838870", "product": {"name": "Phase Console", "vendor": {"name": "Phase"}}, "product_version": "0 \u22642.77.3"}], "enisaIdVendor": [{"id": "8e65e14c-1b86-3de1-be89-6ed8cd44957b", "vendor": {"name": "Phase"}}], "isExploited": false}