{"id": "EUVD-2026-45224", "enisaUuid": "49ada468-f51b-30f5-8771-1606f249bede", "description": "A flaw was found in the admin REST API of Keycloak, a solution for identity and access management. The issue occurs when a delegated administrator attempts to remove a child role from a composite role. Due to missing authorization checks, an attacker with limited administrative permissions can remove privileged roles they are not authorized to manage, leading to a loss of access for other users and administrators.", "datePublished": "2026-07-17T16:43:16", "dateUpdated": "2026-09-16T18:34:15", "baseScore": 4.9, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:N/I:H/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:68277", "https://access.redhat.com/errata/RHSA-2026:68278", "https://access.redhat.com/security/cve/CVE-2026-16106", "https://bugzilla.redhat.com/show_bug.cgi?id=2501739"], "aliases": ["GHSA-78mv-phq4-25fv", "CVE-2026-16106"], "assigner": "redhat", "epss": 0.42, "enisaIdProduct": [{"id": "320f41d9-9be9-322a-9f3c-097b5126a349", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6.7-3"}, {"id": "76fb5b1c-b42c-32c6-b48b-175e4f6c02fe", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6-20"}], "enisaIdVendor": [{"id": "fa48e1c3-184a-367b-a4bc-cf9bf6570d5f", "vendor": {"name": "Red Hat"}}], "isExploited": false}