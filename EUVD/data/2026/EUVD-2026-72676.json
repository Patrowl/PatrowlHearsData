{"id": "EUVD-2026-72676", "enisaUuid": "6b69bcf8-48fb-3b8e-9975-b6a00f43facf", "description": "It has been discovered that several AJAX routes used for the backend localization wizard failed to perform authorization checks. This allowed authenticated, low-privileged backend users to access information about records and content elements that fall outside of their permitted range. Exploiting this vulnerability requires a low-privileged backend user account.\u00a0This issue affects TYPO3 CMS versions 10.0.0-10.4.59, 11.0.0-11.5.53, 12.0.0-12.4.48, 13.0.0-13.4.34 and 14.0.0-14.3.6.", "datePublished": "2026-09-08T09:18:41", "dateUpdated": "2026-09-08T12:22:01", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://news.typo3.com/security/advisory/typo3-core-sa-2026-022", "https://github.com/TYPO3/typo3/commit/c232421325bd18fc4d13efac0fc018a57da2dcd6", "https://github.com/TYPO3/typo3/commit/35e070fc654def838fbdc45562c2c095d44ca086", "https://github.com/TYPO3/typo3/commit/1c63ce806d1ccac839f4aa54ac7f48a22dd7ea64"], "aliases": ["CVE-2026-77132"], "assigner": "TYPO3", "epss": 0.43, "enisaIdProduct": [{"id": "079b1f1b-be23-308b-9d6d-7802190f6f30", "product": {"name": "TYPO3 CMS", "vendor": {"name": "TYPO3"}}, "product_version": "10.0.0 <10.4.60"}, {"id": "0843a427-6d3d-3806-a6b4-c25772889533", "product": {"name": "TYPO3 CMS", "vendor": {"name": "TYPO3"}}, "product_version": "13.0.0 <13.4.35"}, {"id": "4a3e88dc-31c4-3311-a74e-c56372177ebd", "product": {"name": "TYPO3 CMS", "vendor": {"name": "TYPO3"}}, "product_version": "11.0.0 <11.5.54"}, {"id": "59ec3721-987b-3c53-8560-055954906540", "product": {"name": "TYPO3 CMS", "vendor": {"name": "TYPO3"}}, "product_version": "12.0.0 <12.4.49"}, {"id": "7770ad46-aa7b-3bdc-af93-38b4f3cc3579", "product": {"name": "TYPO3 CMS", "vendor": {"name": "TYPO3"}}, "product_version": "14.0.0 <14.3.7"}], "enisaIdVendor": [{"id": "7cb75054-83aa-342c-