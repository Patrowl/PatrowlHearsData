{"id": "EUVD-2026-101636", "enisaUuid": "9cc6c2a6-3118-3b92-8397-607a84cbad79", "description": "A stack-based buffer overflow vulnerability in the log processing functionality of Palo Alto Networks PAN-OS\u00ae software on Panorama enables an attacker to cause a denial of service (DoS) condition. Repeated attempts to trigger this condition result in the Panorama entering maintenance mode.\n\nCloud NGFW, Prisma\u00ae Access, and standalone PAN-OS firewalls are not affected by this vulnerability.", "datePublished": "2026-10-14T20:19:28", "dateUpdated": "2026-10-15T18:48:22", "baseScore": 4.6, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N/E:U/AU:N/R:U/V:D/RE:M/U:Amber", "references": ["https://security.paloaltonetworks.com/CVE-2026-0318"], "aliases": ["GHSA-v7v4-h8rr-f7x9", "CVE-2026-0318"], "assigner": "palo_alto", "epss": 0.32, "enisaIdProduct": [{"id": "206cc110-d89f-32ab-aa73-72ede6e18d74", "product": {"name": "PAN-OS", "vendor": {"name": "Palo Alto Networks"}}, "product_version": "12.1.0 <12.1.10-h2"}, {"id": "3fdcd1ab-efb5-3ef4-a5a6-d29fa638f34c", "product": {"name": "PAN-OS", "vendor": {"name": "Palo Alto Networks"}}, "product_version": "11.1.0 <11.1.16-h3"}, {"id": "769f4abc-344c-3ab1-a711-c5b4dd8f3913", "product": {"name": "PAN-OS", "vendor": {"name": "Palo Alto Networks"}}, "product_version": "11.2.0 <11.2.16"}, {"id": "c353d9f7-224e-3e8d-9ba5-0362f6a75ed6", "product": {"name": "PAN-OS", "vendor": {"name": "Palo Alto Networks"}}, "product_version": "12.2.0 <12.2.4"}], "enisaIdVendor": [{"id": "41032031-95b3-37fb-9591-633edd4b74b7", "vendor": {"name": "Palo Alto Networks"}}], "isExploited": false}