{"id": "EUVD-2026-107680", "enisaUuid": "951a3568-ad52-30df-bc4b-d14d2f271543", "description": "GitLab has remediated an issue in GitLab CE/EE affecting all versions from 18.2 before 19.3.6, 19.4 before 19.4.3, and 19.5 before 19.5.1 that, under certain conditions, could have allowed an authenticated user with a read_api-scoped token to retrieve a project's incoming email address and create work items, bypassing the token's restrictions, due to insufficient scope enforcement on a GraphQL field.", "datePublished": "2026-10-21T23:35:30", "dateUpdated": "2026-10-23T10:58:25", "baseScore": 6.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:N", "references": ["https://gitlab.com/gitlab-org/gitlab/-/work_items/603510", "https://hackerone.com/reports/3735499", "https://docs.gitlab.com/releases/patches/patch-release-gitlab-19-5-1-released/"], "aliases": ["GHSA-g33c-grwm-jpgc", "CVE-2026-12664"], "assigner": "GitLab", "epss": 0.25, "enisaIdProduct": [{"id": "71b4e526-9eb2-3131-8639-bdd3a128228d", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.5 <19.5.1"}, {"id": "cf0d5a7d-9213-3882-98e6-fe153655de0f", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.4 <19.4.3"}, {"id": "deb4eed1-eb95-3b2e-a0ea-f35fd772efb0", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "18.2 <19.3.6"}], "enisaIdVendor": [{"id": "5430c03b-dc24-3997-b9ce-25003fd91e2a", "vendor": {"name": "GitLab"}}], "isExploited": false}