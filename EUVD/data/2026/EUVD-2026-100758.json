{"id": "EUVD-2026-100758", "enisaUuid": "8717dff6-0037-3a33-92f1-79cc5b5f5e59", "description": "The Ignition Perspective module does not properly validate session privileges when determining Designer-level access. An authenticated user with access to a Vision project could provide their valid Vision session identifier and gain Designer-level privileges. An attacker could exploit these elevated privileges to execute arbitrary code in the context of the Ignition Gateway process.", "datePublished": "2026-10-13T23:22:43", "dateUpdated": "2026-10-14T18:07:39", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://security.inductiveautomation.com/?tcuUid=34477620-731d-4b70-b22b-9450f9a659a3", "https://www.cisa.gov/news-events/ics-advisories/icsa-26-286-01", "https://github.com/cisagov/CSAF/blob/develop/csaf_files/OT/white/2026/icsa-26-286-01.json"], "aliases": ["CVE-2026-92817", "GHSA-q9c5-fvvm-69h6"], "assigner": "icscert", "epss": 0.48, "enisaIdProduct": [{"id": "0bd92fdd-467c-369d-937e-936040b05f0b", "product": {"name": "Ignition", "vendor": {"name": "Inductive Automation"}}, "product_version": "8.3.0 \u22648.3.8"}, {"id": "d2ab4eb3-ac14-3c58-ba0d-a1896942b3c6", "product": {"name": "Ignition", "vendor": {"name": "Inductive Automation"}}, "product_version": "8.1.0 \u22648.1.54"}], "enisaIdVendor": [{"id": "e4191509-1b4d-3ec1-a868-823ccc62cc86", "vendor": {"name": "Inductive Automation"}}], "isExploited": false}