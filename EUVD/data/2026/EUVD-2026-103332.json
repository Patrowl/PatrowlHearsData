{"id": "EUVD-2026-103332", "enisaUuid": "c6bbc643-5f9e-3e60-beea-6777af0d7611", "description": "phpMyFAQ before 4.1.9 and 4.2.0-alpha before 4.2.0-beta contains an account enumeration vulnerability that allows unauthenticated attackers to confirm registered display names and emails via a distinct HTTP 409 response. Attackers can submit guest comments to the comment create endpoint with candidate user and mail values to link names to emails for targeted phishing.", "datePublished": "2026-10-17T18:46:12", "dateUpdated": "2026-10-18T13:26:01", "baseScore": 6.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/thorsten/phpMyFAQ/security/advisories/GHSA-pgxw-7c68-83w7", "https://www.vulncheck.com/advisories/phpmyfaq-before-4.1.9-and-4.2.0-alpha-before-4.2.0-beta-account-enumeration-via-guest-comment-endpoint"], "aliases": ["GHSA-cv2x-hcfv-23pm", "CVE-2026-111887"], "assigner": "VulnCheck", "epss": 0.26, "enisaIdProduct": [{"id": "1461630d-ee3b-3925-a4d5-71f78e372ea0", "product": {"name": "phpMyFAQ", "vendor": {"name": "thorsten"}}, "product_version": "0 <4.1.9"}, {"id": "f1805fed-bebf-3b28-82cb-214e4dd18362", "product": {"name": "phpMyFAQ", "vendor": {"name": "thorsten"}}, "product_version": "4.2.0-alpha <4.2.0-beta"}], "enisaIdVendor": [{"id": "d8ac39a8-df6d-3925-ac2a-76614bbce76f", "vendor": {"name": "thorsten"}}], "isExploited": false}