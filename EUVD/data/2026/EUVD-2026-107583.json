{"id": "EUVD-2026-107583", "enisaUuid": "b2bdf83c-7865-3605-92b3-90e21efb7334", "description": "Laravel is a web application framework. Prior to 12.68.0 and 13.29.0, TokenGuard configured as a standard token-based API guard does not reject a crafted non-string credential. Under affected MySQL or MariaDB configurations, the authentication lookup can match an unintended existing user, allowing an unauthenticated attacker to bypass authentication and take over an account on routes protected by TokenGuard. This issue is fixed in versions 12.68.0 and 13.29.0.", "datePublished": "2026-10-21T21:49:29", "dateUpdated": "2026-10-21T21:49:29", "baseScore": 9.2, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/laravel/framework/security/advisories/GHSA-f9x3-7vq9-cph6", "https://github.com/laravel/framework/commit/8dbb08bccac1be095dba4a9d259a419620f1e8a5", "https://github.com/laravel/framework/commit/9b21ce0a9bb2b2599978bc0b0df4abea952ad31c", "https://github.com/laravel/framework/releases/tag/v12.68.0", "https://github.com/laravel/framework/releases/tag/v13.29.0"], "aliases": ["CVE-2026-114509"], "assigner": "GitHub_M", "epss": 0.4, "enisaIdProduct": [{"id": "3231bd7d-b7f2-3bfc-bd6f-9dfa8749aafa", "product": {"name": "framework", "vendor": {"name": "flarum"}}, "product_version": "13.0.0, < 13.29.0"}, {"id": "72de8449-e877-39f6-9c2d-aef416b3ad3f", "product": {"name": "framework", "vendor": {"name": "flarum"}}, "product_version": "< 12.68.0"}], "enisaIdVendor": [{"id": "023f53b4-859f-32ff-af65-9a1d70d0a4f1", "vendor": {"name": "laravel"}}], "isExploited": false}