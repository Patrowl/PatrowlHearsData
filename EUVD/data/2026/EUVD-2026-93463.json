{"id": "EUVD-2026-93463", "enisaUuid": "883630ed-80ca-3bd0-b30e-9ab527cd3188", "description": "Payload is a free and open source headless content management system. Payload versions from 3.0.0 before 3.90.0 and canary versions from 4.0.0-canary.0 before 4.0.0-canary.34 use a lower-than-recommended PBKDF2 work factor for password hashing, reducing the computational effort required to test recovered password hashes. This issue is fixed in versions 3.90.0 and 4.0.0-canary.34.", "datePublished": "2026-10-06T15:23:14", "dateUpdated": "2026-10-06T17:40:31", "baseScore": 5.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:L/AC:H/AT:P/PR:H/UI:N/VC:H/VI:L/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/payloadcms/payload/security/advisories/GHSA-q6mq-ch85-c8mm", "https://github.com/payloadcms/payload/commit/1bc76e540a10f3ec88340f40591a57dae7456d01", "https://github.com/payloadcms/payload/releases/tag/v3.90.0"], "aliases": ["CVE-2026-105804", "GHSA-q6mq-ch85-c8mm"], "assigner": "GitHub_M", "epss": 0.08, "enisaIdProduct": [{"id": "31ceac09-d330-35ee-b4b1-4bcae66a2ac5", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "3.0.0, < 3.90.0"}, {"id": "9d4aa60b-c94f-3e6a-88ec-ae3c9bf1baaf", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "4.0.0-canary.0, < 4.0.0-canary.34"}], "enisaIdVendor": [{"id": "3a87ffe5-434c-3acc-a8eb-a77ad7207065", "vendor": {"name": "payloadcms"}}], "isExploited": false}