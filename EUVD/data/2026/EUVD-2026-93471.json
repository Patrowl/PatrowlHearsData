{"id": "EUVD-2026-93471", "enisaUuid": "d8f0d5c7-ad6d-3c06-a7af-75ae6c9df94b", "description": "Payload is a free and open source headless content management system. In versions from 3.0.0 before 3.88.0 and canary versions before 4.0.0-canary.27, an untrusted user who can query readable collections through dynamic filters or joins can submit a request that causes SQL injection in the SQLite and Postgres adapters. This issue is fixed in versions 3.88.0 and 4.0.0-canary.27.", "datePublished": "2026-10-06T15:58:51", "dateUpdated": "2026-10-06T17:27:31", "baseScore": 9.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H", "references": ["https://github.com/payloadcms/payload/security/advisories/GHSA-v49j-62m6-pgrr", "https://github.com/payloadcms/payload/commit/a742140ab4fca3160f7f83e9e7d996552ffc3b5a", "https://github.com/payloadcms/payload/releases/tag/v3.88.0"], "aliases": ["CVE-2026-105845", "GHSA-v49j-62m6-pgrr"], "assigner": "GitHub_M", "epss": 0.38, "enisaIdProduct": [{"id": "b239d7b8-70e0-3fdd-a3bf-6790b0cea2d5", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "3.0.0, < 3.88.0"}, {"id": "d64498d0-7531-325d-b8ce-bb903b7e8fc7", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "4.0.0-canary.0, < 4.0.0-canary.27"}], "enisaIdVendor": [{"id": "1f801da2-28d9-3d7c-949e-0aa71bec29d1", "vendor": {"name": "payloadcms"}}], "isExploited": false}