{"id": "EUVD-2026-104481", "enisaUuid": "1f01cdb2-acb2-3c09-8e05-407b67442f86", "description": "AIOHTTP is an asynchronous HTTP client/server framework for asyncio and Python. Prior to 3.14.4, Max-Age processing can overflow and skip closing a connection. An attacker can consequently exhaust the connection pool temporarily until garbage collection resolves the connections. This issue is fixed in version 3.14.4.", "datePublished": "2026-10-19T16:57:26", "dateUpdated": "2026-10-19T17:35:52", "baseScore": 6.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/aio-libs/aiohttp/security/advisories/GHSA-6cjc-53gc-5rqm", "https://github.com/aio-libs/aiohttp/commit/9dd8eaf4e31f1237ef2c1574a8c82a739fca5805", "https://github.com/aio-libs/aiohttp/releases/tag/v3.14.4"], "aliases": ["CVE-2026-111065", "GHSA-6cjc-53gc-5rqm"], "assigner": "GitHub_M", "epss": 0.37, "enisaIdProduct": [{"id": "7d5c6612-f34c-3070-aa9c-506ae0f31f22", "product": {"name": "aiohttp", "vendor": {"name": "aio-libs"}}, "product_version": "< 3.14.4"}], "enisaIdVendor": [{"id": "14bc4352-3d03-3819-abb3-e82649f9de65", "vendor": {"name": "aio-libs"}}], "isExploited": false}