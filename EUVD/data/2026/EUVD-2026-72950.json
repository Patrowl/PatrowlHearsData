{"id": "EUVD-2026-72950", "enisaUuid": "28eddd24-0231-3d97-a4bc-99e1fdaff9ce", "description": "A use-after-free security issue in the cursor management component of MongoDB Server allows an authenticated user to cause a denial of service. Under specific timing conditions during cursor operations, a stale pointer to a freed resource may be retained and subsequently dereferenced during cursor cleanup, leading to a server process crash.", "datePublished": "2026-09-08T16:12:23", "dateUpdated": "2026-09-08T17:58:26", "baseScore": 6.0, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://jira.mongodb.org/browse/SERVER-131870"], "aliases": ["GHSA-6pwv-5gr2-9rh2", "CVE-2026-82063"], "assigner": "mongodb", "epss": 0.37, "enisaIdProduct": [{"id": "0f535d41-8c1a-36c4-9a4b-1abcf41b283b", "product": {"name": "MongoDB Server", "vendor": {"name": "MongoDB, Inc."}}, "product_version": "8.0.0 <8.0.30"}, {"id": "3f789f27-6614-3ff7-b9d5-3a09dc1cd93e", "product": {"name": "MongoDB Server", "vendor": {"name": "MongoDB, Inc."}}, "product_version": "7.0.0 <7.0.41"}, {"id": "86fa2b90-d889-335c-87bd-6335f2e4a6ff", "product": {"name": "MongoDB Server", "vendor": {"name": "MongoDB, Inc."}}, "product_version": "8.3.0 <8.3.9"}], "enisaIdVendor": [{"id": "a4364e5b-f65b-34bb-ae2c-2b750d04a161", "vendor": {"name": "MONGODB"}}], "isExploited": false}