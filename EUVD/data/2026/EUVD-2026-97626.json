{"id": "EUVD-2026-97626", "enisaUuid": "9d504aad-f09a-3450-a6a9-7ab8fea2f57a", "description": "Grav before 2.1.7 contains a denial of service vulnerability that allows authenticated media authors to exhaust memory by uploading compressed oversized raster images. Attackers can reference a Twig or Markdown transform so GD or Imagick decodes the full source without dimension checks, letting anonymous requests repeatedly cause page unavailability.", "datePublished": "2026-10-12T16:05:15", "dateUpdated": "2026-10-13T16:54:24", "baseScore": 7.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/getgrav/grav/security/advisories/GHSA-h253-r5hw-95r5", "https://www.vulncheck.com/advisories/grav-before-2.1.7-memory-exhaustion-via-oversized-image-transforms"], "aliases": ["CVE-2026-109324", "GHSA-fr83-pf82-gwp5"], "assigner": "VulnCheck", "epss": 0.32, "enisaIdProduct": [{"id": "35288651-7a4b-3717-a699-182534d630bd", "product": {"name": "grav", "vendor": {"name": "getgrav"}}, "product_version": "0 <2.1.7"}], "enisaIdVendor": [{"id": "59a8577d-f2f6-3b2b-ba73-ed81baccd573", "vendor": {"name": "getgrav"}}], "isExploited": false}