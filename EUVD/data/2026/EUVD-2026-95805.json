{"id": "EUVD-2026-95805", "enisaUuid": "aab09e3a-713d-32fe-be03-76b60d4bd975", "description": "Usernames and passwords, including the default factory credentials, are stored in plaintext within the configuration file. With administrator rights, the configuration file can be viewed through the CLI or they can be exported from the device through a TFTP transfer from the web interface. A TFTP transfer can be initiated through SNMP which does not require authentication.", "datePublished": "2026-10-09T14:30:47", "dateUpdated": "2026-10-12T22:54:01", "baseScore": 9.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:N/SC:H/SI:H/SA:N", "references": ["https://www.hms-networks.com/", "https://www.hms-networks.com/cybersecurity", "https://www.cisa.gov/news-events/ics-advisories/icsa-26-281-01", "https://github.com/cisagov/CSAF/blob/develop/csaf_files/OT/white/2026/icsa-26-281-01.json"], "aliases": ["GHSA-m3xp-3gmv-xj2x", "CVE-2026-39460"], "assigner": "icscert", "epss": 0.29, "enisaIdProduct": [{"id": "262987f3-4f79-3c69-be42-88330db80304", "product": {"name": "700 series", "vendor": {"name": "Silicon Labs"}}, "product_version": "0 <Firmware Versions 3.11.0"}, {"id": "d840e805-c34c-3785-bc47-315853e8fad5", "product": {"name": "700 series", "vendor": {"name": "Silicon Labs"}}, "product_version": "0 <Bootloader Versions 2.0.6.1"}], "enisaIdVendor": [{"id": "b275a315-4e4a-399e-a6d2-cdf99c8b5b1a", "vendor": {"name": "Red Lion Controls"}}], "isExploited": false}