{"id": "EUVD-2026-85111", "enisaUuid": "a94ad450-32b3-36e8-927b-f7b1a82fab77", "description": "The Getwid \u2013 Gutenberg Blocks plugin for WordPress is vulnerable to Stored Cross-Site Scripting via the Google Maps block's 'customStyle' attribute in all versions up to, and including, 2.1.3. This is due to the use of eval() on user-controlled block content in the frontend JavaScript mapStyles() function.  This makes it possible for authenticated attackers, with Contributor-level access and above, to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page.", "datePublished": "2026-09-23T06:42:04", "dateUpdated": "2026-09-23T14:33:35", "baseScore": 6.4, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:L/I:L/A:N", "references": ["https://www.wordfence.com/threat-intel/vulnerabilities/id/a0db9693-df56-44d3-9167-c21e868c3f88?source=cve", "https://plugins.trac.wordpress.org/browser/getwid/trunk/assets/blocks/map/frontend.js#L4", "https://plugins.trac.wordpress.org/browser/getwid/tags/2.1.3/assets/blocks/map/frontend.js#L4", "https://plugins.trac.wordpress.org/browser/getwid/trunk/includes/blocks/google-map.php#L139", "https://plugins.trac.wordpress.org/browser/getwid/tags/2.1.3/includes/blocks/google-map.php#L139", "https://plugins.trac.wordpress.org/changeset?reponame=&old=3514403%40getwid&new=3514403%40getwid"], "aliases": ["GHSA-pcjw-3vmf-w7jr", "CVE-2026-5924"], "assigner": "Wordfence", "epss": 0.26, "enisaIdProduct": [{"id": "b2687d0b-c51b-394d-b4f4-3c6ade8cbd49", "product": {"name": "Getwid \u2013 Gutenberg Blocks", "vendor": {"name": "jetmonsters"}}, "product_version": "2.1.3"}], "enisaIdVendor": [{"id": "8973c226-9422-3567-ba13-5b4dc3c481ce", "vendor": {"name": "jetmonsters"}}], "isExploited": false}