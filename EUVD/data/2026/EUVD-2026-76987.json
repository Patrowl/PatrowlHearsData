{"id": "EUVD-2026-76987", "enisaUuid": "fcba4507-9674-36ae-b64e-1785526d5a85", "description": "LangBot before 4.10.11 generates password recovery keys with only 24 bits of entropy and applies no rate limiting to the unauthenticated reset-password endpoint. Remote attackers knowing the administrator email can exhaust the keyspace through concurrent requests to reset the admin password and gain account access.", "datePublished": "2026-09-13T10:45:36", "dateUpdated": "2026-09-24T14:21:47", "baseScore": 9.2, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/langbot-app/LangBot/issues/2392", "https://github.com/langbot-app/LangBot", "https://github.com/langbot-app/LangBot/blob/v4.10.2/src/langbot/pkg/core/stages/genkeys.py", "https://github.com/langbot-app/LangBot/blob/v4.10.2/src/langbot/pkg/api/http/controller/groups/user.py", "https://github.com/langbot-app/LangBot/commit/267232c24f93c515d6fd3f7f81c0676066ab1ab8", "https://www.vulncheck.com/advisories/langbot-before-4.10.11-authentication-bypass-via-weak-recovery-key"], "aliases": ["GHSA-6h2j-ghfm-664v", "CVE-2026-90562"], "assigner": "VulnCheck", "epss": 0.74, "enisaIdProduct": [{"id": "e03836e5-5ed1-3080-8ddc-9ef8132b2483", "product": {"name": "LangBot", "vendor": {"name": "langbot-app"}}, "product_version": "4.0.8.1 <4.10.11"}], "enisaIdVendor": [{"id": "ceddec73-d976-315f-a95b-15dbfe95547c", "vendor": {"name": "langbot-app"}}], "isExploited": false}