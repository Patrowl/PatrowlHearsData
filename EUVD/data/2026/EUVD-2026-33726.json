{"id": "EUVD-2026-33726", "enisaUuid": "e7175c33-8cb3-3c87-85c4-e35531950e43", "description": "A flaw was found in rrdcached, a component of rrdtool. A local attacker with access to a rrdcached socket can exploit a stack-based buffer overflow by sending an oversized CREATE request. This vulnerability can lead to a denial of service by crashing the daemon or potentially allow for arbitrary code execution, impacting the integrity and confidentiality of data.", "datePublished": "2026-06-01T17:34:17", "dateUpdated": "2026-09-28T03:30:24", "baseScore": 7.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:33731", "https://access.redhat.com/errata/RHSA-2026:34155", "https://access.redhat.com/errata/RHSA-2026:34156", "https://access.redhat.com/errata/RHSA-2026:68702", "https://access.redhat.com/errata/RHSA-2026:71600", "https://access.redhat.com/errata/RHSA-2026:72277", "https://access.redhat.com/errata/RHSA-2026:72278", "https://access.redhat.com/security/cve/CVE-2026-43958", "https://bugzilla.redhat.com/show_bug.cgi?id=2460932"], "aliases": ["GHSA-pgh2-hfvj-4q69", "CVE-2026-43958"], "assigner": "redhat", "epss": 0.18, "enisaIdProduct": [{"id": "2f16cc9a-e55e-342b-ab8c-831ad5384375", "product": {"name": "Red Hat Enterprise Linux 10", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:1.8.0-21.el10_2"}, {"id": "3244193b-fff5-31fb-b249-50833e77d09d", "product": {"name": "Red Hat Enterprise Linux 8", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:1.7.0-17.el8_10"}, {"id": "4ebeb149-a4dd-3c4b-921a-efb03c2ac797", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:1.7.2-22.el9_8"}, {"id": "5698a0ac-a8e8-3ff4-8921-983f67857944", "product": {"name": "Red Hat Enterprise Linux 10.0 Extended Update Support", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:1.8.0-20.el10_0.1"}, {"id": "5