{"id": "EUVD-2026-94154", "enisaUuid": "07a7d110-e073-3493-99fd-68e1cfe21cd3", "description": "In affected versions of Octopus Server, an authenticated user with permission to modify roles could bypass the protections preventing access abuse resulting in privilege escalation. It was possible for the built-in role to be weakened and the attacker's account added to a privileged team. This was achievable due to improper validation of unsafe equivalence in inputs.", "datePublished": "2026-10-07T01:17:54", "dateUpdated": "2026-10-07T18:40:25", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://advisories.octopus.com/post/2026/sa2026-11"], "aliases": ["CVE-2026-102478", "GHSA-r946-p43h-mw8h"], "assigner": "Octopus", "epss": 0.3, "enisaIdProduct": [{"id": "01b4d19f-770f-36d4-a04f-b9b99955180a", "product": {"name": "Octopus Server", "vendor": {"name": "Octopus Deploy"}}, "product_version": "2026.3.0 <2026.3.15816"}, {"id": "35cc6d3a-b8ae-3f33-96cf-2b0b8c097b61", "product": {"name": "Octopus Server", "vendor": {"name": "Octopus Deploy"}}, "product_version": "2023.2.945 <2026.1.11768"}, {"id": "708a6852-fd19-360d-9f63-8fe0cd456207", "product": {"name": "Octopus Server", "vendor": {"name": "Octopus Deploy"}}, "product_version": "2026.2.0 <2026.2.13408"}], "enisaIdVendor": [{"id": "8ead9c53-a953-3839-b470-4f9165513c7c", "vendor": {"name": "Octopus Deploy"}}], "isExploited": false}