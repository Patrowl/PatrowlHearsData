{"id": "EUVD-2026-51481", "enisaUuid": "8ec9457b-9951-330d-8572-228743f229fb", "description": "A flaw was found in the RoleContainerResource component of Keycloak. The issue occurs because certain name-based endpoints in the admin REST API do not properly enforce authorization checks when managing composite roles. This allows a delegated administrator with manage-realm permissions to remove essential child roles from built-in admin roles, potentially disrupting administrative functions within a realm.", "datePublished": "2026-07-31T07:03:36", "dateUpdated": "2026-09-16T18:34:16", "baseScore": 4.9, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:N/I:H/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:68277", "https://access.redhat.com/errata/RHSA-2026:68278", "https://access.redhat.com/security/cve/CVE-2026-16105", "https://bugzilla.redhat.com/show_bug.cgi?id=2501738"], "aliases": ["CVE-2026-16105", "GHSA-w32v-46r7-99r7"], "assigner": "redhat", "epss": 0.42, "enisaIdProduct": [{"id": "233211f0-3de0-3537-beff-08fce496b9f2", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6-20"}, {"id": "86f81da5-bfe1-38d0-9a64-708df9ee4351", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6.7-3"}], "enisaIdVendor": [{"id": "d2035726-ece8-3c8c-a5ef-8667542729f1", "vendor": {"name": "Red Hat"}}], "isExploited": false}