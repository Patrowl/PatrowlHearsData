{"id": "EUVD-2026-104999", "enisaUuid": "4ae01a32-ef2a-3cbe-92cb-8ec255385083", "description": "Mounting an attacker-controlled FAT image with fault tolerance enabled causes an out-of-bounds heap write during log replay. The write is attacker-positioned and attacker-valued, and on a common embedded memory layout it reaches the FX_MEDIA driver callback, giving control of the instruction pointer.", "datePublished": "2026-10-20T13:10:14", "dateUpdated": "2026-10-20T15:30:22", "baseScore": 7.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H", "references": ["https://github.com/eclipse-threadx/filex/security/advisories/GHSA-c8cj-fj9j-426v"], "aliases": ["CVE-2026-91041"], "assigner": "eclipse", "epss": 0.16, "enisaIdProduct": [{"id": "363311ba-320e-3802-9532-f6a6cf4dd1bf", "product": {"name": "Eclipse ThreadX - FileX", "vendor": {"name": "Eclipse Foundation"}}, "product_version": "0 \u22646.5.1.202602"}], "enisaIdVendor": [{"id": "d7dec2eb-91d8-3843-8e09-3ab8990ec0ee", "vendor": {"name": "Eclipse Foundation"}}], "isExploited": false}