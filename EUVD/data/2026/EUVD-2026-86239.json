, "product_version": "40e1a70b4aedf2859a1829991b48ef0ebe650bf2 <082e378886547b5b1c4075ed307f7c68547868dc"}, {"id": "b66b8ed7-5829-3706-9824-9d3cb85aa3cd", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "40e1a70b4aedf2859a1829991b48ef0ebe650bf2 <eab46d9629807db1b5647d17227e16110a18227f"}, {"id": "c15a2e7c-9f76-302c-952f-4507b52483c6", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 6.1.188"}, {"id": "f95b34a2-1b7e-369a-b4c1-cb23c4e30d4a", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 7.3"}], "enisaIdVendor": [{"id": "63a5dfbe-045d-395b-b6fa-3fe220173b38", "vendor": {"name": "Linux"}}], "isExploited": false}