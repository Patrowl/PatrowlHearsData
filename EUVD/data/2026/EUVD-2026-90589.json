{"id": "EUVD-2026-90589", "enisaUuid": "4b1248fd-c7fc-3605-8e5c-5657bf1b20f3", "description": "A flaw was found in oauth-proxy. The application fails to properly validate the destination redirect parameter (`rd`) during post-login redirection. A remote attacker can exploit this vulnerability by enticing a user to follow a specially crafted link, resulting in the user being redirected to an arbitrary external website after authenticating. This open redirect can be leveraged to conduct phishing attacks or credential theft.", "datePublished": "2026-10-01T09:17:43", "dateUpdated": "2026-10-23T05:09:14", "baseScore": 6.1, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:74380", "https://access.redhat.com/errata/RHSA-2026:74383", "https://access.redhat.com/errata/RHSA-2026:74429", "https://access.redhat.com/errata/RHSA-2026:79039", "https://access.redhat.com/errata/RHSA-2026:79169", "https://access.redhat.com/errata/RHSA-2026:82785", "https://access.redhat.com/errata/RHSA-2026:82813", "https://access.redhat.com/security/cve/CVE-2026-83589", "https://bugzilla.redhat.com/show_bug.cgi?id=2518379"], "aliases": ["CVE-2026-83589", "GHSA-8c7h-7vm9-jhj3"], "assigner": "redhat", "epss": 0.25, "enisaIdProduct": [{"id": "0fc64093-6edf-325e-b03b-9e6236861862", "product": {"name": "Red Hat OpenShift Container Platform 4.21", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1790706478"}, {"id": "3c557054-386c-37ae-bd5f-35d04ff80552", "product": {"name": "Red Hat OpenShift Container Platform 4.18", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1790882320"}, {"id": "4208141c-6937-336d-b0a8-127adb6328c5", "product": {"name": "Red Hat OpenShift Container Platform 4.14", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1791837363"}, {"id": "4ec1d97c-be3f-3bea-99a0-eeaa232d0c6e", "product": {"name": "Red Hat OpenShift Container Platform 4.20", "vendor": {"n