{"id": "EUVD-2026-60097", "enisaUuid": "ba41cb39-f005-396e-9402-7d9d4e6d3734", "description": "openssl_encrypt versions before 1.4.0 use an in-memory rate limiter for TOTP brute-force protection that is not shared across workers and is lost on server restart. Attackers can distribute authentication attempts across multiple server instances or retry immediately after a restart to bypass rate limiting protections.", "datePublished": "2026-08-17T11:04:45", "dateUpdated": "2026-10-08T15:24:51", "baseScore": 9.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/jahlives/openssl_encrypt/security/advisories/GHSA-h45m-mgcp-q388", "https://www.vulncheck.com/advisories/openssl-encrypt-before-totp-rate-limiter-bypass"], "aliases": ["GHSA-crfx-7r98-6r44", "CVE-2026-74878", "PYSEC-2026-3757"], "assigner": "VulnCheck", "epss": 0.75, "enisaIdProduct": [{"id": "edaed1de-a967-31d4-9c11-71315a051d36", "product": {"name": "openssl_encrypt", "vendor": {"name": "jahlives"}}, "product_version": "0 <1.4.0"}], "enisaIdVendor": [{"id": "fce34cf6-218d-31e3-8f69-d4be7c267888", "vendor": {"name": "jahlives"}}], "isExploited": false}