{"id": "EUVD-2026-107393", "enisaUuid": "9700d2c8-de0a-3c7b-a3b1-26469ee9f43f", "description": "Storybook is a frontend workshop for building user interface components and pages in isolation. From 8.0.0 until 8.6.19, 9.1.21, 10.6.2, and 11.0.0-alpha.6, a malicious website can interact with the preview of a running Storybook development server. Insufficient iframe embedding and message-origin restrictions can allow attacker-controlled events to reach the running preview. A developer must visit the malicious website and interact with the injected interface. The attack can cause unauthorized changes to story files and, if a changed file is later executed by a local runtime, arbitrary code execution with the developer's privileges. This issue is fixed in 8.6.19, 9.1.21, 10.6.2, and 11.0.0-alpha.6.", "datePublished": "2026-10-21T17:08:12", "dateUpdated": "2026-10-21T17:08:12", "baseScore": 8.6, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:A/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/storybookjs/storybook/security/advisories/GHSA-f2ph-cmg5-wxc8", "https://github.com/storybookjs/storybook/pull/36726", "https://github.com/storybookjs/storybook/commit/243c06bf8f1e2f09446c44868ea100261e1374da", "https://github.com/storybookjs/storybook/commit/3be03ec6f11f4616471cebc3fc65c13e1bf8c178", "https://github.com/storybookjs/storybook/commit/97513d999910d071c2b36830495dab63e17d9fe0", "https://github.com/storybookjs/storybook/commit/d9b09e332510a88689c71ecc081bbbc2d072476e", "https://github.com/storybookjs/storybook/commit/df3fed468c9b4830605f00068c4bc6b7e1e215ed", "https://github.com/storybookjs/storybook/releases/tag/v10.6.2", "https://github.com/storybookjs/storybook/releases/tag/v11.0.0-alpha.6", "https://github.com/storybookjs/storybook/releases/tag/v8.6.19", "https://github.com/storybookjs/storybook/releases/tag/v9.1.21"], "aliases": ["CVE-2026-114125", "GHSA-f2ph-cmg5-wxc8"], "assigner": "GitHub_M", "epss": 0.38, "enisaIdProduct": [{"id": "129ffbb7-b461-3173-9b9c-6d4638a5a69b", "product": {"name": "storybook", "vendor": {"name": "storybookjs"}}, "product_version": "8.0.0, < 8.6.19"}, {"id": "2d4c373b-bbb7-3864-bc46-9535782175ba", "product": {"name": "storybook", "vendor": {"name": "storybookjs"}}, "product_version": "11.0.0-alpha.0, < 11.0.0-alpha.6"}, {"id": "aae22388-1926-354f-a6f4-c8447952dbe1", "product": {"name": "storybook", "vendor": {"name": "storybookjs"}}, "product_version": "10.0.0, < 10.6.2"}, {"id": "b3f2b841-ceaa-3326-be53-7321b07552f6", "product": {"name": "storybook", "vendor": {"name": "storybookjs"}}, "product_version": "9.0.0, < 9.1.21"}], "enisaIdVendor": [{"id": "d47fba8d-2cfc-346e-89bd-a01928cc5581", "vendor": {"name": "storybookjs"}}], "isExploited": false}