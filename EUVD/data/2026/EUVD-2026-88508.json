{"id": "EUVD-2026-88508", "enisaUuid": "9468e483-4fd3-3a05-bc67-980b276a0146", "description": "Laravel is a web application framework. Prior to 12.69.0 and 13.30.0, Laravel exception debug pages with APP_DEBUG=true pass attacker-controlled input to a Tippy.js tooltip configured with allowHTML true, enabling DOM-based cross-site scripting when a user hovers over the tooltip. This issue is fixed in versions 12.69.0 and 13.30.0.", "datePublished": "2026-09-28T20:59:36", "dateUpdated": "2026-09-29T14:44:03", "baseScore": 3.1, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:N/I:L/A:N", "references": ["https://github.com/laravel/framework/security/advisories/GHSA-jh5r-qr3c-85q8", "https://github.com/laravel/framework/pull/61381", "https://github.com/laravel/framework/commit/b495ca2ec4e15a977e8700328bf13e8a79f29d12", "https://github.com/laravel/framework/releases/tag/v12.69.0", "https://github.com/laravel/framework/releases/tag/v13.30.0"], "aliases": ["GHSA-jh5r-qr3c-85q8", "CVE-2026-102279"], "assigner": "GitHub_M", "epss": 0.2, "enisaIdProduct": [{"id": "071fcf51-2e61-3963-8b49-98e1ac4fb2a2", "product": {"name": "framework", "vendor": {"name": "flarum"}}, "product_version": "13.0.0, < 13.30.0"}, {"id": "7309e321-186b-389e-860a-c6b21b484cce", "product": {"name": "framework", "vendor": {"name": "flarum"}}, "product_version": "< 12.69.0"}], "enisaIdVendor": [{"id": "efdf72c8-39ec-36c9-a55a-1a842189d2ac", "vendor": {"name": "laravel"}}], "isExploited": false}