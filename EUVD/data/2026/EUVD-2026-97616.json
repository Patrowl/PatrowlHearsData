{"id": "EUVD-2026-97616", "enisaUuid": "e878e8c5-a217-37b1-bee2-1b10a8db264a", "description": "Grav Login plugin 1.2.0 before 3.9.9 contains an information disclosure vulnerability that allows publishers to obtain password-reset tokens by authoring a page at the reset route. When a victim opens an emailed reset link, the publisher-controlled page rendered by Login::getPage() exposes the username and bearer token, enabling takeover of more privileged accounts.", "datePublished": "2026-10-12T16:05:08", "dateUpdated": "2026-10-13T16:54:44", "baseScore": 8.5, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:P/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/getgrav/grav/security/advisories/GHSA-277m-9x28-gjq2", "https://www.vulncheck.com/advisories/grav-login-plugin-1.2.0-before-3.9.9-password-reset-token-disclosure-via-reset-page"], "aliases": ["GHSA-7cwq-9cr7-g8jf", "CVE-2026-109314"], "assigner": "VulnCheck", "epss": 0.28, "enisaIdProduct": [{"id": "8dea2898-283f-389a-9699-c1b109da12a5", "product": {"name": "grav-plugin-login", "vendor": {"name": "getgrav"}}, "product_version": "1.2.0 <3.9.9"}], "enisaIdVendor": [{"id": "6eb36ec0-9771-3e20-9e05-f864e739ec35", "vendor": {"name": "getgrav"}}], "isExploited": false}