{"id": "EUVD-2026-98219", "enisaUuid": "039bec21-50db-31d2-a977-cba6fea918b1", "description": "GitLab has remediated an issue in GitLab CE/EE affecting all versions from 18.9 before 19.2.8, 19.3 before 19.3.5, and 19.4 before 19.4.2 that, under certain conditions, could have allowed an authenticated user with a fine-grained Personal Access Token scoped only to user-boundary import permissions to import projects into group namespaces beyond the token's intended scope, due to incorrect authorization of the import target namespace.", "datePublished": "2026-10-13T01:07:11", "dateUpdated": "2026-10-16T18:00:51", "baseScore": 3.1, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:N/I:L/A:N", "references": ["https://gitlab.com/gitlab-org/gitlab/-/work_items/626041", "https://hackerone.com/reports/3843143", "https://docs.gitlab.com/releases/patches/patch-release-gitlab-19-4-2-released/"], "aliases": ["CVE-2026-82632", "GHSA-f8h6-2x47-crgv"], "assigner": "GitLab", "epss": 0.21, "enisaIdProduct": [{"id": "2a835835-95de-34e9-a677-3edd925fb792", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.4 <19.4.2"}, {"id": "682b267c-0c1a-379f-a85e-f82e8edf52fb", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.3 <19.3.5"}, {"id": "d0a817ce-291f-36f5-9a9e-a6ba1ecbe0b4", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "18.9 <19.2.8"}], "enisaIdVendor": [{"id": "49822f8a-a105-39b5-adb8-a7024de8739e", "vendor": {"name": "GitLab"}}], "isExploited": false}