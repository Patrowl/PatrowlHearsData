{"id": "EUVD-2026-57446", "enisaUuid": "20be411b-2fd0-3df6-bd2c-a68b0cf710ae", "description": "Craft CMS versions before 5.10.8 contain an authentication bypass vulnerability in the elements/save action that allows authenticated users to change passwords without verification. Attackers with edit users permission can reset any user's password including administrators by exploiting the unprotected newPassword field in the User element save flow.", "datePublished": "2026-08-12T19:07:35", "dateUpdated": "2026-10-08T15:24:29", "baseScore": 7.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/craftcms/cms/security/advisories/GHSA-p8x7-9vfw-p7vc", "https://www.vulncheck.com/advisories/craft-cms-rc1-before-authentication-bypass-via-password-reset"], "aliases": ["GHSA-9j4x-96g5-572j", "CVE-2026-72786"], "assigner": "VulnCheck", "epss": 0.46, "enisaIdProduct": [{"id": "3149ea69-df7e-374f-8c31-fece1b71de90", "product": {"name": "CMS", "vendor": {"name": "statamic"}}, "product_version": "5.0.0-RC1 <5.10.8"}], "enisaIdVendor": [{"id": "ed9c01a3-732f-3673-beb1-35855710da64", "vendor": {"name": "craftcms"}}], "isExploited": false}