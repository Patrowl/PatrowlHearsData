{"id": "EUVD-2026-87274", "enisaUuid": "acbfdec0-1814-3734-910e-09856bde305c", "description": "GLPI is a free asset and IT management software package. From 0.72 until 10.0.26 and 11.0.8, an authenticated user without the required permission can enable debug mode. The affected user-setting update does not enforce the privilege boundary intended to restrict debug-mode activation. This issue is fixed in versions 11.0.8 and 10.0.26.", "datePublished": "2026-09-25T18:27:33", "dateUpdated": "2026-09-25T19:41:40", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:N/VA:N/SC:L/SI:N/SA:N", "references": ["https://github.com/glpi-project/glpi/security/advisories/GHSA-3vhr-7p54-cqhw", "https://github.com/glpi-project/glpi/commit/e9d8765122aafda5c61eba33bcbd8323569c8a53", "https://github.com/glpi-project/glpi/commit/fb72d60cfc0e155f8f7707f0a2398bd5f17d7071", "https://github.com/glpi-project/glpi/releases/tag/10.0.26", "https://github.com/glpi-project/glpi/releases/tag/11.0.8"], "aliases": ["CVE-2026-45801"], "assigner": "GitHub_M", "epss": 0.31, "enisaIdProduct": [{"id": "4f8db994-b722-3565-bf5d-df77c1a6abe8", "product": {"name": "glpi", "vendor": {"name": "glpi-project"}}, "product_version": "11.0.0, < 11.0.8"}, {"id": "ac103cfa-c885-306c-9695-c9e6e3749451", "product": {"name": "glpi", "vendor": {"name": "glpi-project"}}, "product_version": "0.72, < 10.0.26"}], "enisaIdVendor": [{"id": "488a2921-1819-3078-aa44-50650213fae9", "vendor": {"name": "glpi-project"}}], "isExploited": false}