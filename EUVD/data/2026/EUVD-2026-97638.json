{"id": "EUVD-2026-97638", "enisaUuid": "a5afa466-7de2-3df1-9048-4d4ffaaefef6", "description": "SurrealDB before 3.3.0 contains an authorization bypass vulnerability that allows record users to read fields hidden by field-level SELECT permissions through LIVE SELECT projections. Attackers can project restricted fields from the unreduced $after or $before parameters under an alias to receive exact stored values in CREATE, UPDATE, and DELETE notifications.", "datePublished": "2026-10-12T16:05:23", "dateUpdated": "2026-10-12T16:05:23", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/surrealdb/surrealdb/security/advisories/GHSA-pm6c-q8rh-92m8", "https://www.vulncheck.com/advisories/surrealdb-before-3.3.0-field-permission-bypass-via-live-select-before-after"], "aliases": ["GHSA-578j-w8qc-q89w", "CVE-2026-109336"], "assigner": "VulnCheck", "epss": 0.22, "enisaIdProduct": [{"id": "88532928-c702-3cb7-b29a-98fadaa73fd1", "product": {"name": "surrealdb", "vendor": {"name": "surrealdb"}}, "product_version": "0 <3.3.0"}], "enisaIdVendor": [{"id": "98604234-7908-3aa7-9e12-a5c5b80444fc", "vendor": {"name": "surrealdb"}}], "isExploited": false}