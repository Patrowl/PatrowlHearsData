{"id": "EUVD-2026-95017", "enisaUuid": "7950b335-b70e-3fb4-b065-f7af99395ffb", "description": "league/commonmark from 2.0.0 before 2.10.2 contains a quadratic-time denial of service vulnerability in the GitHub Flavored Markdown Table extension's TableStartParser::tryStart() block-start scan. Unauthenticated attackers can submit a large paragraph of pipe-free lines not starting with letters, forcing repeated full-buffer strpos scans that exhaust PHP worker CPU.", "datePublished": "2026-10-08T14:10:31", "dateUpdated": "2026-10-08T17:03:50", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/thephpleague/commonmark/security/advisories/GHSA-3q6v-r5mr-hxv8", "https://www.vulncheck.com/advisories/league-commonmark-2.0.0-before-2.10.2-quadratic-dos-via-tablestartparser"], "aliases": ["GHSA-84wr-wccg-f5hp", "CVE-2026-105830"], "assigner": "VulnCheck", "epss": 0.37, "enisaIdProduct": [{"id": "d75c98fa-0994-30eb-b925-be4641b2afbd", "product": {"name": "commonmark", "vendor": {"name": "thephpleague"}}, "product_version": "2.0.0 <2.10.2"}], "enisaIdVendor": [{"id": "e3534dc4-afc8-3b6c-9512-79d48bf92888", "vendor": {"name": "thephpleague"}}], "isExploited": false}