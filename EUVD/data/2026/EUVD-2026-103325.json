{"id": "EUVD-2026-103325", "enisaUuid": "4ab18902-e62d-3a94-91ba-52434fe29fde", "description": "phpMyFAQ 3.2.1 before 4.1.9 and 4.2.0-alpha before 4.2.0-beta contains a stored cross-site scripting vulnerability that allows authenticated content authors to inject JavaScript by embedding iframes with data:text/html sources in FAQ or News content. Attackers can bypass the hostless media-host allowlist in FaqHelper::cleanUpContent(), which is rendered via Twig's raw filter, to run phishing interfaces or top-frame redirects for viewers.", "datePublished": "2026-10-17T18:46:17", "dateUpdated": "2026-10-21T21:36:08", "baseScore": 5.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:P/VC:L/VI:L/VA:N/SC:L/SI:L/SA:N", "references": ["https://github.com/thorsten/phpMyFAQ/security/advisories/GHSA-fg92-v5rr-4xjq", "https://www.vulncheck.com/advisories/phpmyfaq-3.2.1-before-4.1.9-and-4.2.0-alpha-before-4.2.0-beta-stored-xss-via-iframe-data-uri"], "aliases": ["GHSA-wwmv-7qmx-vxv3", "CVE-2026-111894"], "assigner": "VulnCheck", "epss": 0.18, "enisaIdProduct": [{"id": "2a0467bb-41c3-357d-addc-3f56d59f6f0f", "product": {"name": "phpMyFAQ", "vendor": {"name": "thorsten"}}, "product_version": "3.2.1 <4.1.9"}, {"id": "4786c1d9-80fa-3fe2-9ec4-b622f45005c5", "product": {"name": "phpMyFAQ", "vendor": {"name": "thorsten"}}, "product_version": "4.2.0-alpha <4.2.0-beta"}], "enisaIdVendor": [{"id": "4da8d0ef-0528-3dd5-9a54-25ff7ba7e4de", "vendor": {"name": "thorsten"}}], "isExploited": false}