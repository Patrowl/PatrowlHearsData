{"id": "EUVD-2026-108544", "enisaUuid": "ee0c8a59-a7cd-3b4f-9b60-b66e340ff931", "description": "The ONVIF device service on the E3 responds to certain informational requests without requiring authentication. A remote, unauthenticated party can retrieve detailed device identifiers along with a list of configured user accounts and their privilege levels. This aids attackers in fingerprinting vulnerable devices and preparing targeted credential attacks.", "datePublished": "2026-10-22T21:53:44", "dateUpdated": "2026-10-23T10:56:09", "baseScore": 6.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://www.kiloview.com/en/download/e3-firmware-downloadlatest-12/", "https://www.cisa.gov/news-events/ics-advisories/icsa-26-295-01", "https://github.com/cisagov/CSAF/blob/develop/csaf_files/OT/white/2026/icsa-26-295-01.json"], "aliases": ["GHSA-xg55-fcfc-cqx9", "CVE-2026-111100"], "assigner": "icscert", "epss": 0.0, "enisaIdProduct": [{"id": "2a94cb6b-5c89-3595-8c41-295c7a627930", "product": {"name": "E3 Firmware", "vendor": {"name": "Kiloview"}}, "product_version": "0 <1.30"}], "enisaIdVendor": [{"id": "12db5615-c93a-3ff6-b01c-7c1b74a60623", "vendor": {"name": "Kiloview"}}], "isExploited": false}