{"id": "EUVD-2026-81414", "enisaUuid": "3b614cc2-7402-3f90-9cd4-c6a86d4cfb13", "description": "The NeuVector JWT verifier accepts noncanonical Base64URL encodings of the same RSA signature field. An attacker holding a valid JWT that has not expired, but was logged out of NeuVector, can continue using the non-expired token with equivalent spelling of the RSA signature field until the token validity expires.", "datePublished": "2026-09-17T09:28:19", "dateUpdated": "2026-09-28T12:03:54", "baseScore": 2.0, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:H/AT:N/PR:L/UI:A/VC:L/VI:L/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/neuvector/neuvector/security/advisories/GHSA-wcx5-mq6c-c54j", "https://bugzilla.suse.com/show_bug.cgi?id=CVE-2026-78426"], "aliases": ["CVE-2026-78426"], "assigner": "suse", "epss": 0.19, "enisaIdProduct": [{"id": "7b0e777a-2660-3b18-90f0-aeb7d24ab1b1", "product": {"name": "neuvector", "vendor": {"name": "SUSE"}}, "product_version": "0 \u2264v5.6.1"}], "enisaIdVendor": [{"id": "280deffe-0666-3d5e-8301-ca33b9791853", "vendor": {"name": "SUSE"}}], "isExploited": false}