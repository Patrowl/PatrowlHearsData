{"id": "EUVD-2026-105176", "enisaUuid": "7c9ec65c-1ea2-35dd-a923-da42007a2340", "description": "ApostropheCMS is an open-source Node.js content management system. In sanitize-html 2.18.0, when an <iframe> is not allowed and disallowedTagsMode is 'discard' (the defaults), its raw-text content is re-sanitized by a recursive call to sanitizeHtml(text, options). The recursion has no bound and starts each nested call with a fresh state. This vulnerability is fixed in 2.18.1.", "datePublished": "2026-10-20T16:19:12", "dateUpdated": "2026-10-20T16:19:12", "baseScore": 5.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L", "references": ["https://github.com/apostrophecms/apostrophe/security/advisories/GHSA-c9rx-x947-fp3h", "https://github.com/apostrophecms/apostrophe/commit/06e4b377f3c360f9e89c32dccd7e505ad5ddf498", "https://github.com/apostrophecms/apostrophe/commit/40b989b1a9dd23d30029b8ce7668634265cfe5ea", "https://github.com/apostrophecms/apostrophe/releases/tag/sanitize-html@2.18.1"], "aliases": ["CVE-2026-113650", "GHSA-c9rx-x947-fp3h"], "assigner": "GitHub_M", "epss": 0.3, "enisaIdProduct": [{"id": "003da685-272e-38e6-bfe5-b705641d6e11", "product": {"name": "sanitize-html", "vendor": {"name": "apostrophecms"}}, "product_version": "2.18.0, < 2.18.1"}, {"id": "485a7202-af24-39ba-baf5-8d5621dc652b", "product": {"name": "Apostrophe ", "vendor": {"name": "apostrophecms"}}, "product_version": "< 4.34.0"}], "enisaIdVendor": [{"id": "fd0609bb-0c18-350f-9741-c1a26787e9bd", "vendor": {"name": "apostrophecms"}}], "isExploited": false}