{"id": "EUVD-2026-91675", "enisaUuid": "45db7019-03fb-374e-86d9-b54d4898f53c", "description": "uv is a Python package and project manager written in Rust. From 0.12.7 until 0.12.18, uv wheel extraction on Windows can process a malicious wheel in a way that writes a file outside the installation prefix, including an executable in a directory already present on the user's PATH. Non-Windows hosts are not affected. This issue is fixed in version 0.12.18.", "datePublished": "2026-10-02T15:29:15", "dateUpdated": "2026-10-02T16:00:53", "baseScore": 5.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:A/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/astral-sh/uv/security/advisories/GHSA-2cv4-cqwr-gwf7", "https://github.com/astral-sh/uv/pull/21923", "https://github.com/astral-sh/uv/commit/67169645278ce082638d619beefa6d062540843b", "https://github.com/astral-sh/uv/releases/tag/0.12.18"], "aliases": ["PYSEC-2026-4305", "CVE-2026-104843", "GHSA-2cv4-cqwr-gwf7"], "assigner": "GitHub_M", "epss": 0.43, "enisaIdProduct": [{"id": "200daa96-ce4a-3fee-bf8b-ab4c23023e88", "product": {"name": "uv", "vendor": {"name": "astral-sh"}}, "product_version": "0.12.7, < 0.12.18"}], "enisaIdVendor": [{"id": "36167fac-1ae7-314c-bb3c-0a2f30825195", "vendor": {"name": "astral-sh"}}], "isExploited": false}