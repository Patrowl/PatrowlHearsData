{"id": "EUVD-2026-98928", "enisaUuid": "fb8ea116-8fa2-3df7-84fb-429282dd6dbd", "description": "Frappe is a full-stack web application framework. Prior to 16.23.0, the get_count() method in reportview composes a count operation around generated SQL through a raw database execution path, allowing crafted report input to alter SQL executed by the application. This issue is fixed in version 16.23.0.", "datePublished": "2026-10-13T16:49:28", "dateUpdated": "2026-10-13T17:51:54", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/frappe/frappe/security/advisories/GHSA-mf6r-q34j-pjw7", "https://github.com/frappe/frappe/pull/40022", "https://github.com/frappe/frappe/pull/40027", "https://github.com/frappe/frappe/commit/49dbde7460fa41528154088d23b6c6e12f733f9b", "https://github.com/frappe/frappe/commit/f4f2df926e3c2db2da5fc79983f285397c028690", "https://github.com/frappe/frappe/releases/tag/v16.23.0"], "aliases": ["CVE-2026-55823"], "assigner": "GitHub_M", "epss": 0.37, "enisaIdProduct": [{"id": "312ad965-30ea-3967-9910-fba5f17a29a5", "product": {"name": "frappe", "vendor": {"name": "Elated-Themes"}}, "product_version": "< 16.23.0"}], "enisaIdVendor": [{"id": "1cbcf267-bb6a-3d4e-9ce8-f256fc5027bd", "vendor": {"name": "frappe"}}], "isExploited": false}