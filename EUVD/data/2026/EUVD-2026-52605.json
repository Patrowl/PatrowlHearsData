"vendor": {"name": "Linux"}}, "product_version": "patch: 7.1.6"}, {"id": "3782b540-7554-3f96-9a9a-c95f1ae280bc", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "42e30bf3463cd37d73839376662cb79b4d5c416c <a63afa1f9b12d5293cbe0b77fd45dc0632533a13"}, {"id": "37926bd3-5792-3122-81e5-1d0bffd5e0d7", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "42e30bf3463cd37d73839376662cb79b4d5c416c <9b2854f86f0b56e9027d68e7a3fc909d1a9b566f"}, {"id": "7f2bad97-3ff6-3996-82cc-6fd669b872c7", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "42e30bf3463cd37d73839376662cb79b4d5c416c <74e8f3e7114f0e26d1b2c4c048044db9fcc27603"}, {"id": "828d77d9-683d-310a-ad46-9a2e09bed53c", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 5.10.265"}, {"id": "8f056026-7ac8-3441-bd41-e1d758bbe470", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "42e30bf3463cd37d73839376662cb79b4d5c416c <fedeb4468987bcaff85fe3061de5ae052d414740"}, {"id": "9cdf1495-efd1-37fe-a9fe-b7b29fdf9c8b", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 6.1.183"}, {"id": "a93d53e3-35b6-31de-b0f1-1d33cd018861", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 6.18.42"}, {"id": "d02edcd5-f8e9-3dd4-b53e-1e6caf363579", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 6.12.101"}, {"id": "e6334504-20e0-3ac7-abd9-99d2b1be74a5", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 7.2"}, {"id": "ee79b107-b307-3318-ac64-ddb82081e7a2", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "42e30bf3463cd37d73839376662cb79b4d5c416c <2b324ba3494ae958cba16a453e3e71489b4de7fc"}], "enisaIdVendor": [{"id": "e1085556-52eb-3bdb-a26a-db8e7d5497de", "vendor": {"name": "Linux"}}], "isExploited": false}