{"id": "EUVD-2026-92156", "enisaUuid": "390c8822-0aee-3b36-af37-a3d8f8f5a350", "description": "Chaterm before 0.12.1 contains a login cross-site request forgery vulnerability that allows remote attackers to inject login state by sending chaterm:// callbacks without OAuth state validation. Attackers can trigger a crafted callback with attacker-controlled userInfo from a web page, signing the victim into the attacker's account so default data sync uploads saved hosts, passwords, and private keys.", "datePublished": "2026-10-05T00:44:18", "dateUpdated": "2026-10-06T22:19:41", "baseScore": 6.0, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:P/VC:H/VI:L/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/Chaterm/Chaterm/pull/2326", "https://github.com/Chaterm/Chaterm/commit/41f747f17845cd980f289cc9ea8ff9978b6f7ad6", "https://github.com/Chaterm/Chaterm", "https://github.com/Chaterm/Chaterm/releases/tag/v0.12.1", "https://github.com/Chaterm/Chaterm/blob/v0.12.0/src/main/index.ts#L3442-L3455", "https://www.vulncheck.com/advisories/chaterm-before-0.12.1-login-csrf-via-chaterm-oauth-callback"], "aliases": ["CVE-2026-105292", "GHSA-xv7q-7232-3gx8"], "assigner": "VulnCheck", "epss": 0.16, "enisaIdProduct": [{"id": "64db5993-d688-312b-857b-1c7fc3a0802f", "product": {"name": "Chaterm", "vendor": {"name": "chaterm"}}, "product_version": "0.2.0 <0.12.1"}], "enisaIdVendor": [{"id": "9f2ea2e8-075e-3f3c-ad5f-42166ed55791", "vendor": {"name": "chaterm"}}], "isExploited": false}