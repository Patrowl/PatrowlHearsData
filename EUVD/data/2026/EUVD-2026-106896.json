{"id": "EUVD-2026-106896", "enisaUuid": "cd1bcc23-5f11-3df9-b536-5d64b22376c6", "description": "Trigger.dev before 4.5.6 contains a cross-site request forgery vulnerability that allows remote attackers to log out authenticated users by sending a link to the GET-based /logout endpoint. Attackers can lure victims into clicking an obfuscated, URL-encoded link that terminates their session, causing loss of unsaved work.", "datePublished": "2026-10-21T00:36:57", "dateUpdated": "2026-10-21T00:36:57", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:P/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/triggerdotdev/trigger.dev/security/advisories/GHSA-2cqj-rq4j-8835", "https://www.vulncheck.com/advisories/trigger-dev-before-4.5.6-cross-site-request-forgery-via-logout-endpoint"], "aliases": ["GHSA-pfmq-q2wh-m57j", "CVE-2026-114093"], "assigner": "VulnCheck", "epss": 0.15, "enisaIdProduct": [{"id": "b79e5dfe-663e-39bb-9ceb-70694f339987", "product": {"name": "trigger.dev", "vendor": {"name": "triggerdotdev"}}, "product_version": "0 <4.5.6"}], "enisaIdVendor": [{"id": "22e769d3-c331-3be6-9364-fb28d71d7ee1", "vendor": {"name": "triggerdotdev"}}], "isExploited": false}