{"id": "EUVD-2026-82736", "enisaUuid": "0d176410-8ed2-399d-9aa0-d677ba314d5e", "description": "A flaw was found in RESTEasy's CorsFilter, which, when configured to allow all origins (\"*\"), reflects the request's Origin header back in the Access-Control-Allow-Origin response together with Access-Control-Allow-Credentials: true. This permissive cross-origin policy allows a malicious website to make credentialed cross-origin requests and read authenticated responses from a victim's session, resulting in a loss of confidentiality.", "datePublished": "2026-09-18T07:20:29", "dateUpdated": "2026-10-19T15:55:49", "baseScore": 7.4, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:H/I:N/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:83082", "https://access.redhat.com/errata/RHSA-2026:83520", "https://access.redhat.com/errata/RHSA-2026:85234", "https://access.redhat.com/security/cve/CVE-2026-89058", "https://bugzilla.redhat.com/show_bug.cgi?id=2519775", "https://github.com/resteasy/resteasy/commit/efeb2b7", "https://github.com/resteasy/resteasy/security/advisories/GHSA-972r-f3fv-whm3"], "aliases": ["CVE-2026-89058"], "assigner": "redhat", "epss": 0.26, "enisaIdProduct": [{"id": "426036f7-f341-32f2-85cc-b8d39ead9217", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:3.0.26-20.el9_8.1"}, {"id": "637b54cc-24eb-320c-ac47-d95d4935fbe4", "product": {"name": "Red Hat build of Quarkus 3.27.6.redhat", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 6.2.19.Final-redhat-00003"}, {"id": "d1d3473e-361e-37a2-9e2f-277d9f0a24eb", "product": {"name": "Red Hat build of Quarkus 3.33.4.redhat", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 6.2.19.Final-redhat-00003"}], "enisaIdVendor": [{"id": "80ccb244-69cb-3713-9c3e-294a1ed44440", "vendor": {"name": "Red Hat"}}], "isExploited": false}