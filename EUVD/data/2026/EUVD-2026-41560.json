{"id": "EUVD-2026-41560", "enisaUuid": "8d40d551-5356-3a39-9965-2764c49d4724", "description": "A flaw was found in GIMP's Paint Shop Pro (PSP) file format parser. This heap buffer overflow vulnerability allows a remote attacker to cause arbitrary code execution or a denial of service (DoS) by tricking a user into opening a specially crafted PSP image file. The vulnerability occurs because the software incorrectly calculates buffer sizes when processing low bit-depth images, leading to an overwrite of adjacent memory.", "datePublished": "2026-07-03T18:29:22", "dateUpdated": "2026-10-12T02:08:04", "baseScore": 7.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:L/UI:R/S:U/C:H/I:H/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:38496", "https://access.redhat.com/errata/RHSA-2026:73768", "https://access.redhat.com/errata/RHSA-2026:80509", "https://access.redhat.com/security/cve/CVE-2026-58379", "https://bugzilla.redhat.com/show_bug.cgi?id=2495997", "https://gitlab.gnome.org/GNOME/gimp/-/commit/b630f167", "https://gitlab.gnome.org/GNOME/gimp/-/issues/16205"], "aliases": ["GHSA-rx3j-28q8-xw3m", "CVE-2026-58379"], "assigner": "redhat", "epss": 0.37, "enisaIdProduct": [{"id": "2d04a6b4-ea9c-30cd-a728-82631c968557", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 2:3.0.4-4.el9_8.5"}, {"id": "97dc50af-a090-39d5-885d-074afde1543c", "product": {"name": "Red Hat Enterprise Linux 9.4 Update Services for SAP Solutions", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 2:2.99.8-4.el9_4.19"}, {"id": "ba4b6dd6-c989-37d6-a276-edfd643bfcfd", "product": {"name": "Red Hat Enterprise Linux 9.6 Extended Update Support", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 2:2.99.8-4.el9_6.20"}], "enisaIdVendor": [{"id": "8cd07415-8ea5-3a53-8eab-242c97235c64", "vendor": {"name": "Red Hat"}}], "isExploited": false}