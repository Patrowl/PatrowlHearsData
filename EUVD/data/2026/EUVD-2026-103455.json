{"id": "EUVD-2026-103455", "enisaUuid": "1c348f1b-a80e-3dfa-a4b1-f43fce6ee81c", "description": "ProjectSend 2.5.0 before 2.7.0 contains an unverified password change vulnerability in PasswordController::update() that lets sessions of Social-provisioned accounts set local passwords without the current password. Attackers holding a stolen session cookie can send PUT /settings/password to create a durable local password, enroll their own second factor, and persistently take over the account.", "datePublished": "2026-10-18T11:38:27", "dateUpdated": "2026-10-19T16:38:48", "baseScore": 7.6, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:N/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/projectsend/projectsend/security/advisories/GHSA-4r8h-mwfm-f5f4", "https://github.com/projectsend/projectsend/commit/717852ff6a99391dbd816a2bb0bb3f40cad70f72", "https://github.com/projectsend/projectsend/releases/tag/v2.7.0", "https://github.com/projectsend/projectsend/blob/v2.6.0/app/Http/Controllers/Settings/PasswordController.php#L54-L90", "https://www.vulncheck.com/advisories/projectsend-2.5.0-before-2.7.0-unverified-password-change-via-settings-password"], "aliases": ["GHSA-xr56-2553-vh5p", "CVE-2026-112002"], "assigner": "VulnCheck", "epss": 0.29, "enisaIdProduct": [{"id": "bf96417b-e128-31e3-a1cc-aabbb068d41d", "product": {"name": "ProjectSend", "vendor": {"name": "projectsend"}}, "product_version": "2.5.0 <2.7.0"}], "enisaIdVendor": [{"id": "27743476-9514-36f6-a3d9-eb82b1ca4092", "vendor": {"name": "projectsend"}}], "isExploited": false}