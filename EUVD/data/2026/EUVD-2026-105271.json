{"id": "EUVD-2026-105271", "enisaUuid": "ead81d49-e178-3fb8-a9bc-2b0eea27945f", "description": "virtualenv is a tool for creating isolated virtual python environments. Prior to 21.14.9, caller-supplied prompt text can become executable syntax in the bash activation prompt. An attacker must influence the value passed to virtualenv, and a user must subsequently activate the environment and draw the prompt. This vulnerability is fixed in 21.14.9.", "datePublished": "2026-10-20T19:51:06", "dateUpdated": "2026-10-20T19:51:06", "baseScore": 7.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:L/AC:H/AT:P/PR:N/UI:A/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/pypa/virtualenv/security/advisories/GHSA-6w3r-xr62-4xcp", "https://github.com/pypa/virtualenv/pull/3418", "https://github.com/pypa/virtualenv/commit/5f48d711731311428aebfae61d46957762155b22", "https://github.com/pypa/virtualenv/releases/tag/21.14.9"], "aliases": ["CVE-2026-113723"], "assigner": "GitHub_M", "epss": 0.14, "enisaIdProduct": [{"id": "d74019a1-4ed8-3691-8c0a-4e4402da29da", "product": {"name": "virtualenv", "vendor": {"name": "pypa"}}, "product_version": "< 21.14.9"}], "enisaIdVendor": [{"id": "1c12bead-8836-33f1-bb86-c88cf548902a", "vendor": {"name": "pypa"}}], "isExploited": false}