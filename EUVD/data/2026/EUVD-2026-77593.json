{"id": "EUVD-2026-77593", "enisaUuid": "fe4b0b51-d37e-3cda-8548-56964881b0fc", "description": "A flaw was found in GIMP. When processing a specially crafted lighting preset file, the Lighting Effects filter does not properly validate the number of light sources. This can lead to an out-of-bounds write, corrupting memory. An attacker could exploit this by convincing a user to open a malicious preset file, potentially causing a crash or enabling arbitrary code execution.", "datePublished": "2026-09-14T15:15:14", "dateUpdated": "2026-10-19T12:19:53", "baseScore": 7.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:75575", "https://access.redhat.com/errata/RHSA-2026:84744", "https://access.redhat.com/security/cve/CVE-2026-90947", "https://bugzilla.redhat.com/show_bug.cgi?id=2533005", "https://gitlab.gnome.org/GNOME/gimp/-/work_items/16682"], "aliases": ["CVE-2026-90947", "GHSA-pcjr-j975-j4c4"], "assigner": "redhat", "epss": 0.13, "enisaIdProduct": [{"id": "cf5990d5-326f-3873-81d4-61a0d3b69275", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 2:3.0.4-4.el9_8.14"}, {"id": "d24040a8-bc9e-33ea-ba74-1ad54bcd41b7", "product": {"name": "Red Hat Enterprise Linux 8", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 8100020261015094823.4c9c024f"}], "enisaIdVendor": [{"id": "0b0e292f-cdf8-302a-ae38-1ea8c1c69ce3", "vendor": {"name": "Red Hat"}}], "isExploited": false}