{"id": "EUVD-2026-12677", "enisaUuid": "87ef802a-0221-3865-8407-58e131b29105", "description": "pyOpenSSL is a Python wrapper around the OpenSSL library. Starting in version 22.0.0 and prior to version 26.0.0, if a user provided callback to `set_cookie_generate_callback` returned a cookie value greater than 256 bytes, pyOpenSSL would overflow an OpenSSL provided buffer. Starting in version 26.0.0, cookie values that are too long are now rejected.", "datePublished": "2026-03-17T23:34:28", "dateUpdated": "2026-09-11T12:09:00", "baseScore": 7.2, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N/E:U", "references": ["https://github.com/pyca/pyopenssl/security/advisories/GHSA-5pwr-322w-8jr4", "https://github.com/pyca/pyopenssl/commit/57f09bb4bb051d3bc2a1abd36e9525313d5cd408", "https://github.com/pyca/pyopenssl/blob/358cbf29c4e364c59930e53a270116249581eaa3/CHANGELOG.rst"], "aliases": ["GHSA-5pwr-322w-8jr4", "CVE-2026-27459", "PYSEC-2026-2269"], "assigner": "GitHub_M", "epss": 0.92, "enisaIdProduct": [{"id": "16f1333a-bc4f-3b9a-b44e-14fc44aa9de5", "product": {"name": "pyopenssl", "vendor": {"name": "pyca"}}, "product_version": "22.0.0, < 26.0.0"}], "enisaIdVendor": [{"id": "283ef075-ffd6-37b2-8dd2-0b5fab9089dd", "vendor": {"name": "pyca"}}], "isExploited": false}