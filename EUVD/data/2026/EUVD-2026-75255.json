{"id": "EUVD-2026-75255", "enisaUuid": "e836e804-1639-35d1-bcbd-67b36bd3df32", "description": "A command injection vulnerability in Palo Alto Networks PAN-OS\u00ae software enables an authenticated administrator to bypass system restrictions and run arbitrary commands as a root user. To be able to exploit this issue, the user must have access to the PAN-OS CLI and the device must be configured with a Luna Hardware Security Module (HSM). \n\nThe security risk posed by this issue is significantly minimized when CLI access is restricted to a limited group of administrators.\n\nPanorama, Cloud NGFW, and Prisma\u00ae Access are not impacted by this vulnerability.", "datePublished": "2026-09-10T05:44:10", "dateUpdated": "2026-10-15T01:11:59", "baseScore": 4.0, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:L/AC:L/AT:P/PR:H/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N/E:U/AU:N/R:U/V:D/RE:M/U:Amber", "references": ["https://security.paloaltonetworks.com/CVE-2026-0309"], "aliases": ["GHSA-w29c-3xrj-p9j4", "CVE-2026-0309"], "assigner": "palo_alto", "epss": 0.51, "enisaIdProduct": [{"id": "2f0d3d75-cf5c-3d91-82f9-786a2f3120af", "product": {"name": "PAN-OS", "vendor": {"name": "Palo Alto Networks"}}, "product_version": "11.2.0 <11.2.4-h21"}, {"id": "826e850d-5dbf-356a-9471-afbbc8065e90", "product": {"name": "PAN-OS", "vendor": {"name": "Palo Alto Networks"}}, "product_version": "11.1.0 <11.1.4-h36"}, {"id": "f2a94eaf-183b-3080-b12c-6f1fd4977e49", "product": {"name": "PAN-OS", "vendor": {"name": "Palo Alto Networks"}}, "product_version": "12.2.0 <12.2.3"}, {"id": "f6c4be8f-0ba1-3c34-955c-da8c4257c362", "product": {"name": "PAN-OS", "vendor": {"name": "Palo Alto Networks"}}, "product_version": "12.1.0 <12.1.4-h10"}, {"id": "f80a5084-7fe0-3da0-8666-d9a363366f29", "product": {"name": "PAN-OS", "vendor": {"name": "Palo Alto Networks"}}, "product_version": "10.2.0 <10.2.7-h37"}], "enisaIdVendor": [{"id": "6c6eeeea-f54a-36ca-be24-dbaae2956cac", "vendor": {"name": "Palo Alto Networks