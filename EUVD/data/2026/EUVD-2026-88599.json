{"id": "EUVD-2026-88599", "enisaUuid": "f2c294d6-4c82-3db2-8ee6-47852d831866", "description": "A flaw has been found in Trusted Domain Project OpenDMARC up to 1.4.2. Affected by this vulnerability is the function opendmarc_sp2_find_mailfrom_domain of the file libopendmarc/opendmarc_spf.c of the component SPF Macro Handler. This manipulation causes improper authentication. The attack is possible to be carried out remotely. The exploit has been published and may be used. Patch name: c48a74c758677fc5272a73eff15ffdbf8afda1a6. Applying a patch is the recommended action to fix this issue.", "datePublished": "2026-09-29T00:45:11", "dateUpdated": "2026-10-01T15:27:22", "baseScore": 6.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:L/VA:L/SC:N/SI:N/SA:N/E:P", "references": ["https://vuldb.com/vuln/411038", "https://vuldb.com/vuln/411038/cti", "https://vuldb.com/cve/CVE-2026-101281", "https://vuldb.com/submit/918284", "https://github.com/trusteddomainproject/OpenDMARC/issues/262", "https://github.com/trusteddomainproject/OpenDMARC/pull/328", "https://xuyongzhe-vt.github.io/share/opendmarc-spf-postmaster-macro.html", "https://github.com/trusteddomainproject/OpenDMARC/commit/c48a74c758677fc5272a73eff15ffdbf8afda1a6"], "aliases": ["GHSA-fvpv-g9f4-87fc", "CVE-2026-101281"], "assigner": "VulDB", "epss": 0.41, "enisaIdProduct": [{"id": "14c9a200-003b-308f-9059-46d2dcfd657b", "product": {"name": "OpenDMARC", "vendor": {"name": "Trusted Domain Project"}}, "product_version": "1.4.1"}, {"id": "7e087e8a-6e96-30d9-98f2-24afeb2187f5", "product": {"name": "OpenDMARC", "vendor": {"name": "Trusted Domain Project"}}, "product_version": "1.4.2"}, {"id": "82826b24-612e-3cd1-810f-b096f4c69d38", "product": {"name": "OpenDMARC", "vendor": {"name": "Trusted Domain Project"}}, "product_version": "1.4.0"}], "enisaIdVendor": [{"id": "1f4f0358-cb60-389a-a72a-c7637e131c5f", "vendor": {"name": "Trusted Domain Project"}}], "isExploited": false}