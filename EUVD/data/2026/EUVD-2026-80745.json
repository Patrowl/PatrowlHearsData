{"id": "EUVD-2026-80745", "enisaUuid": "72d82ab4-9f1d-3fbf-9463-a3fd6b7d7113", "description": "An inapplicable NSEC record may be accepted by a `named` resolver as proof that no wildcard exists, which could allow an attacker at the same or an upstream level of the zone name to mask the existence of a victim's wildcard record.\nThis issue affects BIND 9 versions 9.11.0 through 9.18.50, 9.20.0 through 9.20.27, 9.21.0 through 9.21.25, 9.11.3-S1 through 9.18.50-S1, and 9.20.9-S1 through 9.20.27-S1.", "datePublished": "2026-09-16T13:52:49", "dateUpdated": "2026-09-17T18:44:20", "baseScore": 5.9, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:H/A:N", "references": ["https://kb.isc.org/docs/cve-2026-19941", "https://downloads.isc.org/isc/bind9/9.20.29", "https://downloads.isc.org/isc/bind9/9.21.26"], "aliases": ["GHSA-38fx-cm5x-27pg", "CVE-2026-19941"], "assigner": "isc", "epss": 0.23, "enisaIdProduct": [{"id": "285eeb23-4d87-3d20-a292-826ed3270b73", "product": {"name": "BIND 9", "vendor": {"name": "ISC"}}, "product_version": "9.20.0 \u22649.20.27"}, {"id": "7a9457bb-76ac-3fac-a435-d7fb9b625be7", "product": {"name": "BIND 9", "vendor": {"name": "ISC"}}, "product_version": "9.20.9-S1 \u22649.20.27-S1"}, {"id": "cb7d9150-382a-30a3-be1e-4ff63785035f", "product": {"name": "BIND 9", "vendor": {"name": "ISC"}}, "product_version": "9.11.0 \u22649.18.50"}, {"id": "ef5f34be-30d1-3cbc-9682-e83b1f868344", "product": {"name": "BIND 9", "vendor": {"name": "ISC"}}, "product_version": "9.21.0 \u22649.21.25"}, {"id": "f94090ec-23df-386e-b0ba-a5355be3b4b5", "product": {"name": "BIND 9", "vendor": {"name": "ISC"}}, "product_version": "9.11.3-S1 \u22649.18.50-S1"}], "enisaIdVendor": [{"id": "968f325e-da91-3bc8-ac61-45518f7c8575", "vendor": {"name": "ISC"}}], "isExploited": false}