{"id": "EUVD-2026-105218", "enisaUuid": "d1b45290-2cd6-32ae-b528-0c5f0cc2e604", "description": "ApostropheCMS is an open-source Node.js content management system. Prior to 4.33.0 of ApostropheCMS and 1.6.1 of passport-bridge, cross-host or cross-locale session migration places a single-use bearer session token in a redirect URL. A client that obtains and redeems a still-valid, unconsumed token before its first use can adopt the associated session, including through the passport-bridge cross-locale flow. This issue is fixed in ApostropheCMS 4.33.0 and passport-bridge 1.6.1.", "datePublished": "2026-10-20T17:35:40", "dateUpdated": "2026-10-23T01:58:19", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:L/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/apostrophecms/apostrophe/security/advisories/GHSA-hhvr-8m24-qqr3", "https://github.com/apostrophecms/apostrophe/commit/9500b8b0e1d630d5e07fbb5fd2c25ed0943845ce", "https://github.com/apostrophecms/apostrophe/commit/f84fd41cbf6c22eb8d0008fc9c25df1f7130b350", "https://github.com/apostrophecms/apostrophe/releases/tag/apostrophe@4.33.0"], "aliases": ["GHSA-hhvr-8m24-qqr3", "CVE-2026-113669"], "assigner": "GitHub_M", "epss": 0.34, "enisaIdProduct": [{"id": "b12489bb-1302-3b49-930b-254cb5d48785", "product": {"name": "passport-bridge", "vendor": {"name": "@apostrophecms"}}, "product_version": "< 1.6.1"}, {"id": "c59e2dbf-c7d1-3519-9728-1521ed540ba6", "product": {"name": "Apostrophe ", "vendor": {"name": "apostrophecms"}}, "product_version": "< 4.33.0"}], "enisaIdVendor": [{"id": "46a43c4c-d29d-329b-828a-9057b76af38f", "vendor": {"name": "@apostrophecms"}}, {"id": "f44346e7-f4c0-3e9d-83c2-b1053ab277e2", "vendor": {"name": "apostrophecms"}}], "isExploited": false}