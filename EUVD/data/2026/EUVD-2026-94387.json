{"id": "EUVD-2026-94387", "enisaUuid": "1cee86e7-6202-335a-b5af-d41fc6baf916", "description": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-32 and 6.9.13-57, a crafted XMP profile embedded in an image can cause the profile parser to enter an infinite loop, preventing image processing from completing. This issue is fixed in versions 7.1.2-32 and 6.9.13-57.", "datePublished": "2026-10-07T15:24:18", "dateUpdated": "2026-10-10T02:29:58", "baseScore": 5.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L", "references": ["https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-9p7q-63hw-mcr4", "https://github.com/ImageMagick/ImageMagick/commit/e4f7ad983df6c831832eba3689f96b75f8b67051", "https://github.com/ImageMagick/ImageMagick6/commit/27e36ca5cb446664bfc284d28d91fced8887b025", "https://github.com/ImageMagick/ImageMagick/releases/tag/7.1.2-32", "https://github.com/ImageMagick/ImageMagick6/releases/tag/6.9.13-57"], "aliases": ["CVE-2026-106568"], "assigner": "GitHub_M", "epss": 0.38, "enisaIdProduct": [{"id": "7a27b9e4-7545-3dc9-878a-6f38239d32bf", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "< 6.9.13-57"}, {"id": "bf524c8e-5492-34f1-bf39-18da1c66b497", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "7.0.0, < 7.1.2-32"}], "enisaIdVendor": [{"id": "b5a7a35c-e0be-3f1b-a3a4-71f5c2c79e03", "vendor": {"name": "ImageMagick"}}], "isExploited": false}