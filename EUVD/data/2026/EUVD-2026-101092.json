{"id": "EUVD-2026-101092", "enisaUuid": "dfb5887a-4b79-30ee-aa12-e28c8ad933fb", "description": "Gitea's user SSH and GPG key-list API endpoints omit the profile visibility check applied by their web equivalents. A restricted account can retrieve public keys, key titles, fingerprints, and GPG-embedded email addresses belonging to Limited-visibility users. The disclosure concerns public key material and associated metadata, not private cryptographic keys.", "datePublished": "2026-10-14T14:36:28", "dateUpdated": "2026-10-14T16:45:23", "baseScore": 4.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:N/A:N", "references": ["https://github.com/go-gitea/gitea/security/advisories/GHSA-wwmh-7r9x-fg49", "https://blog.gitea.com/release-of-1.27.3/", "https://github.com/go-gitea/gitea/pull/39004", "https://github.com/go-gitea/gitea/pull/39039", "https://github.com/go-gitea/gitea/releases/tag/v1.27.3"], "aliases": ["CVE-2026-68964"], "assigner": "Gitea", "epss": 0.4, "enisaIdProduct": [{"id": "aabef19f-aca0-3495-a944-80f2591d370d", "product": {"name": "Gitea", "vendor": {"name": "Gitea"}}, "product_version": "0 \u22641.27.2"}], "enisaIdVendor": [{"id": "0acccdc8-5517-3137-8f71-55806d729fb1", "vendor": {"name": "Gitea"}}], "isExploited": false}