{"id": "EUVD-2026-87285", "enisaUuid": "39c709eb-986d-398b-98c6-19b2d039aa46", "description": "GLPI is a free asset and IT management software package. From 11.0.0 until 11.0.8, an attacker can craft a URL for a dashboard that reflects attacker-controlled markup without sufficient output encoding. A user who opens the crafted URL triggers reflected cross-site scripting in the dashboard. This issue is fixed in version 11.0.8.", "datePublished": "2026-09-25T18:34:43", "dateUpdated": "2026-09-29T17:57:14", "baseScore": 7.5, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:A/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/glpi-project/glpi/security/advisories/GHSA-76v9-ch69-g67r", "https://github.com/glpi-project/glpi/commit/9b17a3b2b91070cf197dedae3286322a41c4bc92", "https://github.com/glpi-project/glpi/releases/tag/11.0.8"], "aliases": ["CVE-2026-53610"], "assigner": "GitHub_M", "epss": 0.39, "enisaIdProduct": [{"id": "fdf24086-d0e7-30ae-bb0e-3f266112e023", "product": {"name": "glpi", "vendor": {"name": "glpi-project"}}, "product_version": "11.0.0, < 11.0.8"}], "enisaIdVendor": [{"id": "73fa699d-fdca-34cf-b418-69bbbafe832e", "vendor": {"name": "glpi-project"}}], "isExploited": false}