{"id": "EUVD-2026-75439", "enisaUuid": "52cf6f5a-8585-38a6-815c-006cc034a696", "description": "Renovate before 44.14.7 contains a command injection vulnerability in the Maven Wrapper manager that allows attackers to execute arbitrary commands by specifying a malicious distributionType parameter in maven-wrapper.properties. Attackers can inject shell commands through unescaped distributionType values to achieve remote code execution when Renovate processes Maven Wrapper updates in binarySource=docker mode.", "datePublished": "2026-09-10T13:05:38", "dateUpdated": "2026-09-29T22:10:43", "baseScore": 8.5, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:L/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/renovatebot/renovate/security/advisories/GHSA-f2v7-35mm-3hx7", "https://www.vulncheck.com/advisories/renovate-before-44.14.7-command-injection-via-distributiontype"], "aliases": ["GHSA-q946-5qg8-8wmj", "CVE-2026-88889"], "assigner": "VulnCheck", "epss": 1.05, "enisaIdProduct": [{"id": "5ae5222c-eace-3683-9032-67ec2d7abd9b", "product": {"name": "mend-renovate-ce", "vendor": {"name": "mend"}}, "product_version": "0 <15.4.0"}, {"id": "633725b3-975e-3b68-8ebf-529ec24db389", "product": {"name": "renovate-ce", "vendor": {"name": "mend"}}, "product_version": "0 <15.4.0"}, {"id": "71cc1aff-01b3-3c04-9cd1-ee2bd60c96ed", "product": {"name": "renovate", "vendor": {"name": "renovatebot"}}, "product_version": "0 <44.14.7"}, {"id": "835837be-c35b-3867-8efa-389ad214121b", "product": {"name": "renovate-ee-worker", "vendor": {"name": "mend"}}, "product_version": "0 <15.4.0"}, {"id": "d6d1ffa8-8d78-35cc-ac77-c79a7a1ffe18", "product": {"name": "renovate-ee-server", "vendor": {"name": "mend"}}, "product_version": "0 <15.4.0"}, {"id": "dec0277b-e6e0-3a02-9109-4fc68eff63f8", "product": {"name": "mend-renovate-enterprise-edition", "vendor": {"name": "mend"}}, "product_version": "0 <10.4.0"}], "enisaIdVendor": [{"id": "ae56a211-9a36-33ab-bc2c-c3cf