{"id": "EUVD-2026-105180", "enisaUuid": "56d434d4-1dbb-31db-85f7-96e59121e81a", "description": "ApostropheCMS is an open-source Node.js content management system. From 1.25.0 until 1.28.0, uploadfs Azure backend leaks account-level SAS token into every public attachment URL. When uploadfs is configured with the Azure backend and sas: true, createContainer() builds the BlobServiceClient from a URL that embeds the full SAS query string, and Azure SDK v12 derived clients inherit that query string. This issue is fixed in version 1.28.0.", "datePublished": "2026-10-20T16:26:21", "dateUpdated": "2026-10-21T15:53:38", "baseScore": 5.6, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:L/A:L", "references": ["https://github.com/apostrophecms/apostrophe/security/advisories/GHSA-hhph-8536-gfq5", "https://github.com/apostrophecms/apostrophe/commit/9500b8b0e1d630d5e07fbb5fd2c25ed0943845ce", "https://github.com/apostrophecms/apostrophe/commit/f84fd41cbf6c22eb8d0008fc9c25df1f7130b350", "https://github.com/apostrophecms/apostrophe/releases/tag/uploadfs@1.28.0"], "aliases": ["GHSA-hhph-8536-gfq5", "CVE-2026-113652"], "assigner": "GitHub_M", "epss": 0.26, "enisaIdProduct": [{"id": "6cd3db16-6346-386b-8f60-bde71bc68520", "product": {"name": "uploadfs", "vendor": {"name": "apostrophecms"}}, "product_version": "1.25.0, < 1.28.0"}, {"id": "83de67a4-01a5-3560-a4e3-e6952e0ce6fe", "product": {"name": "Apostrophe ", "vendor": {"name": "apostrophecms"}}, "product_version": "< 4.33.0"}], "enisaIdVendor": [{"id": "0dc31cca-92a9-390c-b96a-3bbfa1b995db", "vendor": {"name": "apostrophecms"}}], "isExploited": false}