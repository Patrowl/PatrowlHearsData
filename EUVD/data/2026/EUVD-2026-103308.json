{"id": "EUVD-2026-103308", "enisaUuid": "2978e6a7-31eb-3944-b14e-786d40b9abc6", "description": "Admidio from 5.0.0 before 5.0.16 contains an insecure direct object reference vulnerability in ForumService::saveTopic() that allows authenticated members to modify other users' forum topics. Attackers can replace the topic_uuid parameter in their own topic_save request, reusing their CSRF token, to overwrite the victim topic's title and first post.", "datePublished": "2026-10-17T18:46:29", "dateUpdated": "2026-10-19T16:39:44", "baseScore": 7.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/Admidio/admidio/security/advisories/GHSA-8256-4wm7-f628", "https://www.vulncheck.com/advisories/admidio-5.0.0-before-5.0.16-idor-via-forum-topic-update"], "aliases": ["CVE-2026-111912", "GHSA-j6q3-mqjq-8j39"], "assigner": "VulnCheck", "epss": 0.18, "enisaIdProduct": [{"id": "8852d19e-d2f1-3941-be2e-06c63a3167b2", "product": {"name": "admidio", "vendor": {"name": "Admidio"}}, "product_version": "5.0.0 <5.0.16"}], "enisaIdVendor": [{"id": "b386b012-a999-3ce8-b32a-41c93842cb63", "vendor": {"name": "Admidio"}}], "isExploited": false}