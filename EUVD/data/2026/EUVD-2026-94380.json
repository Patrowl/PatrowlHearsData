{"id": "EUVD-2026-94380", "enisaUuid": "1bfd9456-7954-37d3-aa6d-96a596baa47c", "description": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-32 and 6.9.13-57, a missing end-of-file check while reading bzip2-compressed image data can cause an infinite loop and exhaust processing resources. This issue is fixed in versions 7.1.2-32 and 6.9.13-57.", "datePublished": "2026-10-07T15:06:28", "dateUpdated": "2026-10-07T17:10:51", "baseScore": 5.9, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-m9c7-gf3j-hx6h", "https://github.com/ImageMagick/ImageMagick/commit/e9872c4a165d869e75d10799c47195725ebf4132", "https://github.com/ImageMagick/ImageMagick6/commit/82f752927a552cbba1213b1d023b85e76845774c", "https://github.com/ImageMagick/ImageMagick/releases/tag/7.1.2-32", "https://github.com/ImageMagick/ImageMagick6/releases/tag/6.9.13-57"], "aliases": ["CVE-2026-106565"], "assigner": "GitHub_M", "epss": 0.4, "enisaIdProduct": [{"id": "03ba24ac-1ba3-3e35-b6c5-5ac395f679b6", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "7.0.0, < 7.1.2-32"}, {"id": "bc78b24d-b7b3-365c-b550-1a45a4118fc9", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "< 6.9.13-57"}], "enisaIdVendor": [{"id": "01918ce2-b7fd-3525-9bcf-fa0490f3887e", "vendor": {"name": "ImageMagick"}}], "isExploited": false}