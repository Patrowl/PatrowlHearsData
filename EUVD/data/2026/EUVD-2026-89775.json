{"id": "EUVD-2026-89775", "enisaUuid": "87f29a61-1a1c-32ee-a6cb-71586dd2ccfe", "description": "An Editor can set file-provisioning metadata (the grafana.app/managedBy, grafana.app/managerId and grafana.app/sourcePath annotations) when creating a dashboard through the dashboard API, because these fields were stored without an authorization check. The dashboard then appears file-provisioned, and administrators can no longer update or delete it through Grafana. The impact is limited to the same organization and no data is exposed.", "datePublished": "2026-09-30T11:06:38", "dateUpdated": "2026-09-30T15:28:07", "baseScore": 5.4, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:L/A:L", "references": ["https://grafana.com/security/security-advisories/cve-2026-13720"], "aliases": ["CVE-2026-13720", "GHSA-9q62-r26p-xcjv"], "assigner": "GRAFANA", "epss": 0.16, "enisaIdProduct": [{"id": "0f3c186e-1544-306c-aad1-52098c5c8cae", "product": {"name": "Grafana Enterprise", "vendor": {"name": "Grafana"}}, "product_version": "13.2.0 <13.2.3"}, {"id": "2e2c6b4e-63b1-326a-a345-326c30413cb3", "product": {"name": "Grafana Enterprise", "vendor": {"name": "Grafana"}}, "product_version": "12.1.0 \u226412.1.10"}, {"id": "33e6dcfc-ccd6-3e4f-b98e-952b1748fea0", "product": {"name": "Grafana Enterprise", "vendor": {"name": "Grafana"}}, "product_version": "12.3.0 \u226412.3.11"}, {"id": "4ac5e436-d16a-38b5-b778-0dd4cdab4005", "product": {"name": "Grafana Enterprise", "vendor": {"name": "Grafana"}}, "product_version": "12.2.0 \u226412.2.11"}, {"id": "4f9dc93c-f8b9-31db-af69-e18337a399a9", "product": {"name": "Grafana OSS", "vendor": {"name": "Grafana"}}, "product_version": "13.0.0 <13.0.10"}, {"id": "73bfdea8-59f9-3e6d-a1d7-3045b2268e58", "product": {"name": "Grafana OSS", "vendor": {"name": "Grafana"}}, "product_version": "12.1.0 \u226412.1.10"}, {"id": "74b786db-58c0-382d-be9a-dc777f893ae7", "product": {"name": "Grafana Enterprise", "vendor": {"name": "Grafana