{"id": "EUVD-2026-101947", "enisaUuid": "89ea49cc-1bdd-3974-8f44-0a3e0074ba2c", "description": "When Jetty's `HttpClient` make a request to a server through a forward proxy, the server may reply with a 407 (Proxy Authentication Required).\n\n\n\nThe client mistakenly interprets the 407 as coming from the proxy, so it re-sends the request with the `Proxy-Authentication` header, which arrives to the server, that now has access to the proxy credentials.", "datePublished": "2026-10-15T08:51:48", "dateUpdated": "2026-10-15T13:50:52", "baseScore": 8.2, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/jetty/jetty.project/security/advisories/GHSA-r2c5-3p8g-wpvw", "https://gitlab.eclipse.org/security/cve-assignment/-/work_items/238"], "aliases": ["CVE-2026-77711", "GHSA-vv2w-r86m-5w27"], "assigner": "eclipse", "epss": 0.32, "enisaIdProduct": [{"id": "074c34da-f69d-3d50-b7ad-8be2ef6fe9ed", "product": {"name": "Eclipse Jetty", "vendor": {"name": "Eclipse Foundation"}}, "product_version": "12.1.0 \u226412.1.12"}, {"id": "175b10b2-3f12-3a57-948d-09e490e91f05", "product": {"name": "Eclipse Jetty", "vendor": {"name": "Eclipse Foundation"}}, "product_version": "9.4.0 \u22649.4.64"}, {"id": "73f7b618-c7f2-3f36-a072-6175d0f36fd8", "product": {"name": "Eclipse Jetty", "vendor": {"name": "Eclipse Foundation"}}, "product_version": "12.0.0 \u226412.0.38"}, {"id": "980bb6d8-c947-35a7-b9a4-ec5eed11a9c4", "product": {"name": "Eclipse Jetty", "vendor": {"name": "Eclipse Foundation"}}, "product_version": "11.0.0 \u226411.0.32"}, {"id": "b63a0f6c-7531-3b9b-a8de-702718d084ed", "product": {"name": "Eclipse Jetty", "vendor": {"name": "Eclipse Foundation"}}, "product_version": "10.0.0 \u226410.0.32"}], "enisaIdVendor": [{"id": "b1a5e03d-f374-331f-9ad5-c1cc20f95816", "vendor": {"name": "Eclipse Foundation"}}], "isExploited": false}