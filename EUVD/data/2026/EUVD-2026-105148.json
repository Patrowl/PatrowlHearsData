{"id": "EUVD-2026-105148", "enisaUuid": "4671a013-1357-36c8-b989-ddd74eca2e39", "description": "Vitest is a Vite-native testing framework for JavaScript and TypeScript projects. From 2.1.0-beta.7 until 4.1.12 and 5.0.3, an unauthenticated non-browser WebSocket client that can reach a development server using interceptorPlugin can register a manual mock whose attacker-controlled url createManualModuleSource inserts unescaped into generated module source. When the developer browser loads the affected module, attacker-controlled JavaScript executes on the development-server origin. This issue is fixed in versions 4.1.12 and 5.0.3.", "datePublished": "2026-10-20T15:19:03", "dateUpdated": "2026-10-23T01:42:51", "baseScore": 4.7, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:C/C:L/I:L/A:N", "references": ["https://github.com/vitest-dev/vitest/security/advisories/GHSA-qxg6-89mg-rqv8", "https://github.com/vitest-dev/vitest/commit/15cc006aa9f8683dc5f7e895d011fa7dc751ce35", "https://github.com/vitest-dev/vitest/commit/b825313243dc55757e8d7c0f9e7a792135e13473", "https://github.com/vitest-dev/vitest/releases/tag/v4.1.12", "https://github.com/vitest-dev/vitest/releases/tag/v5.0.3"], "aliases": ["CVE-2026-112949", "GHSA-qxg6-89mg-rqv8"], "assigner": "GitHub_M", "epss": 0.24, "enisaIdProduct": [{"id": "5b59a7d7-cf03-3e98-8297-5273b99e4aeb", "product": {"name": "vitest", "vendor": {"name": "vitest-dev"}}, "product_version": "2.1.0-beta.7, < 4.1.12"}, {"id": "7c8d3a34-1632-37ad-a667-036116121877", "product": {"name": "mocker", "vendor": {"name": "@vitest"}}, "product_version": "2.1.0-beta.7, < 4.1.12"}, {"id": "ac9b5c83-b1e6-3963-98ac-c9d641782e71", "product": {"name": "mocker", "vendor": {"name": "@vitest"}}, "product_version": "5.0.0, < 5.0.3"}, {"id": "ebab20e7-c636-3645-8d9a-29b2e3845cba", "product": {"name": "vitest", "vendor": {"name": "vitest-dev"}}, "product_version": "5.0.0, < 5.0.3"}], "enisaIdVendor": [{"id": "3c4f3b62-4cdc-3b6e-85ef-3249d8