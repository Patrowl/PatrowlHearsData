{"id": "EUVD-2026-79626", "enisaUuid": "1abfbc58-1bef-3bd5-91ff-7a8a8b5bf8cd", "description": "The LoadImageAsPngBase64 endpoint of the Newell Brands DYMO Connect Desktop local web service accepts a file path parameter without adequate validation, allowing a crafted path to read arbitrary image files from the host filesystem outside the intended scope. Fixed in 1.6.2. The fix limits access by file extension only, not by directory - arbitrary-location reads of files with an allowed image extension remain possible by design (accepted residual risk).", "datePublished": "2026-09-15T20:04:42", "dateUpdated": "2026-09-22T16:22:14", "baseScore": 5.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://mediaserver.newellrubbermaid.com/dls/DCDesktop/win/en/Content/WhatsNew.htm", "https://www.dymo.com/support?cfid=online-support", "https://www.cve.org/CVERecord?id=CVE-2026-76796", "https://raw.githubusercontent.com/cisagov/CSAF/develop/csaf_files/IT/white/2026/va-26-258-01.json"], "aliases": ["CVE-2026-76796", "GHSA-4787-p38v-r57j"], "assigner": "cisa-cg", "epss": 0.18, "enisaIdProduct": [{"id": "0078d49a-c1d4-3069-a260-d6a4e9c56194", "product": {"name": "DYMO Connect Desktop", "vendor": {"name": "Newell Brands"}}, "product_version": "0 <1.6.2"}, {"id": "a2bfd51d-3298-3b67-a93d-36dc1313b13f", "product": {"name": "DYMO Connect Desktop", "vendor": {"name": "Newell Brands"}}, "product_version": "patch: 1.6.2"}], "enisaIdVendor": [{"id": "9596d5a0-efbf-384a-884b-5ef3aeac9352", "vendor": {"name": "Newell Brands"}}], "isExploited": false}