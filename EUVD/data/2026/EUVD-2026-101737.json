{"id": "EUVD-2026-101737", "enisaUuid": "c4a5e39c-b6dd-3e60-b292-1f84f00a961c", "description": "Parse Server before 8.6.97 and 9.0.0 before 9.10.2-alpha.6 does not handle errors raised while sending verification or password reset emails, causing the server process to exit. A client holding only the public application keys can sign up, request a verification email, or request a password reset while the mail provider rejects, rate limits, or is unavailable, crashing the server.", "datePublished": "2026-10-14T22:52:32", "dateUpdated": "2026-10-15T15:40:57", "baseScore": 8.2, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/parse-community/parse-server/security/advisories/GHSA-46jj-qw3p-48fc", "https://www.vulncheck.com/advisories/parse-server-before-8.6.97-and-9.10.2-alpha.6-denial-of-service-via-unhandled-email-error"], "aliases": ["CVE-2026-110854", "GHSA-g2v6-w4hv-64wf"], "assigner": "VulnCheck", "epss": 0.26, "enisaIdProduct": [{"id": "2e5f6379-adb8-3bfc-bc5f-f3f04c3f25e2", "product": {"name": "parse-server", "vendor": {"name": "parse-community"}}, "product_version": "9.0.0 <9.10.2-alpha.6"}, {"id": "80abd1e8-3787-3489-9cc7-14135a84acee", "product": {"name": "parse-server", "vendor": {"name": "parse-community"}}, "product_version": "0 <8.6.97"}], "enisaIdVendor": [{"id": "384f6c7d-75f6-301c-b0e1-125175be0d52", "vendor": {"name": "parse-community"}}], "isExploited": false}