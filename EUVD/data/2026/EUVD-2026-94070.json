{"id": "EUVD-2026-94070", "enisaUuid": "1da0d3af-aa09-3697-bb8d-613b19dd95da", "description": "Backstage is an open framework for building developer portals. Prior to 1.14.6 and 1.15.4, the @backstage/plugin-techdocs-node package is affected by bypass of mkdocs configuration sanitizer in techdocs backend. Users with the ability to commit changes to a repository that uses TechDocs can circumvent the MkDocs configuration file sanitizer introduced in response to CVE-2026-25153 and execute arbitrary code on the TechDocs backend host during documentation generation. This issue is fixed in versions 1.14.6 and 1.15.4.", "datePublished": "2026-10-06T21:43:08", "dateUpdated": "2026-10-07T16:14:14", "baseScore": 7.7, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:C/C:H/I:L/A:L", "references": ["https://github.com/backstage/backstage/security/advisories/GHSA-p75x-jh7p-ppcx", "https://github.com/backstage/backstage/commit/a7d995f11a5d27f0efbdbe8bb6c21b06988c79c9", "https://github.com/backstage/backstage/commit/ef92d3d2b76046205c580e7152956514c15640db", "https://github.com/backstage/backstage/releases/tag/v1.50.5", "https://github.com/backstage/backstage/releases/tag/v1.54.6"], "aliases": ["CVE-2026-106505", "GHSA-p75x-jh7p-ppcx"], "assigner": "GitHub_M", "epss": 0.31, "enisaIdProduct": [{"id": "549292f3-5cb4-3508-99d4-5966a0a56a83", "product": {"name": "backstage", "vendor": {"name": "backstage"}}, "product_version": "1.51.0-next.0, < 1.54.6"}, {"id": "6f936b72-15e7-33a5-b46e-17bbfe2327c5", "product": {"name": "plugin-techdocs-node", "vendor": {"name": "@backstage"}}, "product_version": "< 1.14.6"}, {"id": "a7597dbf-77e3-33d0-be83-244cbc08b4e3", "product": {"name": "backstage", "vendor": {"name": "backstage"}}, "product_version": "< 1.50.5"}, {"id": "f30a6899-b18d-3044-b941-4593181767d6", "product": {"name": "plugin-techdocs-node", "vendor": {"name": "@backstage"}}, "product_version": "1.15.0, < 1.15.4"}], "enisaIdVendor": [{"id": "82351bd7-0583-3