{"id": "EUVD-2026-103212", "enisaUuid": "ca79e207-2cb5-3881-a083-8f334b2536b5", "description": "The Fastcache by Host.it plugin for WordPress is vulnerable to authorization bypass in all versions up to, and including, 1.7.5. This is due to the plugin not properly verifying that a user is authorized to perform an action. This makes it possible for authenticated attackers, with subscriber-level access and above, to add or remove the plugin's page-cache rewrite rules in the site's root .htaccess file.", "datePublished": "2026-10-17T02:31:04", "dateUpdated": "2026-10-18T11:22:48", "baseScore": 4.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:L/A:N", "references": ["https://www.wordfence.com/threat-intel/vulnerabilities/id/1f0b4db0-2ccd-47e8-8f40-82e97726f815?source=cve", "https://plugins.trac.wordpress.org/browser/fastcache-by-host-it/tags/1.7.4/src/Admin.php#L304", "https://plugins.trac.wordpress.org/browser/fastcache-by-host-it/tags/1.7.4/src/Admin.php#L44", "https://plugins.trac.wordpress.org/browser/fastcache-by-host-it/tags/1.7.4/src/Core/Platform/Utility.php#L372", "https://plugins.trac.wordpress.org/changeset?reponame=&old=3737013%40fastcache-by-host-it&new=3737013%40fastcache-by-host-it"], "aliases": ["CVE-2026-107763", "GHSA-2x22-cf39-j42v"], "assigner": "Wordfence", "epss": 0.21, "enisaIdProduct": [{"id": "f57338be-97e8-3c3f-8664-0554b044c49e", "product": {"name": "Fastcache by Host.it", "vendor": {"name": "hostspa"}}, "product_version": "0 \u22641.7.5"}], "enisaIdVendor": [{"id": "efc23097-d7ed-3c95-bc46-9f1b6ecc18b3", "vendor": {"name": "hostspa"}}], "isExploited": false}