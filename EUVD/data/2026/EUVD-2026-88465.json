{"id": "EUVD-2026-88465", "enisaUuid": "10bd218d-b1ae-34c6-81ae-fba443f8b9b1", "description": "Authlib (v1.7.2 and below) contains a signature verification bypass vulnerability. The JsonWebSignature.deserialize_json() method accepts a JSON Serialization JWS object and returns the payload as successfully verified without checking for a signature and without requiring a cryptographic key.", "datePublished": "2026-09-28T19:37:58", "dateUpdated": "2026-10-01T13:58:32", "baseScore": 9.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H", "references": ["https://github.com/authlib/authlib", "https://kb.cert.org/vuls/id/762428"], "aliases": ["GHSA-6m87-8wg6-hh8w", "CVE-2026-96760"], "assigner": "certcc", "epss": 0.28, "enisaIdProduct": [{"id": "db2ce897-769b-3488-a43f-fc2b0133b739", "product": {"name": "authlib", "vendor": {"name": "authlib"}}, "product_version": "1.7.2"}], "enisaIdVendor": [{"id": "69b5920a-16b8-3737-bec4-b41138342ac0", "vendor": {"name": "authlib"}}], "isExploited": false}