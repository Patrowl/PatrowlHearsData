{"id": "EUVD-2026-107582", "enisaUuid": "88757dd0-9553-3b12-82f8-a258d6b8314a", "description": "Laravel is a web application framework. From 12.45.0 until 12.68.0 and 13.27.0, crafted relationship inclusion on a read-only endpoint can trigger a destructive database operation on a related table instead of retrieving data. A user with read access but no write permission can empty related-table data, causing irreversible data loss, denial of service, and loss of data integrity. This issue is fixed in versions 12.68.0 and 13.27.0.", "datePublished": "2026-10-21T21:45:31", "dateUpdated": "2026-10-21T21:45:31", "baseScore": 6.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:L", "references": ["https://github.com/laravel/framework/security/advisories/GHSA-5wcm-3v2w-8362", "https://github.com/laravel/framework/pull/61322", "https://github.com/laravel/framework/pull/61323", "https://github.com/laravel/framework/commit/50a7970efe9f9990b6ec4f1e949de2abaaf4263e", "https://github.com/laravel/framework/commit/b89f2944995d555bfda76dced1ef6c6b04ef17d8", "https://github.com/laravel/framework/releases/tag/v12.68.0", "https://github.com/laravel/framework/releases/tag/v13.27.0"], "aliases": ["CVE-2026-114508"], "assigner": "GitHub_M", "epss": 0.31, "enisaIdProduct": [{"id": "1dc5094b-a707-3941-a568-6eebe7f2c03d", "product": {"name": "framework", "vendor": {"name": "flarum"}}, "product_version": "12.45.0, < 12.68.0"}, {"id": "2d69f59e-cf93-3de7-9d2f-1256f745d16f", "product": {"name": "framework", "vendor": {"name": "flarum"}}, "product_version": "13.0.0, < 13.27.0"}], "enisaIdVendor": [{"id": "066f0d90-dc0e-3a7f-ac58-f3bda6169739", "vendor": {"name": "laravel"}}], "isExploited": false}