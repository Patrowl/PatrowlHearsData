{"id": "EUVD-2026-103336", "enisaUuid": "edbd4835-9f08-381a-bcf6-03719c21dc4a", "description": "phpMyFAQ 3.2.0-alpha before 4.1.9 and 4.2.0-alpha before 4.2.0-beta contains an authentication bypass vulnerability that allows IdP-authenticated users to skip TOTP two-factor authentication through the Keycloak and Entra ID SSO callbacks. Attackers holding a valid or phished IdP identity linked to a 2FA-enabled account can complete the OIDC flow and obtain a fully authenticated session, including administrator accounts.", "datePublished": "2026-10-17T18:46:09", "dateUpdated": "2026-10-18T12:23:32", "baseScore": 8.6, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:P/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/thorsten/phpMyFAQ/security/advisories/GHSA-43g3-pp5p-fg96", "https://github.com/thorsten/phpMyFAQ/security/advisories/GHSA-8fvf-747v-qjr6", "https://www.vulncheck.com/advisories/phpmyfaq-3.2.0-alpha-before-4.1.9-and-4.2.0-alpha-before-4.2.0-beta-totp-2fa-bypass-via-sso-callbacks"], "aliases": ["CVE-2026-111882", "GHSA-74rq-7w8c-gr94"], "assigner": "VulnCheck", "epss": 0.39, "enisaIdProduct": [{"id": "67a73368-3227-3616-aa01-d0ca428008f9", "product": {"name": "phpMyFAQ", "vendor": {"name": "thorsten"}}, "product_version": "3.2.0-alpha <4.1.9"}, {"id": "c7865a0c-a78c-325a-b73c-db65ae400e98", "product": {"name": "phpMyFAQ", "vendor": {"name": "thorsten"}}, "product_version": "4.2.0-alpha <4.2.0-beta"}], "enisaIdVendor": [{"id": "f17c67f8-9cbf-38d0-baaa-35dc189ea75d", "vendor": {"name": "thorsten"}}], "isExploited": false}