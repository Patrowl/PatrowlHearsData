{"id": "EUVD-2026-91466", "enisaUuid": "ed8b1bf9-d6c4-39e4-8835-a308588def71", "description": "YesWiki before 4.6.7 contains an access control bypass vulnerability that allows unauthenticated attackers to read restricted page content via the recentchangesrssplus RSS action. Attackers can request the xml method of a page hosting the action to retrieve 500-character body excerpts of every latest page, including read-restricted drafts and notes.", "datePublished": "2026-10-02T11:38:25", "dateUpdated": "2026-10-02T13:35:22", "baseScore": 6.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/YesWiki/yeswiki/security/advisories/GHSA-89vc-h4r4-h25q", "https://www.vulncheck.com/advisories/yeswiki-before-4.6.7-read-acl-bypass-via-recentchangesrssplus-rss-action"], "aliases": ["GHSA-x8xj-595c-jcc3", "CVE-2026-104455"], "assigner": "VulnCheck", "epss": 0.37, "enisaIdProduct": [{"id": "9f7f7e1a-f68c-37d2-b0b6-d4c76a5572eb", "product": {"name": "yeswiki", "vendor": {"name": "YesWiki"}}, "product_version": "0 <4.6.7"}], "enisaIdVendor": [{"id": "637af6cb-fd23-3f16-a555-9d7bc3d30fad", "vendor": {"name": "YesWiki"}}], "isExploited": false}