{"id": "EUVD-2026-72008", "enisaUuid": "224e7f6f-57a6-3f03-9ebf-504917c296b5", "description": "WWBN AVideo generates passwords for external-login accounts using rand() instead of a cryptographic generator, producing only 31-bit integers. Attackers with access to password hashes can recover plaintext passwords in minutes through offline brute-force attacks due to unsalted MD5-based hashing.", "datePublished": "2026-09-05T12:09:03", "dateUpdated": "2026-09-10T15:05:16", "baseScore": 7.4, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:H/AT:P/PR:H/UI:N/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/WWBN/AVideo/security/advisories/GHSA-h3ff-c2qq-pr2g", "https://www.vulncheck.com/advisories/wwbn-avideo-weak-prng-password-generation-via-external-login"], "aliases": ["GHSA-hfr9-8xm8-cq6w", "CVE-2026-86187"], "assigner": "VulnCheck", "epss": 0.36, "enisaIdProduct": [{"id": "332597de-e1e2-367e-92d0-84ec1c669b6b", "product": {"name": "AVideo", "vendor": {"name": "WWBN"}}, "product_version": "0 \u226429.0"}], "enisaIdVendor": [{"id": "070ac4d7-0001-35df-a3fa-4e3458253912", "vendor": {"name": "WWBN"}}], "isExploited": false}