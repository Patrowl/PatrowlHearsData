{"id": "EUVD-2026-87144", "enisaUuid": "8cff072d-6313-3bc5-a2be-23b3a27a86f6", "description": "RabbitMQ is a messaging and streaming broker. From 3.13.0 until 3.13.15, 4.0.20, 4.1.11, and 4.2.6, the Web STOMP WebSocket handler enforced neither max_frame_size nor login_timeout before authentication, allowing an unauthenticated client to keep a connection alive with a slow stream of small frames and accumulate unbounded pre-authentication state. The rabbitmq_web_stomp plugin must be enabled, and no authentication is required to reach the vulnerable path. This issue is fixed in versions 3.13.15, 4.0.20, 4.1.11, and 4.2.6.", "datePublished": "2026-09-25T16:01:40", "dateUpdated": "2026-09-29T19:22:26", "baseScore": 6.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/rabbitmq/rabbitmq-server/security/advisories/GHSA-7v63-j4gm-p4rh", "https://github.com/rabbitmq/rabbitmq-server/commit/0b4080fa5d6f797b6331d0ce1db2b4bacd34560e", "https://github.com/rabbitmq/rabbitmq-server/commit/8138edae6d2beaafe699a41a754d17420bdc2068", "https://github.com/rabbitmq/rabbitmq-server/commit/c1000ba89052608c01c052d98016403ba6e92222", "https://github.com/rabbitmq/rabbitmq-server/releases/tag/v4.2.6"], "aliases": ["CVE-2026-67230"], "assigner": "GitHub_M", "epss": 0.58, "enisaIdProduct": [{"id": "01f3b0d1-792e-3604-9dc8-b4c07e4d0290", "product": {"name": "rabbitmq-server", "vendor": {"name": "rabbitmq"}}, "product_version": "4.1.0, < 4.1.11"}, {"id": "4d7ef50c-f4dc-3a8d-8df4-2790e0ca32b9", "product": {"name": "rabbitmq-server", "vendor": {"name": "rabbitmq"}}, "product_version": "4.0.0, < 4.0.20"}, {"id": "70a04356-1277-336a-ac00-61209652717a", "product": {"name": "rabbitmq-server", "vendor": {"name": "rabbitmq"}}, "product_version": "4.2.0, < 4.2.6"}, {"id": "73af84ac-30f7-31d7-a380-00eeef243984", "product": {"name": "rabbitmq-server", "vendor": {"name": "rabbitmq"}}, "product_version": "3.13.0, < 3.13.15"}], "enisaIdVendor": [{"id": "0d2824ca-d480-3690-bbae-8e6e55faae31", "vendor": {"name": "rabbitmq"}}], "isExploited": false}