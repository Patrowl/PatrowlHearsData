{"id": "EUVD-2026-77454", "enisaUuid": "e5840cb8-dcc7-35b5-8902-d3c57d128299", "description": "Froxlor before 2.3.7 fails to properly scope sender alias lookups to the current customer in customer_email.php. Authenticated attackers can enumerate global sender alias IDs and read other customers' allowed sender values by supplying arbitrary senderid parameters in delete confirmation requests.", "datePublished": "2026-09-14T12:48:30", "dateUpdated": "2026-10-08T15:26:00", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/froxlor/froxlor/security/advisories/GHSA-mr9h-45p9-fg8h", "https://www.vulncheck.com/advisories/froxlor-before-2.3.7-information-disclosure-via-customer-email-php"], "aliases": ["GHSA-wc79-h887-58h9", "CVE-2026-90936"], "assigner": "VulnCheck", "epss": 0.31, "enisaIdProduct": [{"id": "88795556-2dd9-3235-9c3e-79915cfdd5a2", "product": {"name": "Froxlor", "vendor": {"name": "froxlor"}}, "product_version": "0 <2.3.7"}], "enisaIdVendor": [{"id": "ecac6ed6-2e50-3d10-8ee5-42de81b8f6ff", "vendor": {"name": "froxlor"}}], "isExploited": false}