{"id": "EUVD-2026-85542", "enisaUuid": "cefe6fcf-7591-3f5d-a3bc-737fc3926510", "description": "RunAdHocCommand.build_args() appends limit as bare\n              positional (args.append(limit)) instead of using\n              args.extend(['-l', limit]) like RunJob. A limit beginning\n              with - is parsed as an ansible CLI option. Currently\n              limited to short-circuit flags (--version, --help) since\n              injected element displaces required pattern positional.\n              Would escalate if ansible-core ever defaults pattern.", "datePublished": "2026-09-23T18:29:05", "dateUpdated": "2026-10-16T12:01:25", "baseScore": 3.1, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:N/I:L/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:71113", "https://access.redhat.com/errata/RHSA-2026:71114", "https://access.redhat.com/errata/RHSA-2026:71177", "https://access.redhat.com/errata/RHSA-2026:71179", "https://access.redhat.com/security/cve/CVE-2026-71465", "https://bugzilla.redhat.com/show_bug.cgi?id=2512375"], "aliases": ["GHSA-j69q-g7fm-7qpm", "CVE-2026-71465"], "assigner": "redhat", "epss": 0.21, "enisaIdProduct": [{"id": "060ce90c-0833-302b-a2b5-3f7e8ebef94d", "product": {"name": "Red Hat Ansible Automation Platform 2.6 for RHEL 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:4.7.17-1.el9ap"}, {"id": "09d6a570-9b13-3f63-a34e-bf7bf9fc7adf", "product": {"name": "Red Hat Ansible Automation Platform 2.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1789673739"}, {"id": "a1bc716b-1002-39f9-99cc-2b361fc5ef27", "product": {"name": "Red Hat Ansible Automation Platform 2.5 for RHEL 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:4.6.33-1.el9ap"}, {"id": "a82c13d7-43c2-3615-bbaf-0fcfe609736f", "product": {"name": "Red Hat Ansible Automation Platform 2.7", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1789580684"}, {"id": "e0bed6e5-d9b7-3fa6-a290-9b