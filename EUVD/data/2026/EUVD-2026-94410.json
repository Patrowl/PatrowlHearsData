{"id": "EUVD-2026-94410", "enisaUuid": "7e44db6b-d41b-3922-b55f-d39fa67b2e70", "description": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-30 and 6.9.13-55, when ImageMagick is built without Cairo support, a crafted RSVG image that reaches a resource limit can cause the RSVG decoder to free image state twice and then use freed memory, crashing the process. This issue is fixed in versions 7.1.2-30 and 6.9.13-55.", "datePublished": "2026-10-07T15:58:15", "dateUpdated": "2026-10-07T17:40:58", "baseScore": 5.9, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-f2r2-qw7g-3c8x", "https://github.com/ImageMagick/ImageMagick/commit/326451aae51ac2dabc99fe66e063de6ec14cf8c8", "https://github.com/ImageMagick/ImageMagick6/commit/04a4c5b89c034cf2c93bb0a10044332d941b4fa5", "https://github.com/ImageMagick/ImageMagick/releases/tag/7.1.2-30", "https://github.com/ImageMagick/ImageMagick6/releases/tag/6.9.13-55"], "aliases": ["CVE-2026-107209"], "assigner": "GitHub_M", "epss": 0.33, "enisaIdProduct": [{"id": "0bf95189-3ca2-33d1-be52-e0b377eb7f3a", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "7.0.0, < 7.1.2-30"}, {"id": "ecf30452-59b5-3353-b31b-300a3b21423c", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "< 6.9.13-55"}], "enisaIdVendor": [{"id": "16bd1e9e-caa3-3b3a-92d5-c3beb8910e68", "vendor": {"name": "ImageMagick"}}], "isExploited": false}