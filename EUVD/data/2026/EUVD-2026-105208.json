{"id": "EUVD-2026-105208", "enisaUuid": "818c54c4-2321-3c8a-86b4-fe03eb720c3f", "description": "ApostropheCMS is an open-source Node.js content management system. Prior to 4.33.0, ApostropheCMS\u2019s exist-in-locale API allows an authenticated low-privilege user to determine whether restricted documents exist in a specified locale and mode, including draft mode. The endpoint returns localized document identifiers without applying document-level view or edit authorization criteria. This issue is fixed in version 4.33.0.", "datePublished": "2026-10-20T17:04:06", "dateUpdated": "2026-10-20T17:43:51", "baseScore": 4.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:N/A:N", "references": ["https://github.com/apostrophecms/apostrophe/security/advisories/GHSA-vmxh-77cw-65j7", "https://github.com/apostrophecms/apostrophe/commit/9500b8b0e1d630d5e07fbb5fd2c25ed0943845ce", "https://github.com/apostrophecms/apostrophe/commit/f84fd41cbf6c22eb8d0008fc9c25df1f7130b350", "https://github.com/apostrophecms/apostrophe/releases/tag/apostrophe@4.33.0"], "aliases": ["GHSA-vmxh-77cw-65j7", "CVE-2026-113660"], "assigner": "GitHub_M", "epss": 0.36, "enisaIdProduct": [{"id": "9a081bb5-f869-3b84-a331-1354e73a14da", "product": {"name": "Apostrophe ", "vendor": {"name": "apostrophecms"}}, "product_version": "< 4.33.0"}], "enisaIdVendor": [{"id": "0e7d9c4c-6c83-3f02-8c9d-9b90a3a3fc53", "vendor": {"name": "apostrophecms"}}], "isExploited": false}