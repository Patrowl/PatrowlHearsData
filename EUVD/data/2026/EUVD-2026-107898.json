{"id": "EUVD-2026-107898", "enisaUuid": "22d21a99-c0bb-3e3f-a2a7-7cd109a06096", "description": "Traefik before 2.11.58 and 3.7.13 contains an authentication bypass vulnerability that allows unauthenticated clients to skip client-certificate checks because negated Host matchers are counted as served domains. Attackers can reach backends protected by RequireAndVerifyClientCert when a router rule with !Host() creates a TLS options conflict that falls back to the default options.", "datePublished": "2026-10-22T01:43:42", "dateUpdated": "2026-10-22T01:43:42", "baseScore": 6.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:N/VI:N/VA:N/SC:H/SI:L/SA:N", "references": ["https://github.com/traefik/traefik/security/advisories/GHSA-2272-4vv8-65ww", "https://www.vulncheck.com/advisories/traefik-before-2.11.58-and-3.7.13-mtls-bypass-via-negated-host-matcher"], "aliases": ["CVE-2026-114656", "GHSA-rq4g-2h45-7vgr"], "assigner": "VulnCheck", "epss": 0.16, "enisaIdProduct": [{"id": "62f979ec-d602-3f5a-8298-37b86538d10c", "product": {"name": "traefik", "vendor": {"name": "traefik"}}, "product_version": "0 <2.11.58"}, {"id": "a0936d1a-bcc0-3d46-a98d-8ea2a988784b", "product": {"name": "traefik", "vendor": {"name": "traefik"}}, "product_version": "3.0.0 <3.7.13"}], "enisaIdVendor": [{"id": "fa58cac4-a23b-3639-9160-50ea48543f8c", "vendor": {"name": "traefik"}}], "isExploited": false}