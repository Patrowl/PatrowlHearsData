{"id": "EUVD-2026-78671", "enisaUuid": "0882726b-8333-3cdc-901c-5b0af832382a", "description": "Surfio is a library for reading and writing surface files. Prior to 0.0.19, surfio does not correctly validate size fields in IRAP files, leading to a buffer overflow when untrusted files are parsed. The severity assumes surfio is used to parse untrusted files in a networking context such as a web service. This issue is fixed in version 0.0.19.", "datePublished": "2026-09-15T15:28:59", "dateUpdated": "2026-09-17T15:17:43", "baseScore": 9.8, "baseScoreVersion": "3.0", "baseScoreVector": "CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H", "references": ["https://github.com/equinor/surfio/security/advisories/GHSA-rcr2-hggw-43wm", "https://github.com/equinor/surfio/pull/86", "https://github.com/equinor/surfio/commit/1619750bce28e39c4f378d2fb6d28b72380a12aa", "https://github.com/equinor/surfio/commit/e009c0cad145484f854aeb22d1979f9216b291db", "https://github.com/equinor/surfio/releases/tag/0.0.19"], "aliases": ["PYSEC-2026-3701", "CVE-2026-55211", "GHSA-rcr2-hggw-43wm"], "assigner": "GitHub_M", "epss": 0.74, "enisaIdProduct": [{"id": "5f4e8b21-43fe-3d8a-886c-1502d0573f59", "product": {"name": "surfio", "vendor": {"name": "equinor"}}, "product_version": "< 0.0.19"}], "enisaIdVendor": [{"id": "6a9dd8e8-11e6-324e-b08c-b00d103e6c65", "vendor": {"name": "equinor"}}], "isExploited": false}