{"id": "EUVD-2026-93464", "enisaUuid": "84676f3e-fe1e-32c5-82cf-d9d8a21b91c2", "description": "Payload is a free and open source headless content management system. In versions before 3.88.0 and canary versions before 4.0.0-canary.27, an untrusted user who can query a readable collection, control its sorting, and select a protected field as the sort parameter can infer limited information about field values the user cannot read. This issue is fixed in versions 3.88.0 and 4.0.0-canary.27.", "datePublished": "2026-10-06T15:25:29", "dateUpdated": "2026-10-06T16:25:35", "baseScore": 6.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/payloadcms/payload/security/advisories/GHSA-9g87-32v6-3c2r", "https://github.com/payloadcms/payload/commit/a742140ab4fca3160f7f83e9e7d996552ffc3b5a", "https://github.com/payloadcms/payload/releases/tag/v3.88.0"], "aliases": ["CVE-2026-105805", "GHSA-9g87-32v6-3c2r"], "assigner": "GitHub_M", "epss": 0.28, "enisaIdProduct": [{"id": "2025cf59-afcf-3b8e-8da8-e371b8fff94e", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "4.0.0-canary.0, < 4.0.0-canary.27"}, {"id": "2bdb418b-c300-345d-840b-408884385bab", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "< 3.88.0"}], "enisaIdVendor": [{"id": "762a913c-f4a3-355e-b817-896cf1c6744b", "vendor": {"name": "payloadcms"}}], "isExploited": false}