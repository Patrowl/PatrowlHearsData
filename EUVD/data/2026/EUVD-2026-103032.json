{"id": "EUVD-2026-103032", "enisaUuid": "d1bc62b5-2db4-3f3c-8523-85c23ec025ea", "description": "B3log Solo through 4.4.0 contains a missing authorization vulnerability in ArticleConsole that allows authenticated authors to access other authors' articles by omitting per-author ownership checks. Attackers can query the console articles status endpoint to list other authors' drafts, probe draft content via the k parameter, and use push2rhy to push others' articles to the Rhythm community.", "datePublished": "2026-10-16T17:38:50", "dateUpdated": "2026-10-19T12:58:25", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:L/VA:N/SC:N/SI:N/SA:N", "references": ["https://hackmd.io/@hieuPenguinnn/solo-article-console-cross-author-authz", "https://github.com/88250/solo/blob/v4.4.0/src/main/java/org/b3log/solo/processor/console/ArticleConsole.java#L87-L92", "https://github.com/88250/solo/blob/v4.4.0/src/main/java/org/b3log/solo/service/ArticleQueryService.java#L485-L519", "https://github.com/88250/solo", "https://www.vulncheck.com/advisories/b3log-solo-through-4.4.0-missing-authorization-in-articleconsole"], "aliases": ["CVE-2026-111610", "GHSA-m368-x5fj-4332"], "assigner": "VulnCheck", "epss": 0.22, "enisaIdProduct": [{"id": "3f5d9cff-cd28-3373-ab38-75455d04347c", "product": {"name": "Solo", "vendor": {"name": "b3log"}}, "product_version": "0 \u22644.4.0"}], "enisaIdVendor": [{"id": "8de8aaf7-f5c6-3ae8-8480-a63f533c3bff", "vendor": {"name": "b3log"}}], "isExploited": false}