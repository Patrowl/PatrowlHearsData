{"id": "EUVD-2026-72350", "enisaUuid": "7ead186b-fa3b-395c-bb84-1a54ec9e48b2", "description": "The Powerkit plugin for WordPress is vulnerable to Stored Cross-Site Scripting via the Lazy Load module's image processing in all versions up to, and including, 3.0.4. This is due to the 'content_process_images' function using a flawed regex-based HTML attribute parser. This makes it possible for authenticated attackers, with Contributor-level access and above, to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page.", "datePublished": "2026-09-07T11:27:25", "dateUpdated": "2026-09-08T12:58:01", "baseScore": 6.4, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:L/I:L/A:N", "references": ["https://www.wordfence.com/threat-intel/vulnerabilities/id/222241ce-f534-435a-8667-8cc1d527ef95?source=cve", "https://plugins.trac.wordpress.org/browser/powerkit/trunk/modules/lazyload/public/class-powerkit-lazyload-public.php#L199", "https://plugins.trac.wordpress.org/browser/powerkit/trunk/modules/lazyload/public/class-powerkit-lazyload-public.php#L227", "https://plugins.trac.wordpress.org/browser/powerkit/trunk/modules/lazyload/public/class-powerkit-lazyload-public.php#L49", "https://plugins.trac.wordpress.org/changeset/3604146"], "aliases": ["GHSA-fx5h-8r8x-3xc8", "CVE-2026-2390"], "assigner": "Wordfence", "epss": 0.19, "enisaIdProduct": [{"id": "58d636ed-4ab6-39c6-a878-30a9fd5de2ae", "product": {"name": "Powerkit \u2013 Supercharge your WordPress Site", "vendor": {"name": "codesupplyco"}}, "product_version": "0 \u22643.0.4"}], "enisaIdVendor": [{"id": "0e1445c7-eba4-36eb-8561-eae1c840ee8d", "vendor": {"name": "codesupplyco"}}], "isExploited": false}