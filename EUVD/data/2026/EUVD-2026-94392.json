{"id": "EUVD-2026-94392", "enisaUuid": "0cfaf46c-7803-34f2-8cef-306154db502b", "description": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-31 and 6.9.13-56, a missing limit check in the MVG decoder allows a crafted MVG image to trigger an excessively long-running operation. This issue is fixed in versions 7.1.2-31 and 6.9.13-56.", "datePublished": "2026-10-07T15:34:25", "dateUpdated": "2026-10-10T02:31:18", "baseScore": 5.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L", "references": ["https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-qr53-hc3p-fc62", "https://github.com/ImageMagick/ImageMagick/commit/c311471c4e4978494834c707b417bc033d95cc48", "https://github.com/ImageMagick/ImageMagick6/commit/49560a1641f72a127e413b9861eca0997fde2b96", "https://github.com/ImageMagick/ImageMagick/releases/tag/7.1.2-31", "https://github.com/ImageMagick/ImageMagick6/releases/tag/6.9.13-56"], "aliases": ["CVE-2026-106573"], "assigner": "GitHub_M", "epss": 0.44, "enisaIdProduct": [{"id": "84dfb4f3-4adc-3270-9750-c76140f04c37", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "< 6.9.13-56"}, {"id": "a7c703a0-3c1d-309a-8b49-985cfdd28f1a", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "7.0.0, < 7.1.2-31"}], "enisaIdVendor": [{"id": "bc7df0a5-9b2b-3299-ba68-8a3ffb96c18c", "vendor": {"name": "ImageMagick"}}], "isExploited": false}