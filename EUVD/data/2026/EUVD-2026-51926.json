{"id": "EUVD-2026-51926", "enisaUuid": "72ccccb1-72b8-3300-bfbc-b18335d37fee", "description": "Keycloak provides authorization services that allow administrators to restrict access to resources based on time policies (for example, only allowing access during business hours). A flaw was discovered where a user can include a fake time value in their authorization request that overrides the actual server time. This allows the user to bypass these time-based restrictions and access protected resources at unauthorized times.", "datePublished": "2026-08-02T05:18:58", "dateUpdated": "2026-09-16T18:34:41", "baseScore": 6.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:68277", "https://access.redhat.com/errata/RHSA-2026:68278", "https://access.redhat.com/security/cve/CVE-2026-18572", "https://bugzilla.redhat.com/show_bug.cgi?id=2509763"], "aliases": ["CVE-2026-18572", "GHSA-mcjq-c4g7-wcfh"], "assigner": "redhat", "epss": 0.39, "enisaIdProduct": [{"id": "3d01c861-a24c-3639-9dcd-8e7e916906b4", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6-20"}, {"id": "de0e790f-ac17-3692-83ec-50e7bbc2081e", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6.7-3"}], "enisaIdVendor": [{"id": "8365dae1-c202-3ecb-9089-7b3ac80d84ce", "vendor": {"name": "Red Hat"}}], "isExploited": false}