{"id": "EUVD-2026-36639", "enisaUuid": "f07050a4-a61f-3ddc-ad0e-1f1ae1eccb95", "description": "A symlink following vulnerability was found in the ABRT post-create event handler scripts in libreport. Event scripts write output files using shell redirections without the O_NOFOLLOW flag. If the target file is replaced with a symlink, the shell process running as root follows the symlink and writes content to the symlink target, allowing arbitrary file overwrites on the system.", "datePublished": "2026-06-13T02:34:35", "dateUpdated": "2026-09-21T05:29:38", "baseScore": 7.0, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:54272", "https://access.redhat.com/errata/RHSA-2026:69115", "https://access.redhat.com/errata/RHSA-2026:69116", "https://access.redhat.com/errata/RHSA-2026:69117", "https://access.redhat.com/errata/RHSA-2026:69121", "https://access.redhat.com/security/cve/CVE-2026-54230", "https://bugzilla.redhat.com/show_bug.cgi?id=2488568"], "aliases": ["GHSA-gvjc-4rfj-mxxj", "CVE-2026-54230"], "assigner": "redhat", "epss": 0.23, "enisaIdProduct": [{"id": "00db8586-e4c4-3b50-8c42-dc2b43046b52", "product": {"name": "Red Hat Enterprise Linux 8.6 Advanced Mission Critical Update Support", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:2.10.9-25.el8_6.2"}, {"id": "06719fc1-7296-33fa-9e1d-8234edb1f2e1", "product": {"name": "Red Hat Enterprise Linux 7 Extended Lifecycle Support", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:2.1.11-62.el7_9"}, {"id": "12dc1680-98be-355c-90c5-fecefd8076a7", "product": {"name": "Red Hat Enterprise Linux 8", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:2.10.9-26.el8_10"}, {"id": "2454de54-7e6f-3619-9826-c903de9b4b0b", "product": {"name": "Red Hat Enterprise Linux 8.6 Extended Update Support Long-Life Add-On", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:2.10.9-25.el8_6.2"}, {"id":