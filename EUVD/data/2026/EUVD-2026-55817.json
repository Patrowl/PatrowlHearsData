{"id": "EUVD-2026-55817", "enisaUuid": "63c65b31-3538-3f02-a78a-6c0b7034cb43", "description": "A flaw was found in Feast. An authorization bypass vulnerability exists in the /materialize and /materialize-incremental endpoints. By sending a specially crafted request that omits the feature_views field, an attacker can bypass intended permission checks. This allows an unauthenticated remote attacker, or any authenticated user, to trigger a full re-materialization of all feature views. The consequence is a Denial of Service (DoS) due to data corruption and significant resource consumption across all tenants.", "datePublished": "2026-08-10T20:44:51", "dateUpdated": "2026-10-19T11:10:12", "baseScore": 8.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:N/I:H/A:L", "references": ["https://access.redhat.com/errata/RHSA-2026:53261", "https://access.redhat.com/errata/RHSA-2026:53263", "https://access.redhat.com/errata/RHSA-2026:84734", "https://access.redhat.com/security/cve/CVE-2026-18947", "https://bugzilla.redhat.com/show_bug.cgi?id=2511164"], "aliases": ["CVE-2026-18947", "GHSA-mvxh-8c54-7fwx"], "assigner": "redhat", "epss": 0.59, "enisaIdProduct": [{"id": "00ec4e60-48c2-3415-a0e8-4c74d5d6afaa", "product": {"name": "Red Hat OpenShift AI 2.25", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1786110051"}, {"id": "1880dad8-d400-324c-801a-ecb7383d9ae5", "product": {"name": "Red Hat OpenShift AI 3.4", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1791863220"}, {"id": "342da97d-6a02-342c-b92a-c71cf7d940f9", "product": {"name": "Red Hat OpenShift AI 3.3", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1786110033"}], "enisaIdVendor": [{"id": "f829f9aa-0832-34e7-a37c-8964135c1414", "vendor": {"name": "Red Hat"}}], "isExploited": false}