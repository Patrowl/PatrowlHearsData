{"id": "EUVD-2026-107674", "enisaUuid": "4cb3f212-bc2b-379b-80bd-abd3b2dd0ab0", "description": "GitLab has remediated an issue in GitLab CE/EE affecting all versions from 15.0 before 19.3.6, 19.4 before 19.4.3, and 19.5 before 19.5.1 that, when a merge request in a public project referenced a confidential issue from a private project, an authenticated user with no project membership could have read the confidential issue's title, due to a viewer-independent fragment cache key that incorrectly shared per-user-redacted rendered content across all users.", "datePublished": "2026-10-21T23:34:30", "dateUpdated": "2026-10-21T23:34:30", "baseScore": 3.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:U/C:L/I:N/A:N", "references": ["https://gitlab.com/gitlab-org/gitlab/-/work_items/632207", "https://hackerone.com/reports/3963293", "https://docs.gitlab.com/releases/patches/patch-release-gitlab-19-5-1-released/"], "aliases": ["CVE-2026-105711", "GHSA-5jh8-pw64-jw5v"], "assigner": "GitLab", "epss": 0.21, "enisaIdProduct": [{"id": "12e99080-9e02-320b-bf7a-a48e23e225cf", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "15.0 <19.3.6"}, {"id": "48bab58f-6cc1-3524-9a5b-82eb18f219d4", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.5 <19.5.1"}, {"id": "ad4da867-67c4-36ee-ae73-97285e157648", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.4 <19.4.3"}], "enisaIdVendor": [{"id": "863246e9-1935-39bd-bc6c-e42d7f5799d9", "vendor": {"name": "GitLab"}}], "isExploited": false}