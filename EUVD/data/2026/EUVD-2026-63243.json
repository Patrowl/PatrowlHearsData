{"id": "EUVD-2026-63243", "enisaUuid": "5901b86a-f580-3be7-ae0c-4ef2d3a2176b", "description": "A privilege escalation flaw was found in FreeIPA. The uniqueness constraint enforced on Kerberos principal name attributes in the 389-ds directory server does not properly account for equivalent representations of the same principal name, allowing a user with sufficient LDAP write privileges to create a service principal that impersonates an existing privileged one. This can lead to unauthorized acquisition of Kerberos service tickets for sensitive services, potentially resulting in full domain compromise.", "datePublished": "2026-08-20T10:37:55", "dateUpdated": "2026-10-15T05:07:43", "baseScore": 8.7, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:C/C:H/I:H/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:70564", "https://access.redhat.com/errata/RHSA-2026:72279", "https://access.redhat.com/errata/RHSA-2026:82935", "https://access.redhat.com/errata/RHSA-2026:83083", "https://access.redhat.com/errata/RHSA-2026:83084", "https://access.redhat.com/errata/RHSA-2026:83085", "https://access.redhat.com/errata/RHSA-2026:83460", "https://access.redhat.com/errata/RHSA-2026:83461", "https://access.redhat.com/security/cve/CVE-2026-13097", "https://bugzilla.redhat.com/show_bug.cgi?id=2515974"], "aliases": ["GHSA-q4ph-46qc-4w6x", "CVE-2026-13097"], "assigner": "redhat", "epss": 0.57, "enisaIdProduct": [{"id": "0526c728-29e2-3b92-961f-5f7fe2ab143c", "product": {"name": "Red Hat Enterprise Linux 8", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 8100020261007071200.143e9e98"}, {"id": "1945a3fa-5701-3fd9-9687-a3b8dc69506c", "product": {"name": "Red Hat Enterprise Linux 10.0 Extended Update Support", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:4.12.2-15.el10_0.7"}, {"id": "32077d11-b6fd-350d-99d3-5965ec8a6b4e", "product": {"name": "Red Hat Enterprise Linux 9.6 Extended Update Support", "vendor": {"name": "Red Hat"}}