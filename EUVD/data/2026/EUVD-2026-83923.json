{"id": "EUVD-2026-83923", "enisaUuid": "5cbf6631-664a-36e3-8403-542560f1f455", "description": "A stack-based buffer overflow flaw was found in fetchmail when built with NTLM support. A malicious or compromised mail server advertising NTLM authentication can send a crafted Type 2 challenge that causes fetchmail to write past a fixed stack buffer while building the NTLM authenticate response. This may lead to remote code execution depending on stack-frame layout, or to authentication failure or process termination under memory hardening.", "datePublished": "2026-09-21T14:17:16", "dateUpdated": "2026-10-21T14:01:53", "baseScore": 8.1, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:85959", "https://access.redhat.com/errata/RHSA-2026:86981", "https://access.redhat.com/errata/RHSA-2026:86982", "https://access.redhat.com/security/cve/CVE-2026-94184", "https://bugzilla.redhat.com/show_bug.cgi?id=2531984", "https://bugzilla.redhat.com/show_bug.cgi?id=2537395", "https://gitlab.com/fetchmail/fetchmail/-/commit/cb5be5c38471eec19e519ace0bc569176317ea92", "https://www.fetchmail.info/fetchmail-SA-2026-01.txt", "https://www.openwall.com/lists/oss-security/2026/06/27/8"], "aliases": ["CVE-2026-94184", "GHSA-5pfw-5pv2-2pc6"], "assigner": "redhat", "epss": 0.95, "enisaIdProduct": [{"id": "1959cc0a-58c0-3cc3-96ca-ae9a90c4b2a5", "product": {"name": "Red Hat Enterprise Linux 8", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:6.4.24-1.el8_10.1"}, {"id": "58a989c3-8689-389f-b04f-05fc62599caa", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:6.4.24-1.el9_8.1"}, {"id": "5b50bb5a-35d7-3bff-9c3b-736987d4a069", "product": {"name": "Red Hat Enterprise Linux 10", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:6.4.38-3.el10_2.1"}], "enisaIdVendor": [{"id": "8dcc863c-f660-3d76-b1d3-3f528eae53ba", "vendor"