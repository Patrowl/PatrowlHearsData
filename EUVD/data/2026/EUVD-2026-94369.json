{"id": "EUVD-2026-94369", "enisaUuid": "e6501d2f-82b1-330f-9b14-1a0bdce6c5bb", "description": "Backstage is an open framework for building developer portals. Prior to 1.14.6, the @backstage/plugin-techdocs-node package is affected by remote code execution via crafted markdown_extensions in techdocs mkdocs.yml. An authenticated user who can register catalog entities can provide a crafted mkdocs.yml causing arbitrary OS command execution on the TechDocs build host when the docs are built. This issue is fixed in versions 1.14.6 and 1.15.4.", "datePublished": "2026-10-07T14:36:53", "dateUpdated": "2026-10-07T17:15:43", "baseScore": 7.7, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:C/C:H/I:L/A:L", "references": ["https://github.com/backstage/backstage/security/advisories/GHSA-4488-j8vj-vqqv", "https://github.com/backstage/backstage/commit/02cd7cdbb18b687446277b5602adaee7f1d53cbb", "https://github.com/backstage/backstage/commit/a900a9953c8f7ad3ba1906d1d257725a9996cc9d", "https://github.com/backstage/backstage/releases/tag/v1.50.5", "https://github.com/backstage/backstage/releases/tag/v1.54.6"], "aliases": ["CVE-2026-106510", "GHSA-4488-j8vj-vqqv"], "assigner": "GitHub_M", "epss": 0.45, "enisaIdProduct": [{"id": "47907b7e-ea0c-3f1c-89cb-4b2092eacc40", "product": {"name": "backstage", "vendor": {"name": "backstage"}}, "product_version": "< 1.50.5"}, {"id": "7fe542de-b633-355c-a21e-a6c9df2fa48f", "product": {"name": "plugin-techdocs-node", "vendor": {"name": "@backstage"}}, "product_version": "1.15.0, < 1.15.4"}, {"id": "8a00f1b9-d6f7-30d4-a13b-1cb1839e72dd", "product": {"name": "plugin-techdocs-node", "vendor": {"name": "@backstage"}}, "product_version": "< 1.14.6"}, {"id": "ce96b63d-e3be-3138-bbbf-c59473e0218b", "product": {"name": "backstage", "vendor": {"name": "backstage"}}, "product_version": "1.51.0-next.0, < 1.54.6"}], "enisaIdVendor": [{"id": "2e27255d-1caf-3716-b62d-09634a6aa10a", "vendor": {"name": "backstage"}}, {"id": "d66fff5c-6