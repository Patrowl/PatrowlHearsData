{"id": "EUVD-2026-101867", "enisaUuid": "0473b9db-5a8c-3ec6-9c3a-11015de3ace0", "description": "SCM_RIGHTS file descriptor passing did not preserve FD_RESOLVE_BENEATH when a descriptor was transferred.  A process could clear the restriction by sending the descriptor to itself over a Unix domain socket.\n\nA process in a jail that has received a directory file descriptor from another jail can use these techniques to escape the jail's filesystem root restriction.", "datePublished": "2026-10-15T06:46:25", "dateUpdated": "2026-10-16T18:33:15", "baseScore": 9.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H", "references": ["https://security.freebsd.org/advisories/FreeBSD-SA-26:66.jail.asc"], "aliases": ["CVE-2026-101306", "GHSA-3c4j-rmc7-2x5m"], "assigner": "freebsd", "epss": 0.27, "enisaIdProduct": [{"id": "507d838b-0757-3096-a082-5dcef4df06a8", "product": {"name": "FreeBSD", "vendor": {"name": "FreeBSD"}}, "product_version": "15.1-RELEASE <p4"}, {"id": "d03e0598-7a2a-32cd-b9d3-c55cbfb2011b", "product": {"name": "FreeBSD", "vendor": {"name": "FreeBSD"}}, "product_version": "15.0-RELEASE <p14"}, {"id": "d0f48de0-34b2-3938-a7d4-9d7ef56bb78b", "product": {"name": "FreeBSD", "vendor": {"name": "FreeBSD"}}, "product_version": "14.5-RELEASE <p1"}, {"id": "e034ffd8-f1f7-36c2-888d-3b7706851a55", "product": {"name": "FreeBSD", "vendor": {"name": "FreeBSD"}}, "product_version": "14.4-RELEASE <p10"}], "enisaIdVendor": [{"id": "b6fbc487-eec3-3834-aec0-08913a026858", "vendor": {"name": "FreeBSD"}}], "isExploited": false}