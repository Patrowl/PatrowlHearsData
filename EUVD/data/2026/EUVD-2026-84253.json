{"id": "EUVD-2026-84253", "enisaUuid": "778e3dd1-9350-3a77-8210-7742e77c2623", "description": "SAP Fiori Launchpad does not sufficiently validate certain user-controlled input. An unauthenticated attacker could craft a malicious link that, when clicked by an authenticated user, causes the browser to load attacker-controlled content from an external location. This could be used to exfiltrate sensitive information from the victim's session, resulting in a high impact on confidentiality. There is no impact on integrity and availability.", "datePublished": "2026-09-22T00:28:40", "dateUpdated": "2026-09-22T10:25:33", "baseScore": 5.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:H/I:N/A:N", "references": ["https://me.sap.com/notes/3680888", "https://url.sap/sapsecuritypatchday"], "aliases": ["CVE-2026-76974", "GHSA-454c-c45p-5rr9"], "assigner": "sap", "epss": 0.35, "enisaIdProduct": [{"id": "4f81ead7-3cd4-3ab4-beed-c9fcc2e4b3fb", "product": {"name": "SAP Fiori Launchpad", "vendor": {"name": "SAP_SE"}}, "product_version": "SAP_UI 757"}, {"id": "5e05d999-e21e-3993-88bf-dcf00b790bd2", "product": {"name": "SAP Fiori Launchpad", "vendor": {"name": "SAP_SE"}}, "product_version": "816"}, {"id": "777d58a4-d927-36ea-9ec8-3de55f261c83", "product": {"name": "SAP Fiori Launchpad", "vendor": {"name": "SAP_SE"}}, "product_version": "SAP_BASIS 918"}, {"id": "b0c0361d-a4f0-37e2-a13b-0fbbcec53efb", "product": {"name": "SAP Fiori Launchpad", "vendor": {"name": "SAP_SE"}}, "product_version": "758"}], "enisaIdVendor": [{"id": "c1ceaa23-7bf1-342b-b3b4-43f2a9880364", "vendor": {"name": "SAP_SE"}}], "isExploited": false}