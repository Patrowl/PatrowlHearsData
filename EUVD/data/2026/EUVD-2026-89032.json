{"id": "EUVD-2026-89032", "enisaUuid": "ff28185e-692f-3019-8e77-5e225f8a72ba", "description": "A flaw was found in libsoup. When reassembling fragmented WebSocket messages into a GByteArray, libsoup did not adequately cap total message size against the limits of the underlying buffer type. A remote peer could send fragments that caused size truncation while the implementation still used the full length, leading to heap corruption or a crash.", "datePublished": "2026-09-29T16:11:57", "dateUpdated": "2026-10-19T04:14:35", "baseScore": 8.6, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:83384", "https://access.redhat.com/errata/RHSA-2026:83618", "https://access.redhat.com/errata/RHSA-2026:84586", "https://access.redhat.com/security/cve/CVE-2026-102557", "https://bugzilla.redhat.com/show_bug.cgi?id=2543231"], "aliases": ["GHSA-fc8r-xmg7-v58h", "CVE-2026-102557"], "assigner": "redhat", "epss": 0.27, "enisaIdProduct": [{"id": "2040f038-1c98-30df-aaee-25dae8cfe9d2", "product": {"name": "Red Hat Enterprise Linux 10", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:3.6.5-3.el10_2.20"}, {"id": "92af6e73-d033-3737-82b5-518e5708d4fa", "product": {"name": "Red Hat Enterprise Linux 8", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:2.62.3-19.el8_10"}, {"id": "d016fd93-0b2f-3752-80a0-db662ed229c4", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:2.72.0-16.el9_8.8"}], "enisaIdVendor": [{"id": "97cc6d02-f455-39be-968d-369955e8874f", "vendor": {"name": "Red Hat"}}], "isExploited": false}