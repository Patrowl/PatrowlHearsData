{"id": "EUVD-2026-97566", "enisaUuid": "c3d20c55-fd7e-3390-8111-73173ac4800e", "description": "Progress MarkLogic Server 12.x releases before 12.1.0 and 11.x releases before 11.3.7 assign overly permissive operating-system permissions to certain log files, which could allow a local user to read or alter log data. The corrected default permissions apply to newly created and rotated logs; existing logs retain their current permissions until remediated.", "datePublished": "2026-10-12T16:40:22", "dateUpdated": "2026-10-14T10:51:06", "baseScore": 7.1, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:N", "references": ["https://community.progress.com/s/article/Marklogic-Critical-Security-Alert-Bulletin-October-2026"], "aliases": ["GHSA-f3gc-h5jh-3g69", "CVE-2026-85971"], "assigner": "ProgressSoftware", "epss": 0.1, "enisaIdProduct": [{"id": "56f5725a-bcbf-3807-8d73-e0676021ee65", "product": {"name": "MarkLogic Server", "vendor": {"name": "Progress Software Corporation"}}, "product_version": "11.0.0 <11.3.7"}, {"id": "9a060b27-26b9-3eae-995e-b1e3d8170ed8", "product": {"name": "MarkLogic Server", "vendor": {"name": "Progress Software Corporation"}}, "product_version": "12.0.0 <12.1.0"}], "enisaIdVendor": [{"id": "0e959094-fa43-3b7c-95a3-ec1cb4d8e645", "vendor": {"name": "Progress Software Corporation"}}], "isExploited": false}