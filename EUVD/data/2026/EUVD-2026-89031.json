{"id": "EUVD-2026-89031", "enisaUuid": "738f3275-b1ff-3d30-9a44-9e51ff713f11", "description": "A flaw was found in libsoup. When handling an incoming WebSocket Pong frame, SoupWebsocketConnection emitted the ::pong signal with a GByteArray pointer even though the signal is declared to pass a GBytes. Applications connecting a handler that follows the documented GBytes API can trigger heap corruption or a crash upon receiving a crafted Pong.", "datePublished": "2026-09-29T16:11:50", "dateUpdated": "2026-10-19T04:14:35", "baseScore": 8.6, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:83384", "https://access.redhat.com/errata/RHSA-2026:83618", "https://access.redhat.com/errata/RHSA-2026:84586", "https://access.redhat.com/security/cve/CVE-2026-102556", "https://bugzilla.redhat.com/show_bug.cgi?id=2543229"], "aliases": ["CVE-2026-102556", "GHSA-q4x2-vf8m-46j5"], "assigner": "redhat", "epss": 0.27, "enisaIdProduct": [{"id": "374afe28-d01c-3016-9972-30919d338466", "product": {"name": "Red Hat Enterprise Linux 8", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:2.62.3-19.el8_10"}, {"id": "b4b71f84-8659-3d1e-9580-f8d23b00b3ea", "product": {"name": "Red Hat Enterprise Linux 10", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:3.6.5-3.el10_2.20"}, {"id": "e5309ca4-2928-3248-8a18-212e874b1c06", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:2.72.0-16.el9_8.8"}], "enisaIdVendor": [{"id": "c29e5a29-2f59-30a2-a2f9-78cf254b8374", "vendor": {"name": "Red Hat"}}], "isExploited": false}