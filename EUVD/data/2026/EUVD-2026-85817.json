{"id": "EUVD-2026-85817", "enisaUuid": "bef173ce-8d1a-398f-8da6-bc2215315355", "description": "A flaw was found in GIMP. When processing a specially crafted GIMPressionist preset file, the plug-in does not properly validate vector indices before writing into fixed-size arrays. This can lead to an out-of-bounds write, corrupting memory. An attacker could exploit this by convincing a user to load a malicious preset file, potentially causing a crash or enabling arbitrary code execution.", "datePublished": "2026-09-24T08:30:29", "dateUpdated": "2026-10-19T12:20:03", "baseScore": 7.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:75575", "https://access.redhat.com/errata/RHSA-2026:84744", "https://access.redhat.com/security/cve/CVE-2026-97185", "https://bugzilla.redhat.com/show_bug.cgi?id=2539980", "https://gitlab.gnome.org/GNOME/gimp/-/work_items/16788"], "aliases": ["GHSA-wp8m-4297-94hv", "CVE-2026-97185"], "assigner": "redhat", "epss": 0.14, "enisaIdProduct": [{"id": "9e1ebd32-ff9a-3b76-b824-926df42370cd", "product": {"name": "Red Hat Enterprise Linux 8", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 8100020261015094823.4c9c024f"}, {"id": "bae91c7c-695d-3b8f-b598-eef5a046f578", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 2:3.0.4-4.el9_8.14"}], "enisaIdVendor": [{"id": "52791f57-32a0-341f-95b2-9c92e3b4bdd9", "vendor": {"name": "Red Hat"}}], "isExploited": false}