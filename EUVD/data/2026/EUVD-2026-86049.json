"}}, "product_version": "patch: 6.12.111"}, {"id": "fef9cbee-0261-3888-ae3a-22e5f4482e57", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "539dda3c5d190c5088b5e57944b1b482fcb464de <abea361a11e4e48695ea149652ef5d3f308b6a49"}], "enisaIdVendor": [{"id": "6561e328-72f6-3692-970d-07daf99f0d53", "vendor": {"name": "Linux"}}], "isExploited": false}