{"id": "EUVD-2026-72718", "enisaUuid": "5f79af2a-abab-3a67-b0b7-8dfbda7c9d07", "description": "A client may issue specially crafted HTTP/1.1 chunked requests to a Jetty server that cause Jetty and an intermediary proxy to interpret different request boundaries, potentially resulting in HTTP request smuggling.\n\n\n\n\nThis is caused by Jetty accepting a lone LF character as a terminator in parts of chunked request parsing. Depending on the Jetty version and configured HTTP compliance mode, this may occur in chunk extensions, chunk data termination, or trailer termination.", "datePublished": "2026-09-08T12:08:37", "dateUpdated": "2026-09-08T14:21:55", "baseScore": 8.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:L/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/jetty/jetty.project/security/advisories/GHSA-xc35-c22g-239h"], "aliases": ["GHSA-p2j5-5566-vpv9", "CVE-2026-19203"], "assigner": "eclipse", "epss": 0.31, "enisaIdProduct": [{"id": "1cfb1ada-68f3-3b44-a344-6dc529a24364", "product": {"name": "Eclipse Jetty", "vendor": {"name": "Eclipse Foundation"}}, "product_version": "11.0.0 \u226411.0.31"}, {"id": "1f9f77b5-d108-3d28-bd49-a7e37171e1cc", "product": {"name": "Eclipse Jetty", "vendor": {"name": "Eclipse Foundation"}}, "product_version": "12.0.0 \u226412.0.37"}, {"id": "8d9f1729-e9f8-318d-b341-f7e8011c4f14", "product": {"name": "Eclipse Jetty", "vendor": {"name": "Eclipse Foundation"}}, "product_version": "12.1.0 \u226412.1.11"}, {"id": "9c7b186e-ef15-398b-899a-a2282a478bea", "product": {"name": "Eclipse Jetty", "vendor": {"name": "Eclipse Foundation"}}, "product_version": "9.4.0 \u22649.4.63"}, {"id": "fafea66b-5110-38a8-ba56-4eebdf266e6c", "product": {"name": "Eclipse Jetty", "vendor": {"name": "Eclipse Foundation"}}, "product_version": "10.0.0 \u226410.0.31"}], "enisaIdVendor": [{"id": "2f1eb6c7-76d1-3919-bbef-8d5c63793f10", "vendor": {"name": "Eclipse Foundation"}}], "isExploited": false}