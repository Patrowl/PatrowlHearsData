{"id": "EUVD-2026-108264", "enisaUuid": "3485a7f5-84bf-3f0f-9673-2286ae822b21", "description": "PhpSpreadsheet is a pure PHP library for reading and writing spreadsheet files. Prior to 1.30.7, 2.1.19, 2.4.8, 3.10.8, and 5.10.0, Worksheet\\Drawing::setPath validates only the initial external-image URL with setIsWhitelisted when setAllowExternalImages is enabled. The HTTP stream context permits PHP to follow a redirect without applying the callback to the redirected URL, so a permitted image host can redirect the server to an internal address and cause a blind GET request. The response body is not returned to the attacker because the reader validates the downloaded content as an image and removes the temporary file, but internal GET-driven endpoints, network reachability, and cloud metadata endpoints may be reached. This issue is fixed in versions 1.30.7, 2.1.19, 2.4.8, 3.10.8, and 5.10.0.", "datePublished": "2026-10-22T17:26:59", "dateUpdated": "2026-10-22T17:26:59", "baseScore": 6.4, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:L/I:L/A:N", "references": ["https://github.com/PHPOffice/PhpSpreadsheet/security/advisories/GHSA-2phh-27fw-q4gc", "https://github.com/PHPOffice/PhpSpreadsheet/commit/299993894dce37aa3b64aa23e9a3f4bb77ab0e66", "https://github.com/PHPOffice/PhpSpreadsheet/commit/94590951d76a250a5fc1ecf69a0b3f7439a9af49", "https://github.com/PHPOffice/PhpSpreadsheet/commit/980b5c294493856f1a25754f1e8a1d2185b93738", "https://github.com/PHPOffice/PhpSpreadsheet/commit/9a0b48622ebfe93fa48cb9bc09ce57303bb07af9", "https://github.com/PHPOffice/PhpSpreadsheet/commit/da13f40e8760d599b0e8a296017d4b028b20e86c", "https://github.com/PHPOffice/PhpSpreadsheet/releases/tag/1.30.7", "https://github.com/PHPOffice/PhpSpreadsheet/releases/tag/2.1.19", "https://github.com/PHPOffice/PhpSpreadsheet/releases/tag/2.4.8", "https://github.com/PHPOffice/PhpSpreadsheet/releases/tag/3.10.8", "https://github.com/PHPOffice/PhpSpreadsheet/releases/tag/5.10.0"], "aliases": ["CVE-2026-108360"], "assigner": "GitHub_M", "epss": 0.0, "enisaIdProduct": [{"id": "0a02661c-8fc9-394d-8b29-8ba8c2990db8", "product": {"name": "PhpSpreadsheet", "vendor": {"name": "PHPOffice"}}, "product_version": "3.3.0, < 3.10.8"}, {"id": "156a06ba-b6ae-39ca-b593-5cc863bc75b1", "product": {"name": "PhpSpreadsheet", "vendor": {"name": "PHPOffice"}}, "product_version": "2.0.0, < 2.1.19"}, {"id": "714d38ec-7e86-341d-95a2-bce35363566a", "product": {"name": "PhpSpreadsheet", "vendor": {"name": "PHPOffice"}}, "product_version": "2.2.0, < 2.4.8"}, {"id": "812f76dd-b51d-3010-9f5a-e0253b4acdbb", "product": {"name": "PhpSpreadsheet", "vendor": {"name": "PHPOffice"}}, "product_version": "< 1.30.7"}, {"id": "ebda7eb7-e9b0-3dff-9e5d-56825e084ca7", "product": {"name": "PhpSpreadsheet", "vendor": {"name": "PHPOffice"}}, "product_version": "4.0.0, < 5.10.0"}], "enisaIdVendor": [{"id": "a699f02d-95fe-3788-b000-2ab6d661d3c6", "vendor": {"name": "PHPOffice"}}], "isExploited": false}