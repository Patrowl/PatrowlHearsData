{"id": "EUVD-2026-81679", "enisaUuid": "727dd747-5ccb-35a1-80c2-34d2634f137f", "description": "A flaw was found in libxml2. A local user or an attacker providing a specially crafted XML catalog can trigger a NULL pointer dereference during XML catalog parsing. This occurs when a `nextCatalog` element lacks its mandatory `catalog` attribute, leading to the application crashing and causing a Denial of Service (DoS).", "datePublished": "2026-09-17T15:11:29", "dateUpdated": "2026-09-24T11:57:00", "baseScore": 5.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:57604", "https://access.redhat.com/security/cve/CVE-2026-76781", "https://bugzilla.redhat.com/show_bug.cgi?id=2519776", "https://gitlab.gnome.org/GNOME/libxml2/-/commit/c6324894", "https://gitlab.gnome.org/GNOME/libxml2/-/merge_requests/442"], "aliases": ["CVE-2026-76781", "GHSA-2j5r-8qjf-mq34"], "assigner": "redhat", "epss": 0.17, "enisaIdProduct": [{"id": "c8a511b8-2c05-31eb-861f-d898ed29f51d", "product": {"name": "Red Hat Hardened Images", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 2.15.3-0.1.3.hum1"}], "enisaIdVendor": [{"id": "d7cb7ccd-fb00-3b53-9136-1e46e4b51edb", "vendor": {"name": "Red Hat"}}], "isExploited": false}