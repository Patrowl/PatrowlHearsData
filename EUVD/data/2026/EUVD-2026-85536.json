{"id": "EUVD-2026-85536", "enisaUuid": "115c6f32-7308-30c9-bd66-19aa91902333", "description": "StringListPathField.to_internal_value() calls\n              os.path.exists() on unbounded user-supplied paths.\n              200 vs 400 response reveals existence of arbitrary\n              absolute paths on the controller-web pod. Tenant\n              superuser can confirm /etc/tower/SECRET_KEY, k8s\n              service-account token, receptor sockets, ConfigMap\n              mount points. Mainly impactful on managed AAP\n              (ansiblecloud.com) where tenant admin != host admin.", "datePublished": "2026-09-23T18:25:22", "dateUpdated": "2026-10-16T11:54:13", "baseScore": 4.1, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:C/C:L/I:N/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:71113", "https://access.redhat.com/errata/RHSA-2026:71114", "https://access.redhat.com/errata/RHSA-2026:71177", "https://access.redhat.com/errata/RHSA-2026:71179", "https://access.redhat.com/security/cve/CVE-2026-71462", "https://bugzilla.redhat.com/show_bug.cgi?id=2512371"], "aliases": ["GHSA-8936-fch2-2279", "CVE-2026-71462"], "assigner": "redhat", "epss": 0.26, "enisaIdProduct": [{"id": "32b477c7-109f-33a5-bb84-b03c44bd1494", "product": {"name": "Red Hat Ansible Automation Platform 2.5 for RHEL 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:4.6.33-1.el9ap"}, {"id": "3ccc1a3c-a99a-3a4e-a4b6-423e8aadad79", "product": {"name": "Red Hat Ansible Automation Platform 2.5 for RHEL 8", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:4.6.33-1.el8ap"}, {"id": "5d91ee2e-e258-384b-bc43-974d9fec1f41", "product": {"name": "Red Hat Ansible Automation Platform 2.7", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1789580684"}, {"id": "7bd716b7-76c7-3c32-857e-34631cf970ae", "product": {"name": "Red Hat Ansible Automation Platform 2.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1789673739"}, {