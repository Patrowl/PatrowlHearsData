{"id": "EUVD-2026-107549", "enisaUuid": "328e4378-fdef-33e7-a56e-01c5fbbaadf9", "description": "Sentry-Javascript is an official Sentry SDKs for JavaScript. From 9.36.0 until 9.47.2, 10.75.2, and 11.0.0-rc.1, the webpack integration for @sentry/nextjs skips application middleware for every request path under a configured tunnelRoute, while the tunnel rewrite serves only the exact tunnel path with valid o and p query parameters. When an application route directly collides with the tunnel path or a root dynamic segment resolves under it, an unauthenticated request can reach that route without middleware authorization. Exploitation requires tunnelRoute, a webpack build, a colliding route, and middleware being the only authorization control. This issue is fixed in versions 9.47.2, 10.75.2, and 11.0.0-rc.1.", "datePublished": "2026-10-21T20:14:34", "dateUpdated": "2026-10-21T20:14:34", "baseScore": 9.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/getsentry/sentry-javascript/security/advisories/GHSA-mchm-gjx6-7h55", "https://github.com/getsentry/sentry-javascript/pull/24499", "https://github.com/getsentry/sentry-javascript/pull/24565", "https://github.com/getsentry/sentry-javascript/pull/24760", "https://github.com/getsentry/sentry-javascript/commit/878b685c85dc12045e47e1932c96f5381d7ac532", "https://github.com/getsentry/sentry-javascript/commit/c122aac4f29541eb6da494296822c91eab3cf5ae", "https://github.com/getsentry/sentry-javascript/commit/d525a2f6015b47384bc139c30d58e0d5435d52e5", "https://github.com/getsentry/sentry-javascript/releases/tag/10.75.2", "https://github.com/getsentry/sentry-javascript/releases/tag/11.0.0-rc.1", "https://github.com/getsentry/sentry-javascript/releases/tag/9.47.2"], "aliases": ["CVE-2026-114139", "GHSA-mchm-gjx6-7h55"], "assigner": "GitHub_M", "epss": 0.41, "enisaIdProduct": [{"id": "140af2d4-6191-3299-b623-daaccf854d09", "product": {"name": "sentry-javascript", "vendor": {"name": "getsentry"}}, "product_version": "10.0.0-alpha.0, < 10.75.2"}, {"id": "93b4e1d2-8280-313a-b109-659670da2fa5", "product": {"name": "sentry-javascript", "vendor": {"name": "getsentry"}}, "product_version": "11.0.0-alpha.0, < 11.0.0-rc.1"}, {"id": "b5f874dc-fdc3-347e-9a99-8ac73b05dd8e", "product": {"name": "sentry-javascript", "vendor": {"name": "getsentry"}}, "product_version": "9.36.0, < 9.47.2"}], "enisaIdVendor": [{"id": "b03a772f-976e-36ea-8078-498131623d25", "vendor": {"name": "getsentry"}}], "isExploited": false}