{"id": "EUVD-2026-106894", "enisaUuid": "e4ab2548-a41e-3f21-b2bc-2bc13874a358", "description": "Trigger.dev before 4.5.0 looks up runs by friendlyId alone in the api.v1.runs.$runParam.replay route without scoping the lookup to the caller's runtime environment. An attacker holding any tenant's API key who knows a victim's run friendlyId can replay that run into their own environment and read the victim's task payload.", "datePublished": "2026-10-21T00:36:56", "dateUpdated": "2026-10-21T00:36:56", "baseScore": 6.0, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/triggerdotdev/trigger.dev/security/advisories/GHSA-9fq3-68cw-r7p2", "https://www.vulncheck.com/advisories/trigger-dev-before-4.5.0-cross-tenant-run-payload-disclosure-via-api-replay-route"], "aliases": ["CVE-2026-114091", "GHSA-633q-685h-8gxm"], "assigner": "VulnCheck", "epss": 0.23, "enisaIdProduct": [{"id": "8e744fdd-968d-3d4f-bd14-6b7509b8cc28", "product": {"name": "trigger.dev", "vendor": {"name": "triggerdotdev"}}, "product_version": "0 <4.5.0"}], "enisaIdVendor": [{"id": "96afb47e-13aa-31f9-866b-ddbb6f5a634c", "vendor": {"name": "triggerdotdev"}}], "isExploited": false}