{"id": "EUVD-2026-16214", "enisaUuid": "012a091d-c5f0-30d6-8e3e-2c70b5d1c3ea", "description": "A flaw was found in polkit. A local user can exploit this by providing a specially crafted, excessively long input to the `polkit-agent-helper-1` setuid binary via standard input (stdin). This unbounded input can lead to an out-of-memory (OOM) condition, resulting in a Denial of Service (DoS) for the system.", "datePublished": "2026-03-26T14:56:05", "dateUpdated": "2026-09-10T17:23:21", "baseScore": 5.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:59997", "https://access.redhat.com/errata/RHSA-2026:66287", "https://access.redhat.com/security/cve/CVE-2026-4897", "https://bugzilla.redhat.com/show_bug.cgi?id=2451739"], "aliases": ["CVE-2026-4897"], "assigner": "redhat", "epss": 0.15, "enisaIdProduct": [{"id": "626ef502-5072-39b1-a00c-339f053a310c", "product": {"name": "Red Hat Enterprise Linux 10", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:125-4.el10_2.1"}, {"id": "f7ac3ecf-9f20-3503-9321-ac2e707ed969", "product": {"name": "Red Hat Hardened Images", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 127-5.1.hum1"}], "enisaIdVendor": [{"id": "a41b50b4-b33a-3eec-88f7-57545c11ffad", "vendor": {"name": "Red Hat"}}], "isExploited": false}