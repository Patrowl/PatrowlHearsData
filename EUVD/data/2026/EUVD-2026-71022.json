{"id": "EUVD-2026-71022", "enisaUuid": "9dcb2ca4-a4f5-3bf0-9946-64e7ce18fd54", "description": "Grav Shortcode Core before 6.2.5 contains stored cross-site scripting vulnerabilities in the [lorem] tag parameter and [details] summary parameter that are written to rendered pages without escaping. Attackers with page-edit access can inject arbitrary HTML and JavaScript that executes in the browsers of all page visitors, including administrators.", "datePublished": "2026-09-04T11:30:02", "dateUpdated": "2026-09-08T16:24:58", "baseScore": 5.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:P/VC:N/VI:N/VA:N/SC:L/SI:L/SA:N", "references": ["https://github.com/getgrav/grav/security/advisories/GHSA-hvm8-wx3f-j774", "https://www.vulncheck.com/advisories/grav-shortcode-core-before-6.2.5-stored-xss-via-unescaped-parameters"], "aliases": ["CVE-2026-85599", "GHSA-5xgg-wmqq-qr2g"], "assigner": "VulnCheck", "epss": 0.26, "enisaIdProduct": [{"id": "5f7796bd-71f6-3f26-b5d2-115bb121d32b", "product": {"name": "grav-plugin-shortcode-core", "vendor": {"name": "getgrav"}}, "product_version": "0 <6.2.5"}], "enisaIdVendor": [{"id": "4919abb3-81f9-3ffe-9c5d-acc0f120f131", "vendor": {"name": "getgrav"}}], "isExploited": false}