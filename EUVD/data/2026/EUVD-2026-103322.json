{"id": "EUVD-2026-103322", "enisaUuid": "91cc71b5-66b6-3d5b-b760-8afd3103ae1c", "description": "phpMyFAQ 4.2.0-alpha before 4.2.0-beta contains an authorization bypass vulnerability that allows category-restricted editors to manage attachments of FAQs outside their categories by supplying arbitrary record IDs. Attackers in medium permission mode can send upload or delete requests with a target record_id or attachment ID to tamper with or remove files on unauthorized FAQs.", "datePublished": "2026-10-17T18:46:19", "dateUpdated": "2026-10-19T21:29:59", "baseScore": 7.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:H/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/thorsten/phpMyFAQ/security/advisories/GHSA-hj8v-cg6r-gg6q", "https://www.vulncheck.com/advisories/phpmyfaq-4.2.0-alpha-before-4.2.0-beta-authorization-bypass-in-attachment-administration-endpoints"], "aliases": ["GHSA-73vr-6p8j-qcx6", "CVE-2026-111897"], "assigner": "VulnCheck", "epss": 0.27, "enisaIdProduct": [{"id": "d0623ab0-9880-3716-a0fb-88cbcbc7c8a5", "product": {"name": "phpMyFAQ", "vendor": {"name": "thorsten"}}, "product_version": "4.2.0-alpha <4.2.0-beta"}], "enisaIdVendor": [{"id": "7d792de5-3cfd-3fbc-ab62-9cd370a367d1", "vendor": {"name": "thorsten"}}], "isExploited": false}