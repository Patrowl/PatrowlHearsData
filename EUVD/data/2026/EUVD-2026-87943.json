{"id": "EUVD-2026-87943", "enisaUuid": "47cdacb8-da81-3e9e-ade5-bd26bf77aff4", "description": "Sylius versions before 1.12.25, 1.13.17, 1.14.20, 2.1.16, and 2.2.9 fail to include firewall identification in JWT tokens issued by separate Admin and Shop API endpoints. Attackers can register a shop customer account using an administrator's email address and obtain a token that the Admin API resolves to that administrator, granting full administrative access.", "datePublished": "2026-09-27T13:09:55", "dateUpdated": "2026-10-06T13:36:51", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/Sylius/Sylius/security/advisories/GHSA-f6mx-qxjc-55xf", "https://github.com/Sylius/Sylius/pull/19213", "https://github.com/Sylius/Sylius/commit/cdfb672a4d174eb2c73159b25cf5b5f44088f45c", "https://github.com/Sylius/Sylius/releases/tag/v2.2.9", "https://github.com/Sylius/Sylius", "https://www.vulncheck.com/advisories/sylius-before-1.12.25-1.13.17-1.14.20-2.1.16-and-2.2.9-jwt-audience-confusion-allows-admin-api-authentication"], "aliases": ["CVE-2026-100871", "GHSA-mxrg-842r-h599"], "assigner": "VulnCheck", "epss": 0.31, "enisaIdProduct": [{"id": "82ec4c6e-55bc-3129-a48f-a3299dc56f56", "product": {"name": "Sylius", "vendor": {"name": "Sylius"}}, "product_version": "1.13.0 <1.13.17"}, {"id": "b3e17430-9946-35be-b464-93cad2fadf01", "product": {"name": "Sylius", "vendor": {"name": "Sylius"}}, "product_version": "2.0.0 <2.1.16"}, {"id": "dea85f6a-418b-3e97-bd93-32fc1d0c6c64", "product": {"name": "Sylius", "vendor": {"name": "Sylius"}}, "product_version": "1.14.0 <1.14.20"}, {"id": "e8a12522-1dbf-3dd9-8b2b-c445831975af", "product": {"name": "Sylius", "vendor": {"name": "Sylius"}}, "product_version": "1.11.0 <1.12.25"}, {"id": "ef11cdf3-396f-3c9f-ab1a-eba6923c42f3", "product": {"name": "Sylius", "vendor": {"name": "Sylius"}}, "product_version": "2.2.0 <2.2.9"}], "enisaIdVendor": [{"i