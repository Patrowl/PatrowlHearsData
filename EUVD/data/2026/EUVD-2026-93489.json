{"id": "EUVD-2026-93489", "enisaUuid": "90b920a7-793f-3ff8-a2ad-c2517f238f08", "description": "Payload is a free and open source headless content management system. In versions from 3.0.0 before 3.90.0 and canary versions before 4.0.0-canary.34, a user who can query a collection with a polymorphic join to sensitive fields can infer hidden or read-restricted values, including password-reset tokens, through polymorphic join filters. This issue is fixed in versions 3.90.0 and 4.0.0-canary.34.", "datePublished": "2026-10-06T16:02:55", "dateUpdated": "2026-10-06T17:22:16", "baseScore": 7.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/payloadcms/payload/security/advisories/GHSA-fpww-c55p-cjv6", "https://github.com/payloadcms/payload/commit/caa3f69b5aecc6e7c2b459ed87972cbca9f33ee5", "https://github.com/payloadcms/payload/releases/tag/v3.90.0"], "aliases": ["CVE-2026-105847", "GHSA-fpww-c55p-cjv6"], "assigner": "GitHub_M", "epss": 0.24, "enisaIdProduct": [{"id": "0fbfe52f-e3dd-3dba-9ba2-0c0aba79257f", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "3.0.0, < 3.90.0"}, {"id": "fb459731-0f10-33c6-8ed0-7569cc934e4f", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "4.0.0-canary.0, < 4.0.0-canary.34"}], "enisaIdVendor": [{"id": "f935d951-69f5-38f0-8a85-fe1002ce61ce", "vendor": {"name": "payloadcms"}}], "isExploited": false}