{"id": "EUVD-2026-93503", "enisaUuid": "3779dcd1-bca1-30eb-a628-a49f46432fe6", "description": "Payload is a free and open source headless content management system. In versions before 3.90.0 and canary versions before 4.0.0-canary.34, an attacker can submit a request to a specific update endpoint that modifies collection documents without enforcing collection or field-level access control when orderable is enabled on a collection or join field. This issue is fixed in versions 3.90.0 and 4.0.0-canary.34.", "datePublished": "2026-10-06T16:31:52", "dateUpdated": "2026-10-06T17:37:22", "baseScore": 9.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H", "references": ["https://github.com/payloadcms/payload/security/advisories/GHSA-f7hx-52q9-hcrf", "https://github.com/payloadcms/payload/commit/36fa9af73dd04fa59f4b4a06d11454538c4c1409", "https://github.com/payloadcms/payload/releases/tag/v3.90.0"], "aliases": ["GHSA-f7hx-52q9-hcrf", "CVE-2026-105859"], "assigner": "GitHub_M", "epss": 0.35, "enisaIdProduct": [{"id": "80303889-15cd-3117-8042-475830fb1b57", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "4.0.0-canary.0, < 4.0.0-canary.34"}, {"id": "aae02855-8790-3e4a-840e-831e190f0e81", "product": {"name": "payload", "vendor": {"name": "payloadcms"}}, "product_version": "< 3.90.0"}], "enisaIdVendor": [{"id": "42d16cf6-7418-31d9-b333-43e5b2b00c03", "vendor": {"name": "payloadcms"}}], "isExploited": false}