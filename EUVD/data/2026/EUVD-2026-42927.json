{"id": "EUVD-2026-42927", "enisaUuid": "8e4d770e-8036-3b3b-827e-0f3ddb75be32", "description": "A flaw was found in the file_type content detector of guardrails-detectors. This vulnerability allows a remote attacker to supply an arbitrary XML Schema Definition (XSD) string, which is processed without proper restrictions. This can lead to server-side requests to arbitrary URLs or local file reads, potentially resulting in sensitive information disclosure, such as cloud provider credentials or access to internal network services.", "datePublished": "2026-07-10T15:25:09", "dateUpdated": "2026-10-22T05:09:01", "baseScore": 9.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:L/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:84734", "https://access.redhat.com/errata/RHSA-2026:87410", "https://access.redhat.com/security/cve/CVE-2026-15143", "https://bugzilla.redhat.com/show_bug.cgi?id=2498165"], "aliases": ["CVE-2026-15143", "GHSA-34cr-c6hf-4xgc"], "assigner": "redhat", "epss": 0.54, "enisaIdProduct": [{"id": "1e5351cf-70d4-3ba2-8abd-46063ac87b8a", "product": {"name": "Red Hat OpenShift AI 2.25", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1791367475"}, {"id": "4d7ff783-cfff-35ca-838f-920e7039e607", "product": {"name": "Red Hat OpenShift AI 3.4", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1791535841"}, {"id": "6dc6cdbb-c785-3ffd-abd6-8eb620ef6b1f", "product": {"name": "Red Hat OpenShift AI 2.25", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1791364320"}, {"id": "f422f85a-45bb-36d3-a9e5-1dc44dc48cbf", "product": {"name": "Red Hat OpenShift AI 3.4", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1791537794"}], "enisaIdVendor": [{"id": "2dcbff6a-9253-353d-b9b8-ae24e869e914", "vendor": {"name": "Red Hat"}}], "isExploited": false}