{"id": "EUVD-2026-83210", "enisaUuid": "1d2f7468-55f3-361b-a480-cae5b0afabd3", "description": "Mongoid does not restrict which query operators may come from caller-supplied filter data when an application hands that data to its query-building methods. In an application that forwards externally supplied filter parameters in this way, a party with no credentials may influence how the database evaluates the query. This may result in unintended disclosure of stored field values and in reduced database performance.", "datePublished": "2026-09-18T17:24:03", "dateUpdated": "2026-09-21T18:14:42", "baseScore": 8.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:H/VI:N/VA:L/SC:N/SI:N/SA:N", "references": ["https://jira.mongodb.org/browse/MONGOID-5994"], "aliases": ["GHSA-mm58-qxpf-v4c7", "CVE-2026-93760"], "assigner": "mongodb", "epss": 0.53, "enisaIdProduct": [{"id": "31a05e0a-1cc2-3795-8029-ee233dfcceb5", "product": {"name": "Mongoid", "vendor": {"name": "MongoDB Inc."}}, "product_version": "8.1.0 \u22648.1.12"}, {"id": "747413e2-923e-3725-a2ed-c271704c262e", "product": {"name": "Mongoid", "vendor": {"name": "MongoDB Inc."}}, "product_version": "9.0.0 \u22649.0.11"}, {"id": "a04d83c5-2917-388a-9254-157ac723f28d", "product": {"name": "Mongoid", "vendor": {"name": "MongoDB Inc."}}, "product_version": "8.0.0 \u22648.0.12"}, {"id": "be2ca55e-c218-3d46-8dd0-294e4cec90d0", "product": {"name": "Mongoid", "vendor": {"name": "MongoDB Inc."}}, "product_version": "9.1.0"}], "enisaIdVendor": [{"id": "239636ed-269a-35a2-b5f0-25873594e2f9", "vendor": {"name": "MongoDB Inc."}}], "isExploited": false}