{"id": "EUVD-2026-105223", "enisaUuid": "43522fa2-73f6-36d7-9974-c28193eb1534", "description": "ApostropheCMS is an open-source Node.js content management system. Prior to 4.33.0 of ApostropheCMS and 3.7.0 of the import-export module, import routes invoke bigUploadMiddleware without an early authorize callback, allowing unauthenticated requests to perform upload initialization, chunk storage, temporary processing, and attacker-declared cleanup work before the later user check rejects the import. This issue is fixed in ApostropheCMS 4.33.0 and import-export 3.7.0.", "datePublished": "2026-10-20T17:49:31", "dateUpdated": "2026-10-20T19:04:07", "baseScore": 7.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://github.com/apostrophecms/apostrophe/security/advisories/GHSA-86wm-68pq-5jwq", "https://github.com/apostrophecms/apostrophe/commit/9500b8b0e1d630d5e07fbb5fd2c25ed0943845ce", "https://github.com/apostrophecms/apostrophe/commit/f84fd41cbf6c22eb8d0008fc9c25df1f7130b350", "https://github.com/apostrophecms/apostrophe/releases/tag/apostrophe@4.33.0"], "aliases": ["GHSA-86wm-68pq-5jwq", "CVE-2026-113711"], "assigner": "GitHub_M", "epss": 0.53, "enisaIdProduct": [{"id": "4847240b-9763-3f40-9e3d-e7863c2b9dfd", "product": {"name": "Apostrophe ", "vendor": {"name": "apostrophecms"}}, "product_version": "< 4.33.0"}, {"id": "6230d957-04a9-3acb-9cd5-99e31ea3dd39", "product": {"name": "import-export", "vendor": {"name": "apostrophecms"}}, "product_version": "< 3.7.0"}], "enisaIdVendor": [{"id": "1dc91f17-619a-3938-9274-269b1c38d151", "vendor": {"name": "@apostrophecms"}}, {"id": "f0ded143-4396-3090-9ca7-5c673aef2157", "vendor": {"name": "apostrophecms"}}], "isExploited": false}