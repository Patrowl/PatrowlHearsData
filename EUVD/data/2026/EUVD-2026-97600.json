{"id": "EUVD-2026-97600", "enisaUuid": "d94139a5-6a78-3ac2-ad16-09bf1f245d7b", "description": "Open WebUI 0.11.0 before 0.11.4 compiles user-chosen grep patterns for its knowledge and chat file search tools with a regex engine that expands nested counted repetition unbounded at compile time and caches the result. Authenticated users can have the model call grep_knowledge_files with short nested-repetition patterns, blocking the event loop and exhausting worker memory.", "datePublished": "2026-10-12T16:04:56", "dateUpdated": "2026-10-13T15:46:25", "baseScore": 7.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/open-webui/open-webui/security/advisories/GHSA-gww9-mhgj-pfqh", "https://github.com/open-webui/open-webui/commit/97e013a66169c4fcd7f26ab9e41a4ff260ffd4da", "https://www.vulncheck.com/advisories/open-webui-0.11.0-before-0.11.4-memory-exhaustion-via-knowledge-search-regex"], "aliases": ["CVE-2026-109298", "GHSA-x55j-pj79-2cgm"], "assigner": "VulnCheck", "epss": 0.39, "enisaIdProduct": [{"id": "93346271-ef69-3604-bad9-f379edc24d7d", "product": {"name": "open-webui", "vendor": {"name": "open-webui"}}, "product_version": "0.11.0 <0.11.4"}], "enisaIdVendor": [{"id": "f4c3f059-dab1-30c5-9c12-5a6bd4b73da6", "vendor": {"name": "open-webui"}}], "isExploited": false}