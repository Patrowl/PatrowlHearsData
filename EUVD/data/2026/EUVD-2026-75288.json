{"id": "EUVD-2026-75288", "enisaUuid": "95328a66-e065-3657-8946-d91d6c372b3b", "description": "A flaw was found in the skupper-router component of Red Hat Service Interconnect, which is used to provide secure communication between distributed services. The issue occurs when the router processes a specially crafted network message using its AMQP field parser. Due to a lack of bounds on recursion during parsing, the router can run out of stack memory and crash, leading to a denial of service for the interconnected network.", "datePublished": "2026-09-10T07:09:10", "dateUpdated": "2026-10-13T21:40:40", "baseScore": 5.9, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:82316", "https://access.redhat.com/errata/RHSA-2026:82340", "https://access.redhat.com/security/cve/CVE-2026-88763", "https://bugzilla.redhat.com/show_bug.cgi?id=2531301"], "aliases": ["CVE-2026-88763", "GHSA-j54j-r8q7-v2hq"], "assigner": "redhat", "epss": 0.53, "enisaIdProduct": [{"id": "069229f6-0f3e-3a02-917e-9b1ca71666d7", "product": {"name": "Service Interconnect 2 for RHEL 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 3.5.3-1"}, {"id": "953c8bad-5387-3fe2-8f48-e1178a04d3ed", "product": {"name": "Service Interconnect 2 for RHEL 8", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:3.5.3-1.el8"}, {"id": "bfc80a52-aea4-3d1d-b18d-5b3652cee802", "product": {"name": "Service Interconnect 2 for RHEL 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:3.5.3-1.el9"}], "enisaIdVendor": [{"id": "01583417-dc9a-3ce5-af59-5de19480e2c3", "vendor": {"name": "Red Hat"}}], "isExploited": false}