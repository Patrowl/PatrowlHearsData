{"id": "EUVD-2026-82735", "enisaUuid": "cd406261-f7e2-3463-8103-7b33b4f19434", "description": "A flaw was found in RESTEasy's IIOImageProvider, which decodes attacker-supplied image request bodies without enforcing any limit on the declared image dimensions or pixel count. A remote, unauthenticated attacker can send a small crafted image declaring enormous dimensions to trigger a very large memory allocation, exhausting the JVM heap and resulting in a denial of service.", "datePublished": "2026-09-18T07:13:39", "dateUpdated": "2026-10-19T15:55:49", "baseScore": 7.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:83082", "https://access.redhat.com/errata/RHSA-2026:83520", "https://access.redhat.com/errata/RHSA-2026:85234", "https://access.redhat.com/security/cve/CVE-2026-89059", "https://bugzilla.redhat.com/show_bug.cgi?id=2519756", "https://github.com/resteasy/resteasy/commit/7c7e6b37c8b2451a37aed9cdc6978b447456bacb", "https://github.com/resteasy/resteasy/security/advisories/GHSA-m4pc-7gc7-9vw2"], "aliases": ["CVE-2026-89059"], "assigner": "redhat", "epss": 0.76, "enisaIdProduct": [{"id": "13f416b6-2144-337f-8ace-30a28e7a56c3", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:3.0.26-20.el9_8.1"}, {"id": "552b0b9f-4151-36de-bcd7-8258538634da", "product": {"name": "Red Hat build of Quarkus 3.27.6.redhat", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 6.2.19.Final-redhat-00003"}, {"id": "60c8cd8b-5248-34cb-8f6e-edc98dd9951f", "product": {"name": "Red Hat build of Quarkus 3.33.4.redhat", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 6.2.19.Final-redhat-00003"}], "enisaIdVendor": [{"id": "a694405c-ff95-3636-9080-293c6ac898b9", "vendor": {"name": "Red Hat"}}], "isExploited": false}