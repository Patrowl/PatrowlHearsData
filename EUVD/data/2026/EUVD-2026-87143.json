{"id": "EUVD-2026-87143", "enisaUuid": "0d981a46-434e-3fde-92bd-7a95aa9ff618", "description": "RabbitMQ is a messaging and streaming broker. From 3.13.0 until 3.13.15, 4.0.20, 4.1.11, and 4.2.6, mechanisms/1 applied list_to_atom/1 to every colon-delimited token in an attacker-controlled auth_mechanism value, permanently consuming Erlang VM atoms and allowing the node to be crashed with a large request. Exploitation requires the Shovel or Federation plugin to be in use, and setting auth_mechanism requires the policymaker tag. This issue is fixed in versions 3.13.15, 4.0.20, 4.1.11, and 4.2.6.", "datePublished": "2026-09-25T16:00:16", "dateUpdated": "2026-09-28T13:46:28", "baseScore": 5.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:H/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/rabbitmq/rabbitmq-server/security/advisories/GHSA-85jr-6rr2-j73r", "https://github.com/rabbitmq/rabbitmq-server/releases/tag/v4.2.6"], "aliases": ["CVE-2026-67222"], "assigner": "GitHub_M", "epss": 0.32, "enisaIdProduct": [{"id": "17ccc1b2-ebdd-3635-a07a-5df433435156", "product": {"name": "rabbitmq-server", "vendor": {"name": "rabbitmq"}}, "product_version": "3.13.0, < 3.13.15"}, {"id": "21e3058b-72b2-3283-95bd-eea2c65b748f", "product": {"name": "rabbitmq-server", "vendor": {"name": "rabbitmq"}}, "product_version": "4.2.0, < 4.2.6"}, {"id": "4af764e6-3357-3900-a32e-010e3bea7f66", "product": {"name": "rabbitmq-server", "vendor": {"name": "rabbitmq"}}, "product_version": "4.0.0, < 4.0.20"}, {"id": "51a762c2-d182-3bd1-8aca-8c19c2e8cd0b", "product": {"name": "rabbitmq-server", "vendor": {"name": "rabbitmq"}}, "product_version": "4.1.0, < 4.1.11"}], "enisaIdVendor": [{"id": "5a7abce7-f1ea-3c25-8049-ec3515aafcdb", "vendor": {"name": "rabbitmq"}}], "isExploited": false}