{"id": "EUVD-2026-67068", "enisaUuid": "f4c6f1d8-f85f-3095-aa5a-bad961ee57d1", "description": "openssl_encrypt versions before 1.4.9 use under-parameterized PBKDF2-HMAC-SHA256 with only 100,000 iterations to protect PQC keyfile private keys and 10,000 iterations for dual-encryption file-password verification. Attackers who obtain keyfiles or encrypted files can brute-force wrapping passwords offline using GPU or ASIC acceleration.", "datePublished": "2026-08-27T14:51:12", "dateUpdated": "2026-10-01T15:21:37", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/jahlives/openssl_encrypt/security/advisories/GHSA-fmjx-p826-6fvr", "https://www.vulncheck.com/advisories/openssl-encrypt-before-1.4.9-weak-cryptographic-parameters"], "aliases": ["CVE-2026-81718", "GHSA-8pv3-p4p2-f6pr"], "assigner": "VulnCheck", "epss": 0.17, "enisaIdProduct": [{"id": "98ab5c41-48db-35f1-887b-31e0d04edf2c", "product": {"name": "openssl_encrypt", "vendor": {"name": "jahlives"}}, "product_version": "0 <1.4.9"}], "enisaIdVendor": [{"id": "d1737c5a-84d4-328b-827d-f2ddf8fbac24", "vendor": {"name": "jahlives"}}], "isExploited": false}