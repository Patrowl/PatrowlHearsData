{"id": "EUVD-2026-102923", "enisaUuid": "4cffbf4a-3f26-3fc3-a1c8-d771dc08f838", "description": "MariaDB server is a community developed fork of MySQL server. From 10.6.1 until 10.6.28, 10.11.19, 11.4.13, 11.8.9, 12.3.3, and 13.0.2, the CONNECT engine plugin file-access UDFs json_file(), bson_file(), jfile_make(), bfile_make(), and jbin_file() are affected because each does not enforce FILE privilege or the secure_file_priv setting. A low-privileged attacker can trigger the issue by calling a CONNECT file-access UDF with a filesystem path, then invoke a CONNECT file-access UDF to access a filesystem path and read or write files that the database account is not authorized to access, subject to operating-system permissions. This issue is fixed in versions 10.6.28, 10.11.19, 11.4.13, 11.8.9, 12.3.3, and 13.0.2.", "datePublished": "2026-10-16T16:21:14", "dateUpdated": "2026-10-16T17:05:42", "baseScore": 5.4, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N", "references": ["https://github.com/MariaDB/server/security/advisories/GHSA-2245-9hm3-wxf6", "https://github.com/MariaDB/server/commit/4f66ca1b69daf1b7e6a562ca8e86d77a6a70abfe", "https://github.com/MariaDB/server/releases/tag/mariadb-10.11.19", "https://github.com/MariaDB/server/releases/tag/mariadb-10.6.28", "https://github.com/MariaDB/server/releases/tag/mariadb-11.4.13", "https://github.com/MariaDB/server/releases/tag/mariadb-11.8.9", "https://github.com/MariaDB/server/releases/tag/mariadb-12.3.3", "https://github.com/MariaDB/server/releases/tag/mariadb-13.0.2", "https://jira.mariadb.org/browse/MDEV-40323"], "aliases": ["CVE-2026-85985"], "assigner": "GitHub_M", "epss": 0.21, "enisaIdProduct": [{"id": "047130fe-9921-35b6-bf8e-6def1e5920b5", "product": {"name": "Server", "vendor": {"name": "Devolutions"}}, "product_version": "12.3.1, < 12.3.3"}, {"id": "495c23df-4a41-306c-bbdb-737b661f48cb", "product": {"name": "Server", "vendor": {"name": "Devolutions"}}, "product_version": "10.11.1, < 10.11.19"}, {"id": "986efb26-69fe-31cd-8a63-0d68ab0a5de9", "product": {"name": "Server", "vendor": {"name": "Devolutions"}}, "product_version": "11.8.1, < 11.8.9"}, {"id": "a7f23da3-1984-3061-a31f-5322571c3209", "product": {"name": "Server", "vendor": {"name": "Devolutions"}}, "product_version": "11.4.1, < 11.4.13"}, {"id": "aaff4b1c-dc0f-3616-b3aa-8db61a212d9e", "product": {"name": "Server", "vendor": {"name": "Devolutions"}}, "product_version": "13.0.1, < 13.0.2"}, {"id": "f580f10f-2120-3620-a367-b905896f4677", "product": {"name": "Server", "vendor": {"name": "Devolutions"}}, "product_version": "10.6.1, < 10.6.28"}], "enisaIdVendor": [{"id": "136ca535-4fc3-34d1-b752-2d0ce3c4e31b", "vendor": {"name": "MariaDB"}}], "isExploited": false}