{"id": "EUVD-2026-100402", "enisaUuid": "14227a86-601b-31a8-959d-949abe8475ae", "description": "A denial of service vulnerability exists when Microsoft Common Object Runtime Library improperly handles web requests. An attacker who successfully exploited this vulnerability could cause a denial of service against a .NET web application.\nA remote unauthenticated attacker could exploit this vulnerability by issuing specially crafted requests to the .NET application.\nThe update addresses the vulnerability by correcting how the .NET web application handles web requests.", "datePublished": "2026-10-13T19:01:37", "dateUpdated": "2026-10-22T22:26:24", "baseScore": 5.9, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H/E:U/RL:O/RC:C", "references": ["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-70162"], "aliases": ["CVE-2026-70162", "GHSA-2fmv-rv2c-59x7"], "assigner": "microsoft", "epss": 0.77, "enisaIdProduct": [{"id": "64b3bdd5-a361-3fdc-a430-5f706c1fdad5", "product": {"name": "System.Security.Cryptography.Pkcs", "vendor": {"name": "Microsoft"}}, "product_version": "10.0.0 <10.0.13"}, {"id": "7109ccdf-d8f3-3a2d-9a46-1a8a9f45d464", "product": {"name": "Microsoft Visual Studio 2026 version 18.10", "vendor": {"name": "Microsoft"}}, "product_version": "18.10.0 <18.10.4"}, {"id": "b6180c26-0bee-3db0-b520-1b8cb361adb5", "product": {"name": "Microsoft Visual Studio 2022 version 17.14", "vendor": {"name": "Microsoft"}}, "product_version": "17.14.0 <17.14.42"}], "enisaIdVendor": [{"id": "fcb12974-0b6b-3fe9-9198-595a5f41d86b", "vendor": {"name": "Microsoft"}}], "isExploited": false}