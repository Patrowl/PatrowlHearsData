{"id": "EUVD-2026-104281", "enisaUuid": "3ce2c848-2a01-34f4-9054-ae8acfa1f85c", "description": "CheckCle through 1.6.0 contains a missing authorization vulnerability that allows unauthenticated attackers to read, modify and delete records because shipped PocketBase collections use empty API rules. Attackers can query /api/collections/<name>/records endpoints to steal server_token values and alert_configurations secrets, disable alerting, alter status pages, or delete monitoring data.", "datePublished": "2026-10-19T13:55:34", "dateUpdated": "2026-10-19T18:27:55", "baseScore": 9.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/operacle/checkcle/issues/214", "https://github.com/operacle/checkcle/commit/f2c338ced9162b7820b2495e298d5578df92bf75", "https://github.com/operacle/checkcle/blob/v1.6.0/application/public/upload/data/pb_schema_latest.json", "https://www.vulncheck.com/advisories/checkcle-through-1.6.0-missing-authorization-via-empty-pocketbase-api-rules"], "aliases": ["CVE-2026-112292", "GHSA-52m4-ffr8-945g"], "assigner": "VulnCheck", "epss": 0.35, "enisaIdProduct": [{"id": "ac95bed8-0a4f-37b5-814f-8284b75615f9", "product": {"name": "checkcle", "vendor": {"name": "operacle"}}, "product_version": "0 \u22641.6.0"}], "enisaIdVendor": [{"id": "030d9510-545c-3aaa-943d-d30f9617ea68", "vendor": {"name": "operacle"}}], "isExploited": false}