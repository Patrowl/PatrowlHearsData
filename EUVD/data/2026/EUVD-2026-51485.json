{"id": "EUVD-2026-51485", "enisaUuid": "82aad287-8a94-387b-a2ab-03bac9c61d17", "description": "Keycloak allows users to log in using Google accounts and can be configured to only allow users from specific Google Workspace domains. A flaw was found where the token exchange feature, which allows swapping a Google token for a Keycloak token, does not check these domain restrictions. This means an attacker with a valid Google account from a different domain could bypass the security check and gain access to the Keycloak realm.", "datePublished": "2026-07-31T07:08:26", "dateUpdated": "2026-09-16T18:34:27", "baseScore": 6.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:68277", "https://access.redhat.com/errata/RHSA-2026:68278", "https://access.redhat.com/security/cve/CVE-2026-18214", "https://bugzilla.redhat.com/show_bug.cgi?id=2508308"], "aliases": ["CVE-2026-18214", "GHSA-wmhp-w67v-6jm5"], "assigner": "redhat", "epss": 0.4, "enisaIdProduct": [{"id": "41ea5f6b-339a-3937-bc00-8e4c591e5362", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6.7-3"}, {"id": "62321324-5919-3f64-b257-c992caa32e9b", "product": {"name": "Red Hat build of Keycloak 26.6", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.6-20"}], "enisaIdVendor": [{"id": "03da33a8-5b73-32e7-9337-986c8d8b59dc", "vendor": {"name": "Red Hat"}}], "isExploited": false}