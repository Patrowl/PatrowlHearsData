{"id": "EUVD-2026-102558", "enisaUuid": "5f32fc59-8b15-39fb-8c76-f32ff53f29f0", "description": "FreeRDP from 2.0.0 before 3.32.0 contains an unbounded reassembly vulnerability in WTSProcessChannelData that fails to enforce cumulative fragment limits. Authenticated clients can start a static virtual channel message, withhold the LAST flag, and send endless fragments to exhaust server memory.", "datePublished": "2026-10-16T01:17:45", "dateUpdated": "2026-10-16T17:07:38", "baseScore": 7.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/FreeRDP/FreeRDP/security/advisories/GHSA-xm53-352c-57jw", "https://www.vulncheck.com/advisories/freerdp-2.0.0-before-3.32.0-memory-exhaustion-via-static-channel-reassembly"], "aliases": ["CVE-2026-111377", "GHSA-5qxm-7xrj-fjrf"], "assigner": "VulnCheck", "epss": 0.27, "enisaIdProduct": [{"id": "fe4b6c8d-7533-33bf-ab23-a3cf00b1625a", "product": {"name": "FreeRDP", "vendor": {"name": "FreeRDP"}}, "product_version": "2.0.0 <3.32.0"}], "enisaIdVendor": [{"id": "764d3990-204a-30f2-8c97-518b67927b99", "vendor": {"name": "FreeRDP"}}], "isExploited": false}