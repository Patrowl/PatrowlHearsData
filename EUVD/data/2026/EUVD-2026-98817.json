{"id": "EUVD-2026-98817", "enisaUuid": "faad1a61-34d5-3fe3-bcf6-0c08690e81dc", "description": "Plane is an open-source project management tool. Prior to 1.4.0, the plane comments fail to sanitize unsafe URL schemes stored in comment_html. A project member can store a crafted link in a comment, and attacker-controlled script executes in the browser context of another user who selects the link. This issue is fixed in version 1.4.0.", "datePublished": "2026-10-13T15:32:10", "dateUpdated": "2026-10-13T16:21:12", "baseScore": 8.5, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:P/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/makeplane/plane/security/advisories/GHSA-6qrq-f73q-r67j", "https://github.com/makeplane/plane/pull/9287", "https://github.com/makeplane/plane/commit/0d58adb69d859fc94c43b9d68fadd77e810d5ed1", "https://github.com/makeplane/plane/releases/tag/v1.4.0"], "aliases": ["CVE-2026-102982"], "assigner": "GitHub_M", "epss": 0.35, "enisaIdProduct": [{"id": "beed1026-948f-3f48-ad9a-a883e5dad8ec", "product": {"name": "plane", "vendor": {"name": "makeplane"}}, "product_version": "< 1.4.0"}], "enisaIdVendor": [{"id": "7513bd4e-c1ec-3f13-a558-a56c8961647d", "vendor": {"name": "makeplane"}}], "isExploited": false}