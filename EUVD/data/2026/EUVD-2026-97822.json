{"id": "EUVD-2026-97822", "enisaUuid": "1ffbd845-772c-30fe-ba73-d13fd6c9adf8", "description": "containerd is an open-source container runtime. Prior to 1.7.35, 2.0.12, 2.2.8, and 2.3.5, containerd's layer unpack handler repeatedly traverses directories for certain opaque whiteout configurations. A malicious image layer can trigger repeated directory traversals while opaque whiteouts are processed. Pulling or importing the image can consume CPU, delay container startup, and reduce image-pull concurrency for unrelated deployments. This issue is fixed in versions 1.7.35, 2.0.12, 2.2.8, and 2.3.5.", "datePublished": "2026-10-12T19:53:24", "dateUpdated": "2026-10-13T20:24:33", "baseScore": 4.6, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:A/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/containerd/containerd/security/advisories/GHSA-rp3h-jf77-q9p4", "https://github.com/containerd/containerd/commit/e6ca378dcfa610d06589a3ac96aa992de866e4f0"], "aliases": ["CVE-2026-95838", "GHSA-rp3h-jf77-q9p4"], "assigner": "GitHub_M", "epss": 0.22, "enisaIdProduct": [{"id": "26482652-1f1a-3234-8c89-4f0e1a94bcd4", "product": {"name": "containerd", "vendor": {"name": "containerd"}}, "product_version": "< 1.7.35"}, {"id": "3e4c1880-2644-3fec-9390-1465d4589c38", "product": {"name": "containerd", "vendor": {"name": "containerd"}}, "product_version": "2.3.0, < 2.3.5"}, {"id": "e0b9c689-6b44-392b-9de2-0b3324d19cf4", "product": {"name": "containerd", "vendor": {"name": "containerd"}}, "product_version": "2.0.0-beta.0, < 2.0.12"}, {"id": "f6c200ed-e2f5-3e14-8ff1-6a7ca8dcb02d", "product": {"name": "containerd", "vendor": {"name": "containerd"}}, "product_version": "2.2.0, < 2.2.8"}], "enisaIdVendor": [{"id": "1b3a48d8-e9f3-3f58-8892-a005ecd40c36", "vendor": {"name": "containerd"}}], "isExploited": false}