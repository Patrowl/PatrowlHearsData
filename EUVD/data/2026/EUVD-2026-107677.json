{"id": "EUVD-2026-107677", "enisaUuid": "f026e175-e10a-3c8a-8521-0c8604b7fac7", "description": "GitLab has remediated an issue in GitLab CE/EE affecting all versions from 10.1 before 19.3.6, 19.4 before 19.4.3, and 19.5 before 19.5.1 that, when OmniAuth SAML and LDAP auto-linking were both enabled, an authenticated user could have taken over an existing LDAP-backed account without any interaction from the targeted user, due to improper input sanitization in the LDAP email lookup path used during OmniAuth identity linking.", "datePublished": "2026-10-21T23:35:15", "dateUpdated": "2026-10-23T10:58:00", "baseScore": 8.2, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:C/C:H/I:H/A:N", "references": ["https://gitlab.com/gitlab-org/gitlab/-/work_items/605977", "https://hackerone.com/reports/3852192", "https://docs.gitlab.com/releases/patches/patch-release-gitlab-19-5-1-released/"], "aliases": ["CVE-2026-15723", "GHSA-92f3-3rm4-rcgv"], "assigner": "GitLab", "epss": 0.33, "enisaIdProduct": [{"id": "0bd92eca-feb4-3ae3-b199-bbdca6ff3163", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.5 <19.5.1"}, {"id": "538c696d-9693-3849-80c1-fa4b03df53ac", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "10.1 <19.3.6"}, {"id": "a642b797-0afc-3b6a-bd24-a8c7846534f2", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.4 <19.4.3"}], "enisaIdVendor": [{"id": "5752dbe8-189d-3f4e-b285-6f82662b3360", "vendor": {"name": "GitLab"}}], "isExploited": false}