{"id": "EUVD-2026-55821", "enisaUuid": "2d818bfe-6d49-33cc-9530-763d5a9afafe", "description": "A flaw was found in the Red Hat OpenShift AI (RHOAI) overlay for the training operator. The RHOAI overlay incorrectly aggregates `trainjobs` management permissions into the native Kubernetes `edit ClusterRole`. This allows any user with `edit ClusterRole` permissions in a namespace to create, modify, and delete `TrainJobs`. When combined with a separate vulnerability (TRN-01) that permits arbitrary pod configurations, a remote attacker with namespace editor privileges could exploit this to escalate privileges, potentially leading to arbitrary code execution.", "datePublished": "2026-08-10T20:45:10", "dateUpdated": "2026-09-30T16:21:01", "baseScore": 8.8, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:53262", "https://access.redhat.com/errata/RHSA-2026:53263", "https://access.redhat.com/errata/RHSA-2026:60367", "https://access.redhat.com/errata/RHSA-2026:60520", "https://access.redhat.com/errata/RHSA-2026:73987", "https://access.redhat.com/security/cve/CVE-2026-18951", "https://bugzilla.redhat.com/show_bug.cgi?id=2511187"], "aliases": ["CVE-2026-18951", "GHSA-h7xh-qc2m-rc58"], "assigner": "redhat", "epss": 0.92, "enisaIdProduct": [{"id": "143f4316-6d09-3c35-8598-509e2fd841d3", "product": {"name": "Red Hat OpenShift AI 3.5", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1786552250"}, {"id": "1c32aff3-50d3-3380-a078-6db69cc93f65", "product": {"name": "Red Hat OpenShift AI 3.3", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1790137153"}, {"id": "311a7dbe-dcc5-39b6-b37d-d2b890645356", "product": {"name": "Red Hat OpenShift AI 3.3", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1785188461"}, {"id": "385d50e5-0c16-3a55-99e4-2aecbbef00f0", "product": {"name": "Red Hat OpenShift AI 3.5", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1786552271"}, {"id": "ccf0cf4b-717e-3776-924f-891b7b537dc6", "product": {"name": "Red Hat OpenShift AI 3.4", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1784814352"}, {"id": "db25c56f-e11b-3477-9ad4-c0304a6c0e10", "product": {"name": "Red Hat OpenShift AI 3.4", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 1787361677"}], "enisaIdVendor": [{"id": "adb195db-85d2-38e8-aebe-69edc51d02bc", "vendor": {"name": "Red Hat"}}], "isExploited": false}