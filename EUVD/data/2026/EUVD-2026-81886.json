5.10.270"}, {"id": "9c169b3f-1af4-3f4d-8fa3-89d963765f7c", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "b8d26b3be8b33682cf163274ed07479a70554633 <9c21a433022219ca899d1b3cd9049991f51a6a2c"}, {"id": "a3869881-81da-3bf2-884f-83701c7f268d", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "b8d26b3be8b33682cf163274ed07479a70554633 <068fe9841d2585b79d479fc7b58251d02d0b066f"}, {"id": "b018e144-8a61-3997-9e57-9b2af5689203", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 6.1.188"}, {"id": "c6a1e22b-6215-3be1-9de6-e0ed85b7c7a2", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 5.15.221"}, {"id": "ca55e182-5c63-3451-a6bd-a16c0689d144", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 7.2.6"}, {"id": "cfada1e4-6c3e-354f-a8b6-631041440c57", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "b8d26b3be8b33682cf163274ed07479a70554633 <6c506fee5a5f2c8719c65bcfc5e5d0862b0a1946"}, {"id": "d5544bc0-7422-3671-bfe3-0384ea91c83a", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 6.6.157"}, {"id": "dc1c26d5-bb19-370d-98ec-d9467af22e4b", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "b8d26b3be8b33682cf163274ed07479a70554633 <962edb9a6b0dae09d33a677485a398fc7d55968c"}, {"id": "ee2c4ac4-f467-3953-bf21-383fb1f32b81", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "patch: 0"}, {"id": "ffba89d4-10a5-373c-b8e3-f19261050028", "product": {"name": "Linux", "vendor": {"name": "Linux"}}, "product_version": "b8d26b3be8b33682cf163274ed07479a70554633 <ad4492dcaf90a1d1a728ec5eef1a68ce5355027a"}], "enisaIdVendor": [{"id": "45e875df-0bac-36d6-adab-89b9c7d533be", "vendor": {"name": "Linux"}}], "isExploited": false}