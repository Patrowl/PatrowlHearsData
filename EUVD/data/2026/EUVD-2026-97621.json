{"id": "EUVD-2026-97621", "enisaUuid": "d19be73b-a5b9-3af0-9042-69edbbae7e7f", "description": "Grav Guestbook plugin 0.5.0 and 0.5.1 contains missing authorization and cross-site request forgery vulnerabilities in Admin moderation actions delete, approve, and approveAll. Authenticated Admin users lacking the admin.guestbook permission, or external sites abusing a moderator's session via nonce-less GET requests, can delete or approve Guestbook entries.", "datePublished": "2026-10-12T16:05:12", "dateUpdated": "2026-10-13T16:54:36", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/getgrav/grav/security/advisories/GHSA-wxr7-h5mm-c7mv", "https://www.vulncheck.com/advisories/grav-guestbook-plugin-0.5.0-and-0.5.1-missing-authorization-and-csrf-in-moderation"], "aliases": ["GHSA-6xrw-24fx-4qcf", "CVE-2026-109319"], "assigner": "VulnCheck", "epss": 0.2, "enisaIdProduct": [{"id": "92961655-3e44-3657-afbc-a6f9a71c3e5f", "product": {"name": "grav-plugin-guestbook", "vendor": {"name": "getgrav"}}, "product_version": "0.5.0 <0.5.2"}], "enisaIdVendor": [{"id": "9219f096-dcb4-3014-a839-3856cd358af7", "vendor": {"name": "getgrav"}}], "isExploited": false}