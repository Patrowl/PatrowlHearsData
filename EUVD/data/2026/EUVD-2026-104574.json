{"id": "EUVD-2026-104574", "enisaUuid": "5a955f66-e4f4-3a50-b2d9-0dcc58befde5", "description": "Parse Server before 8.6.99 and 9.0.0 before 9.10.3-alpha.2 evaluates checks against the target account during a user update before authorizing the caller, and reflects their outcome in the response. An unauthorized caller, with or without a session, can confirm guessed usernames or emails and, when passwordPolicy.maxPasswordHistory or doNotAllowUsername is set, guessed current or previous passwords, bypassing account lockout.", "datePublished": "2026-10-19T19:10:48", "dateUpdated": "2026-10-19T21:24:16", "baseScore": 6.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/parse-community/parse-server/security/advisories/GHSA-p49q-9w65-f9p7", "https://www.vulncheck.com/advisories/parse-server-before-8.6.99-and-9-x-before-9.10.3-alpha.2-information-disclosure-via-user-update"], "aliases": ["CVE-2026-112768", "GHSA-w8m9-f3qj-3xfx"], "assigner": "VulnCheck", "epss": 0.4, "enisaIdProduct": [{"id": "58ea969a-c23e-3b3f-948d-8b21ce01280f", "product": {"name": "parse-server", "vendor": {"name": "parse-community"}}, "product_version": "9.0.0 <9.10.3-alpha.2"}, {"id": "7889fb59-23b4-3d1b-8fa6-3ace9b53f86b", "product": {"name": "parse-server", "vendor": {"name": "parse-community"}}, "product_version": "0 <8.6.99"}], "enisaIdVendor": [{"id": "907c5e8c-a298-3e05-839b-65b4983406f9", "vendor": {"name": "parse-community"}}], "isExploited": false}