{"id": "EUVD-2026-42907", "enisaUuid": "b9362b85-7f37-3af4-baea-d5b9bd13d91e", "description": "The iDirect iQ200 does not validate CSRF tokens on state-changing API endpoints after authentication. The /api/reboot endpoint accepts POST requests authenticated solely by a session cookie that lacks the SameSite attribute. A remote attacker can host a malicious web page that, when visited by an authenticated administrator, automatically submits a cross-site POST request causing an immediate device reboot and satellite link loss. Repeated attacks can sustain a denial-of-service condition.", "datePublished": "2026-07-10T14:11:15", "dateUpdated": "2026-09-11T14:41:03", "baseScore": 7.0, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:A/VC:N/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://support.idirect.net", "https://www.cisa.gov/news-events/ics-advisories/icsa-26-183-01", "https://github.com/cisagov/CSAF/blob/develop/csaf_files/OT/white/2026/icsa-26-183-01.json"], "aliases": ["GHSA-39r6-f6c2-xh29", "CVE-2026-38057"], "assigner": "icscert", "epss": 0.31, "enisaIdProduct": [{"id": "8695ede9-a6b5-3a92-946a-d2d2f039e2e7", "product": {"name": "Evolution iQ\u2011Series terminals", "vendor": {"name": "ST Engineering iDirect"}}, "product_version": "0 \u22644.5.2.1"}, {"id": "c8067a8d-ddaa-32be-8555-a47c9dc5a545", "product": {"name": "9-Series Terminals", "vendor": {"name": "ST Engineering iDirect"}}, "product_version": "0 \u22644.5.2.1"}, {"id": "c8969c9c-4026-3463-9c5a-d73c78c1e96e", "product": {"name": "3315-Series terminals", "vendor": {"name": "ST Engineering iDirect"}}, "product_version": "0 \u22644.5.2.1"}], "enisaIdVendor": [{"id": "4f64c420-47d3-3f40-9208-8a87acbe5261", "vendor": {"name": "ST Engineering iDirect"}}], "isExploited": false}