{"id": "EUVD-2026-83259", "enisaUuid": "8739ae6c-a237-36e7-bea3-0bdc95fee689", "description": "A flaw was found in the Quarkus Qute template engine. When the {#eval} section helper processes a sub-template, it fails to pass the parent template's content type information. This bypasses standard escaping mechanisms, allowing untrusted data to be output as raw, unescaped text. This vulnerability can lead to Cross-Site Scripting (XSS) and JSON Injection, potentially allowing a remote attacker to execute arbitrary code in a user's browser or manipulate data.", "datePublished": "2026-09-18T17:53:19", "dateUpdated": "2026-10-15T23:41:36", "baseScore": 6.1, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:83082", "https://access.redhat.com/errata/RHSA-2026:83520", "https://access.redhat.com/security/cve/CVE-2026-93432", "https://bugzilla.redhat.com/show_bug.cgi?id=2536859"], "aliases": ["GHSA-6wxq-x76c-fqrf", "CVE-2026-93432"], "assigner": "redhat", "epss": 0.54, "enisaIdProduct": [{"id": "737b824c-fe38-3768-9ff1-1b98a74744e5", "product": {"name": "Red Hat build of Quarkus 3.33.4.redhat", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 3.33.4.redhat-00004"}, {"id": "ad8e53e1-c4cb-33b9-b087-4da3ea63a007", "product": {"name": "Red Hat build of Quarkus 3.27.6.redhat", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 3.27.6.redhat-00004"}], "enisaIdVendor": [{"id": "3167c6c2-2b81-3544-85d2-f02ba5c9ed3b", "vendor": {"name": "Red Hat"}}], "isExploited": false}