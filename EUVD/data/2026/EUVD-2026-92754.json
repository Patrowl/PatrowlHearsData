{"id": "EUVD-2026-92754", "enisaUuid": "4480d94f-d556-3d7f-b7c2-b851e6189f59", "description": "Ghost is a Node.js content management system. From 6.54.1 until 6.65.0, a validation issue allowed some functionality, such as Webmentions, to be abused by an unauthenticated user to make limited HTTP requests to hosts in the Ghost server's internal network. A successful attack would not result in any response data being returned. This issue is fixed in version 6.65.0.", "datePublished": "2026-10-05T19:01:20", "dateUpdated": "2026-10-05T19:52:13", "baseScore": 4.0, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:C/C:L/I:N/A:N", "references": ["https://github.com/TryGhost/Ghost/security/advisories/GHSA-322m-ff4g-9vx9", "https://github.com/TryGhost/Ghost/pull/30918", "https://github.com/TryGhost/Ghost/commit/3f8594eb53de883ac017545c358f59039cb152de", "https://github.com/TryGhost/Ghost/releases/tag/v6.65.0"], "aliases": ["CVE-2026-105647", "GHSA-322m-ff4g-9vx9"], "assigner": "GitHub_M", "epss": 0.23, "enisaIdProduct": [{"id": "1ae154d3-6737-380e-9a10-d966ba45df46", "product": {"name": "Ghost", "vendor": {"name": "TryGhost"}}, "product_version": "6.54.1, < 6.65.0"}], "enisaIdVendor": [{"id": "a7cb1ff8-974d-3e22-8260-6f6f9b5ecec7", "vendor": {"name": "TryGhost"}}], "isExploited": false}