{"id": "EUVD-2026-103026", "enisaUuid": "dd8effb8-b6ad-3d75-91c5-ef5788d8f599", "description": "eladmin through 2.7 contains an authorization bypass vulnerability that allows department-scoped user managers to modify or delete accounts outside their data scope because write handlers skip department checks. Attackers with user:edit or user:del permissions can send PUT or DELETE requests to /api/users with target user ids to disable, reassign, alter, or delete accounts in other departments.", "datePublished": "2026-10-16T17:38:46", "dateUpdated": "2026-10-21T02:30:50", "baseScore": 5.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:H/UI:N/VC:N/VI:L/VA:L/SC:N/SI:N/SA:N", "references": ["https://hackmd.io/@hieuPenguinnn/eladmin-user-update-delete-missing-dept-data-scope", "https://github.com/elunez/eladmin/blob/v2.7/eladmin-system/src/main/java/me/zhengjie/modules/system/rest/UserController.java#L118-L152", "https://github.com/elunez/eladmin", "https://www.vulncheck.com/advisories/eladmin-through-2.7-broken-access-control-via-api-users-update-and-delete"], "aliases": ["GHSA-7qp5-57jr-xmpr", "CVE-2026-111604"], "assigner": "VulnCheck", "epss": 0.33, "enisaIdProduct": [{"id": "abd8890a-0bfc-3ba7-9f6f-007ccea75cdc", "product": {"name": "eladmin", "vendor": {"name": "elunez"}}, "product_version": "0 \u22642.7"}], "enisaIdVendor": [{"id": "3381f5aa-8f9d-33e8-ab9f-e91c86ad9dc8", "vendor": {"name": "elunez"}}], "isExploited": false}