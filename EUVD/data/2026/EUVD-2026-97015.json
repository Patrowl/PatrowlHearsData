{"id": "EUVD-2026-97015", "enisaUuid": "af42f1d5-6f96-3704-b897-a36f4bd9a835", "description": "iFlytek Astron Agent through 1.1.2 contains an insecure direct object reference vulnerability that allows authenticated applications to resume other applications' paused workflows by supplying their event_id to POST /workflow/v1/resume. Attackers can predict Snowflake event IDs to inject resume content into victim workflows and read their continuation output stream, breaking cross-tenant isolation.", "datePublished": "2026-10-11T13:26:10", "dateUpdated": "2026-10-18T11:53:05", "baseScore": 2.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:N/VC:L/VI:L/VA:N/SC:N/SI:N/SA:N", "references": ["https://hackmd.io/@1ExmmukzRMWN7B4gQ4W-4Q/iflytek-astron-agent-cross-app-workflow-resume", "https://github.com/iflytek/astron-agent/blob/v1.1.2/core/workflow/api/v1/chat/open.py#L106-L183", "https://github.com/iflytek/astron-agent/blob/v1.1.2/core/workflow/cache/event_registry.py", "https://github.com/iflytek/astron-agent", "https://www.vulncheck.com/advisories/iflytek-astron-agent-through-1.1.2-authorization-bypass-via-workflow-v1-resume-endpoint"], "aliases": ["CVE-2026-108864", "GHSA-whrv-p3hh-8mvr"], "assigner": "VulnCheck", "epss": 0.17, "enisaIdProduct": [{"id": "7943bbce-c89d-386a-a961-f5a9d8873fd9", "product": {"name": "astron-agent", "vendor": {"name": "iflytek"}}, "product_version": "0 \u22641.1.2"}], "enisaIdVendor": [{"id": "8dc80ba8-676d-3521-b9fd-9f6317fdbd80", "vendor": {"name": "iflytek"}}], "isExploited": false}