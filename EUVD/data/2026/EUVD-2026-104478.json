{"id": "EUVD-2026-104478", "enisaUuid": "6315da91-8c2f-3deb-960e-c27a96510b90", "description": "AIOHTTP is an asynchronous HTTP client/server framework for asyncio and Python. Prior to 3.14.4, the Secure attribute for a shared cookie is not enforced. An attacker can consequently cause a shared cookie marked Secure to be sent with an unencrypted request. This issue is fixed in version 3.14.4.", "datePublished": "2026-10-19T16:44:31", "dateUpdated": "2026-10-22T20:50:40", "baseScore": 6.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/aio-libs/aiohttp/security/advisories/GHSA-494j-54xm-rwp3", "https://github.com/aio-libs/aiohttp/commit/999c356d61e966faffa97b06ab0d0455226d36c5", "https://github.com/aio-libs/aiohttp/releases/tag/v3.14.4"], "aliases": ["GHSA-494j-54xm-rwp3", "CVE-2026-111063"], "assigner": "GitHub_M", "epss": 0.22, "enisaIdProduct": [{"id": "41065cff-b656-308a-9d57-2552455b68d4", "product": {"name": "aiohttp", "vendor": {"name": "aio-libs"}}, "product_version": "< 3.14.4"}], "enisaIdVendor": [{"id": "31f324e3-0564-3b23-bc28-87dcd85855c5", "vendor": {"name": "aio-libs"}}], "isExploited": false}