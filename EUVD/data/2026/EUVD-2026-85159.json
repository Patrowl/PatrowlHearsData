{"id": "EUVD-2026-85159", "enisaUuid": "98ea5a6e-bd84-35cf-827f-26408f955a9c", "description": "A signature validation vulnerability exists in Foxit PDF Editor/Reader\u2019s handling of incrementally updated PDF documents. Changes to visible document content may not invalidate the existing signature, allowing attackers to alter signed content and potentially carry out content spoofing while the document continues to appear validly signed.", "datePublished": "2026-09-23T07:49:25", "dateUpdated": "2026-09-23T14:24:20", "baseScore": 5.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:N/I:H/A:N", "references": ["https://www.foxit.com/support/security-bulletins.html"], "aliases": ["GHSA-c9r7-69j9-jq5j", "CVE-2026-91814"], "assigner": "Foxit", "epss": 0.11, "enisaIdProduct": [{"id": "34dd19ab-5a03-3699-b74a-3d4ac694cfa8", "product": {"name": "Foxit PDF Editor", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 2026.2 and earlier"}, {"id": "7a135522-c91c-351c-8bd3-55024b870757", "product": {"name": "Foxit PDF Editor", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 13.2.6 and earlier"}, {"id": "89634037-4ac8-33a2-8559-5fdeea8c0db1", "product": {"name": "Foxit PDF Editor", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 14.0.7 and earlier"}, {"id": "c72f0a51-97f2-3982-8973-ef513307e616", "product": {"name": "Foxit PDF Reader", "vendor": {"name": "Foxit Software Inc."}}, "product_version": "Versions 2026.2 and earlier"}], "enisaIdVendor": [{"id": "fe9a40c0-806e-3fa0-924f-53dc39815eea", "vendor": {"name": "Foxit Software Inc."}}], "isExploited": false}