{"id": "EUVD-2026-101397", "enisaUuid": "950c69e3-a5ab-33de-bf60-ee70c2f9cd80", "description": "A Stack-based Buffer Overflow vulnerability in the kmd component of Juniper Networks Junos OS on MX Series allows an unauthenticated network attacker to execute code as root via specific IKE certificate-based packets.\n\nThis issue requires IKE to be enabled with an RSA-signature IKE policy to be vulnerable.\n\nThis issue affects Junos OS on MX Series:\n\n\n  *  All versions before 21.2R3-S11;\n  *  from 21.4 before 21.4R3-S12;\n  *  from 22.2 before 22.2R3-S8;\n  *  from 22.3 before 22.3R3-S5;\n  *  from 22.4 before 22.4R3-S9;", "datePublished": "2026-10-14T16:57:50", "dateUpdated": "2026-10-20T20:30:29", "baseScore": 9.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:L/AU:Y/R:A/V:C/RE:M", "references": ["https://supportportal.juniper.net/JSA112196"], "aliases": ["GHSA-pvg7-92rm-23q6", "CVE-2026-102182"], "assigner": "juniper", "epss": 0.41, "enisaIdProduct": [{"id": "695c5bfe-82ba-39f6-aec5-9a4f540e33a2", "product": {"name": "Junos OS", "vendor": {"name": "Juniper Networks"}}, "product_version": "0 <23.2R2-S7.7"}, {"id": "77841d57-fc26-394c-bdcf-ed0433de48c9", "product": {"name": "Junos OS", "vendor": {"name": "Juniper Networks"}}, "product_version": "24.4 <24.4R2-S5"}, {"id": "85384357-fd89-3131-bcda-5e1d14220485", "product": {"name": "Junos OS", "vendor": {"name": "Juniper Networks"}}, "product_version": "25.4 <25.4R1-S3"}, {"id": "8585ed7d-c351-3ce7-a168-3d031a0d99a2", "product": {"name": "Junos OS", "vendor": {"name": "Juniper Networks"}}, "product_version": "24.2 <24.2R2-S5.5"}, {"id": "885bc7a0-f21f-31ba-98c5-3bd77732c312", "product": {"name": "Junos OS", "vendor": {"name": "Juniper Networks"}}, "product_version": "25.2 <25.2R2-S2"}, {"id": "8d382468-1041-384e-8234-cf88f356409e", "product": {"name": "Junos OS", "vendor": {"name": "Juniper Networks"}}, "product_version": "26.2 <26.2R1-S2"}, {"id": "b7d6