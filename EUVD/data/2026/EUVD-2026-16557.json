{"id": "EUVD-2026-16557", "enisaUuid": "713f29c3-bc8e-3458-8046-8d2f0aee2408", "description": "A flaw was found in firewalld. A local unprivileged user can exploit this vulnerability by mis-authorizing two runtime D-Bus (Desktop Bus) setters, setZoneSettings2 and setPolicySettings. This mis-authorization allows the user to modify the runtime firewall state without proper authentication, leading to unauthorized changes in network security configurations.", "datePublished": "2026-03-27T05:30:23", "dateUpdated": "2026-10-06T17:33:42", "baseScore": 5.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:N", "references": ["https://access.redhat.com/errata/RHBA-2026:28238", "https://access.redhat.com/errata/RHSA-2026:67585", "https://access.redhat.com/errata/RHSA-2026:67843", "https://access.redhat.com/errata/RHSA-2026:76844", "https://access.redhat.com/security/cve/CVE-2026-4948", "https://bugzilla.redhat.com/show_bug.cgi?id=2452086"], "aliases": ["CVE-2026-4948"], "assigner": "redhat", "epss": 0.18, "enisaIdProduct": [{"id": "30fe0d88-c731-35c7-8b6a-3f7aca027351", "product": {"name": "Red Hat Enterprise Linux 10.0 Extended Update Support", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:2.3.1-1.el10_0.1"}, {"id": "4f5fe94a-4534-31ca-be0c-52bf8729b5b4", "product": {"name": "Red Hat Enterprise Linux 10", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:2.4.2-1.el10_2"}, {"id": "50b63159-0764-3d3a-a7c5-842a60dcaa84", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:1.3.4-20.el9_8"}, {"id": "ce117806-6257-359d-a9c3-7d882d2a525a", "product": {"name": "Red Hat Enterprise Linux 9.6 Extended Update Support", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:1.3.4-15.el9_6.1"}], "enisaIdVendor": [{"id": "5049639d-249c-3b46-a625-bf33dc8e135c", "vendor": {"name": "Red Hat"}}], "isExploited": false}