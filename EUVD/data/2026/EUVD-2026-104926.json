{"id": "EUVD-2026-104926", "enisaUuid": "c539b59e-037d-3891-926c-a0c1710026b6", "description": "Chatwoot before 4.14.0 contains a stored cross-site scripting vulnerability that allows account administrators to inject JavaScript by crafting video-embed links in Help Center articles. Attackers can use angle-bracket link destinations with double quotes to break out of the unescaped iframe src attribute in render_embed_from_match, executing scripts for public visitors and stealing cw_conversation widget tokens.", "datePublished": "2026-10-20T10:41:40", "dateUpdated": "2026-10-20T13:25:35", "baseScore": 4.8, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:H/UI:P/VC:L/VI:L/VA:N/SC:L/SI:L/SA:N", "references": ["https://github.com/chatwoot/chatwoot/pull/14140", "https://github.com/chatwoot/chatwoot/commit/2192af80f405c70e3021191ff8b3f7e539c35e9d", "https://github.com/chatwoot/chatwoot/releases/tag/v4.14.0", "https://github.com/chatwoot/chatwoot/blob/88ffa329eb6e18ae06b608d8b4bab96c0e1b8f44/lib/custom_markdown_renderer.rb#L75-L84", "https://www.vulncheck.com/advisories/chatwoot-before-4.14.0-stored-xss-via-help-center-video-embed-links"], "aliases": ["GHSA-v2m9-jwmw-39xc", "CVE-2026-113355"], "assigner": "VulnCheck", "epss": 0.23, "enisaIdProduct": [{"id": "35d2bbc9-c879-389c-b3bc-aaa182dc6a0c", "product": {"name": "chatwoot", "vendor": {"name": "n/a"}}, "product_version": "0 <4.14.0"}], "enisaIdVendor": [{"id": "a409d027-4b0b-372c-b370-cd0dfec93f72", "vendor": {"name": "chatwoot"}}], "isExploited": false}