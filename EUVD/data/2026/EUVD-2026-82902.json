{"id": "EUVD-2026-82902", "enisaUuid": "486609d7-d566-30eb-a93a-8fa87201ab7c", "description": "A flaw was found in Netty's HttpServerCodec. A remote, unauthenticated attacker can exploit this vulnerability by pipelining HTTP/1.1 requests on a single connection and withholding reads. This action causes the methodOverflowQueue to grow without limit, leading to unbounded heap memory consumption and a denial of service due to memory exhaustion.", "datePublished": "2026-09-18T12:43:26", "dateUpdated": "2026-10-15T16:42:28", "baseScore": 7.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:69440", "https://access.redhat.com/errata/RHSA-2026:69470", "https://access.redhat.com/errata/RHSA-2026:70257", "https://access.redhat.com/errata/RHSA-2026:83612", "https://access.redhat.com/security/cve/CVE-2026-93491", "https://bugzilla.redhat.com/show_bug.cgi?id=2536891", "https://github.com/netty/netty/releases/tag/netty-4.1.138.Final", "https://github.com/netty/netty/releases/tag/netty-4.2.18.Final"], "aliases": ["CVE-2026-93491", "GHSA-c593-fgx2-8jj6"], "assigner": "redhat", "epss": 0.73, "enisaIdProduct": [{"id": "9d864985-8709-3169-a2a4-6c8f0f196b01", "product": {"name": "Red Hat Build of Apache Camel 3.33.3.SP2", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 4.1.138.Final-redhat-00001"}], "enisaIdVendor": [{"id": "83966bbe-78de-3ebf-9f58-ce357e7f5161", "vendor": {"name": "Red Hat"}}], "isExploited": false}