{"id": "EUVD-2026-94391", "enisaUuid": "a70f57c0-e525-3378-95b0-907bfbd2f424", "description": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-30 and 6.9.13-55, a missing recursion-depth check in the CALS decoder allows a crafted CALS image to exhaust the call stack and terminate the process. This issue is fixed in versions 7.1.2-30 and 6.9.13-55.", "datePublished": "2026-10-07T15:33:10", "dateUpdated": "2026-10-07T16:11:13", "baseScore": 5.3, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L", "references": ["https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-wxw6-98rj-hjfr", "https://github.com/ImageMagick/ImageMagick/commit/19bce64e3667ff03", "https://github.com/ImageMagick/ImageMagick6/commit/0ca580238abba18910cfee0fcc3159621fec0dee", "https://github.com/ImageMagick/ImageMagick/releases/tag/7.1.2-30", "https://github.com/ImageMagick/ImageMagick6/releases/tag/6.9.13-55"], "aliases": ["CVE-2026-106572"], "assigner": "GitHub_M", "epss": 0.38, "enisaIdProduct": [{"id": "addec346-0a15-3229-b912-75bb879878e0", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "< 6.9.13-55"}, {"id": "e389397c-3e17-332d-a356-3271eb2916cf", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "7.0.0, < 7.1.2-30"}], "enisaIdVendor": [{"id": "94d43cc5-8402-314a-aa6f-d6524ca74cd2", "vendor": {"name": "ImageMagick"}}], "isExploited": false}