{"id": "EUVD-2026-88690", "enisaUuid": "031a1784-75b0-3e02-bb1b-ed56d63add3b", "description": "GitLab has remediated an issue in GitLab CE/EE affecting all versions from 15.11 before 19.2.7, 19.3 before 19.3.3, and 19.4 before 19.4.1 that under certain conditions could have allowed an unauthenticated user to read CI/CD job trace contents containing sensitive variable values due to improper authorization enforcement in the GraphQL API.", "datePublished": "2026-09-29T09:35:38", "dateUpdated": "2026-09-29T15:39:42", "baseScore": 3.7, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:N/A:N", "references": ["https://gitlab.com/gitlab-org/gitlab/-/work_items/594294", "https://hackerone.com/reports/3590929", "https://docs.gitlab.com/releases/patches/patch-release-gitlab-19-4-1-released/"], "aliases": ["GHSA-75vf-vmx4-frc7", "CVE-2026-4523"], "assigner": "GitLab", "epss": 0.41, "enisaIdProduct": [{"id": "505a2891-b812-3ae5-8c59-bf1e156b219b", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "15.11 <19.2.7"}, {"id": "cfb9e27d-0bde-394a-98fa-c217037121d6", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.3 <19.3.3"}, {"id": "d63c7196-d674-3d56-a77c-f1c1e43e7431", "product": {"name": "GitLab", "vendor": {"name": "GitLab"}}, "product_version": "19.4 <19.4.1"}], "enisaIdVendor": [{"id": "ffcf88e2-8bd9-371e-a1bc-d4452cad23de", "vendor": {"name": "GitLab"}}], "isExploited": false}