{"id": "EUVD-2026-95129", "enisaUuid": "6cced369-e362-3146-ac2b-2dc7cbf68eb6", "description": "In OpenStack Mistral through 23.0.0, the /v2/maintenance API controller clears the request context and calls the maintenance service directly without any policy enforcement. Any holder of a valid Mistral token, regardless of assigned role, can read and change the service's cluster-wide maintenance state. Setting the state to PAUSED stops processing of new workflow and execution objects across all tenant projects until an operator restores it.", "datePublished": "2026-10-08T17:35:43", "dateUpdated": "2026-10-09T11:42:46", "baseScore": 7.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://launchpad.net/bugs/2162789", "https://security.openstack.org/ossa/OSSA-2026-044.html"], "aliases": ["GHSA-858j-2m97-g3qm", "CVE-2026-93860"], "assigner": "mitre", "epss": 0.34, "enisaIdProduct": [{"id": "9de2c1e4-78d5-3123-a612-6f081eb3b70c", "product": {"name": "Mistral", "vendor": {"name": "OpenStack"}}, "product_version": "23.0.0"}, {"id": "a186c7c8-aba7-341c-bb8e-00ce9c758298", "product": {"name": "Mistral", "vendor": {"name": "OpenStack"}}, "product_version": "0 <20.1.1"}, {"id": "d0d356e4-0373-3bae-8a50-09a38bb68baf", "product": {"name": "Mistral", "vendor": {"name": "OpenStack"}}, "product_version": "21.0.0 <21.0.1"}, {"id": "f181754c-5c19-3fc2-8c58-1f7230823c18", "product": {"name": "Mistral", "vendor": {"name": "OpenStack"}}, "product_version": "22.0.0 <22.0.1"}], "enisaIdVendor": [{"id": "a0850797-baf6-3690-88c8-b72dcbca66b8", "vendor": {"name": "OpenStack"}}], "isExploited": false}