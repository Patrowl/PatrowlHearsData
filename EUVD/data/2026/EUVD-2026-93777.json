{"id": "EUVD-2026-93777", "enisaUuid": "bafd2b50-acd1-35e2-a9eb-bcc0316ca0d1", "description": "The RabbitMQ Java client library allows Java and JVM-based applications to connect to and interact with RabbitMQ nodes. Prior to 5.35.0, ConnectionFactoryConfigurator.load() includes the raw uri value in wrapped exceptions when AMQP URI parsing fails. Because the URI may contain a plaintext username and password, startup logs, application performance monitoring systems, CI logs, and copied stack traces can disclose broker credentials to users who should not have access to them. This issue is fixed in version 5.35.0.", "datePublished": "2026-10-06T18:11:44", "dateUpdated": "2026-10-19T19:27:41", "baseScore": 5.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:L/AC:L/AT:P/PR:L/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/rabbitmq/rabbitmq-java-client/security/advisories/GHSA-h6w7-qmcm-q6xr", "https://github.com/rabbitmq/rabbitmq-java-client/pull/2052", "https://github.com/rabbitmq/rabbitmq-java-client/commit/daca1875cdb8b8c0acce78f71103b21a05478446", "https://github.com/rabbitmq/rabbitmq-java-client/releases/tag/v5.35.0"], "aliases": ["CVE-2026-106123", "GHSA-h6w7-qmcm-q6xr"], "assigner": "GitHub_M", "epss": 0.16, "enisaIdProduct": [{"id": "55c12283-59d5-32aa-866a-becc2458a292", "product": {"name": "rabbitmq-java-client", "vendor": {"name": "rabbitmq"}}, "product_version": "< 5.35.0"}, {"id": "a4323c79-0d9b-3fe9-8cd5-ff58ee24866d", "product": {"name": "amqp-client", "vendor": {"name": "com.rabbitmq"}}, "product_version": "< 5.35.0"}], "enisaIdVendor": [{"id": "6ad8684e-548d-357f-918f-9331c3a7ed6c", "vendor": {"name": "rabbitmq"}}, {"id": "ca125de0-4976-31d0-901a-6901920c30f8", "vendor": {"name": "com.rabbitmq"}}], "isExploited": false}