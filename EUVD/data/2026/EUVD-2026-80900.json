{"id": "EUVD-2026-80900", "enisaUuid": "0cc522c2-8055-324a-a42f-6223fe231acd", "description": "Covenant through 0.6 registers the CovenantHub SignalR hub without an Authorize attribute, allowing unauthenticated callers to invoke CreateHttpListener and receive a signed JWT token. Attackers can use the obtained token to authenticate against the entire operator API and access grunts, credentials, binaries, events, and the operator roster.", "datePublished": "2026-09-16T17:31:37", "dateUpdated": "2026-09-24T14:22:51", "baseScore": 9.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/cobbr/Covenant/issues/406", "https://github.com/cobbr/Covenant", "https://github.com/cobbr/Covenant/blob/v0.6/Covenant/Hubs/CovenantHub.cs#L28-L33", "https://github.com/cobbr/Covenant/blob/v0.6/Covenant/Core/CovenantService.cs#L3958-L3975", "https://www.vulncheck.com/advisories/covenant-through-0.6-missing-authentication-on-the-covenanthub-signalr-hub"], "aliases": ["GHSA-h9hg-x52x-c465", "CVE-2026-92717"], "assigner": "VulnCheck", "epss": 0.5, "enisaIdProduct": [{"id": "95439f27-ca14-3e49-9d96-fec5e4a01527", "product": {"name": "Covenant", "vendor": {"name": "Cobbr"}}, "product_version": "0 \u22640.6"}], "enisaIdVendor": [{"id": "73213b97-b8a0-3a87-858e-430abf62085d", "vendor": {"name": "Cobbr"}}], "isExploited": false}