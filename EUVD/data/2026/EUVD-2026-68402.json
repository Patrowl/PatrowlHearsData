{"id": "EUVD-2026-68402", "enisaUuid": "27a76809-267e-3492-a9ae-327c2374adf6", "description": "@pdfme/schemas before 5.5.9 contains a cross-site scripting vulnerability in the Select schema plugin that fails to sanitize option values before interpolating them into HTML via innerHTML. Attackers can supply malicious templates with crafted option values containing HTML and JavaScript to execute arbitrary code in users' browsers.", "datePublished": "2026-08-31T08:46:37", "dateUpdated": "2026-10-08T15:25:41", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:P/VC:L/VI:L/VA:N/SC:L/SI:L/SA:N", "references": ["https://github.com/pdfme/pdfme/security/advisories/GHSA-qq9g-96v4-m3cj", "https://www.vulncheck.com/advisories/pdfme-schemas-before-5.5.9-cross-site-scripting-via-select"], "aliases": ["GHSA-q78q-xrxw-xgx6", "CVE-2026-82867"], "assigner": "VulnCheck", "epss": 0.31, "enisaIdProduct": [{"id": "d3e6b5e1-0541-3e67-bc19-ae56d6eedaad", "product": {"name": "schemas", "vendor": {"name": "pdfme"}}, "product_version": "0 <5.5.9"}], "enisaIdVendor": [{"id": "15100989-a4c4-3cdf-9c6f-1dbf5d5a9757", "vendor": {"name": "pdfme"}}], "isExploited": false}