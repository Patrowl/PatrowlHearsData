{"id": "EUVD-2026-103064", "enisaUuid": "2766f964-ee23-3513-9dd7-03e9ac4f029b", "description": "FastapiAdmin through 3.0 contains a hard-coded JWT signing secret in backend/app/config/setting.py that allows low-privileged users to forge tokens impersonating the superuser. Attackers can register via the unauthenticated /api/v1/system/user/register endpoint, log in, and forge an HS256 token keeping their session_id but naming the superuser in user_name to gain superuser privileges.", "datePublished": "2026-10-16T17:39:12", "dateUpdated": "2026-10-16T19:21:12", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://hackmd.io/@hieuPenguinnn/fastapiadmin-unauthenticated-autologin-and-hardcoded-jwt-secret", "https://github.com/fastapiadmin/FastapiAdmin/blob/v3.0/backend/app/config/setting.py#L67", "https://github.com/fastapiadmin/FastapiAdmin/blob/v3.0/backend/app/core/dependencies.py#L72-L112", "https://www.vulncheck.com/advisories/fastapiadmin-through-3.0-hard-coded-jwt-secret-privilege-escalation"], "aliases": ["CVE-2026-111642", "GHSA-p7cm-h8w6-p4cm"], "assigner": "VulnCheck", "epss": 0.36, "enisaIdProduct": [{"id": "f88ecc42-9cd7-30e6-b99a-e04033106bae", "product": {"name": "FastApiAdmin", "vendor": {"name": "n/a"}}, "product_version": "0 \u22643.0"}], "enisaIdVendor": [{"id": "335f75b8-9853-3b0f-b504-3cbaaf649c6a", "vendor": {"name": "fastapiadmin"}}], "isExploited": false}