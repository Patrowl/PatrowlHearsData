{"id": "EUVD-2026-86486", "enisaUuid": "d699ea72-02e7-3a97-b1c7-9a8efc72a4ba", "description": "containerd is an open-source container runtime. Prior to versions 1.7.36, 2.0.13, 2.2.9, 2.3.6, and 2.4.1, a crafted OCI index graph can force very high CPU/memory usage during PullImage (before container start), causing long ContainerCreating stalls and, at larger sizes, node/runtime instability. Versions 1.7.36, 2.0.13, 2.2.9, 2.3.6, and 2.4.1 fix the issue.", "datePublished": "2026-09-25T00:06:43", "dateUpdated": "2026-09-28T14:58:33", "baseScore": 6.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/containerd/containerd/security/advisories/GHSA-pg57-6jwg-q645"], "aliases": ["CVE-2026-53493", "GHSA-pg57-6jwg-q645"], "assigner": "GitHub_M", "epss": 0.36, "enisaIdProduct": [{"id": "06895d80-c90d-3637-9ec2-789fc6218a5e", "product": {"name": "containerd", "vendor": {"name": "containerd"}}, "product_version": "= 2.4.0"}, {"id": "95aef533-e142-3311-a9f2-aed5ab69bafe", "product": {"name": "containerd", "vendor": {"name": "containerd"}}, "product_version": "2.3.0, < 2.3.6"}, {"id": "9d6aca2f-818a-327d-aa1c-7c3ec1ab00f6", "product": {"name": "containerd", "vendor": {"name": "containerd"}}, "product_version": "2.0.0, < 2.0.13"}, {"id": "d996381d-70d2-3e20-912c-c91f6f56f89f", "product": {"name": "containerd", "vendor": {"name": "containerd"}}, "product_version": "< 1.7.36"}, {"id": "decfa936-fb0a-31a2-962e-79eba09026ef", "product": {"name": "containerd", "vendor": {"name": "containerd"}}, "product_version": "2.1.0, < 2.2.9"}], "enisaIdVendor": [{"id": "4ba07b91-16f6-3190-93e3-42b086405d15", "vendor": {"name": "containerd"}}], "isExploited": false}