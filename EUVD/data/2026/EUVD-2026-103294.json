{"id": "EUVD-2026-103294", "enisaUuid": "8accab4b-99a1-3ccb-9e9a-071f7c088bfd", "description": "Coder before 2.29.20, 2.33.0 before 2.33.12, 2.34.0 before 2.34.8, and 2.35.0 before 2.35.4 contains an improper hostname validation flaw in GetWorkspaceProxyByHostname whose SIMILAR TO pattern performs a prefix match, so any domain that is a string prefix of a workspace-proxy access URL is trusted as a proxy. Attackers owning such a domain can lure an authenticated victim to a crafted /api/v2/applications/auth-redirect link, capture the redirected application_connect API key, and replay it to access the victim's workspace apps.", "datePublished": "2026-10-17T18:46:39", "dateUpdated": "2026-10-21T21:45:39", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:H/AT:P/PR:L/UI:P/VC:H/VI:H/VA:N/SC:H/SI:H/SA:N", "references": ["https://github.com/coder/coder/security/advisories/GHSA-h58h-qvv5-xvwg", "https://www.vulncheck.com/advisories/coder-before-2.35.4-credential-theft-via-workspace-proxy-hostname-prefix-match"], "aliases": ["GHSA-47cv-h282-xh6p", "CVE-2026-111927"], "assigner": "VulnCheck", "epss": 0.21, "enisaIdProduct": [{"id": "460c02b5-035c-39a0-b0f2-c7cbea0a2967", "product": {"name": "coder", "vendor": {"name": "coder"}}, "product_version": "0 <2.29.20"}, {"id": "6213c9ee-dad5-39a4-815c-f7c4b52ca6c5", "product": {"name": "coder", "vendor": {"name": "coder"}}, "product_version": "2.34.0 <2.34.8"}, {"id": "661d0998-3398-397f-9c12-50d6eca3aad4", "product": {"name": "coder", "vendor": {"name": "coder"}}, "product_version": "2.35.0 <2.35.4"}, {"id": "6bac2165-fcc8-3c4f-9ffb-9e10eba82794", "product": {"name": "coder", "vendor": {"name": "coder"}}, "product_version": "2.33.0 <2.33.12"}], "enisaIdVendor": [{"id": "dc6afc76-f426-3d88-ac3e-61ad1a4afd4f", "vendor": {"name": "coder"}}], "isExploited": false}