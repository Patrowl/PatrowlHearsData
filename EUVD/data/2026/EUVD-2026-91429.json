{"id": "EUVD-2026-91429", "enisaUuid": "ce287891-b4be-3386-879e-50d7c8963d5c", "description": "Ghost from 6.10.3 before 6.64.0 contains a remote code execution vulnerability that allows authenticated administrators to run code by abusing theme translation file loading. Attackers with administrator access can upload a crafted theme containing malicious translation files to execute arbitrary code on the Ghost server.", "datePublished": "2026-10-02T11:38:00", "dateUpdated": "2026-10-02T17:35:51", "baseScore": 8.6, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:H/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/TryGhost/Ghost/security/advisories/GHSA-jj74-hc2q-xrvm", "https://www.vulncheck.com/advisories/ghost-from-6.10.3-before-6.64.0-rce-via-theme-translation-files"], "aliases": ["CVE-2026-104418", "GHSA-5pc5-4pc7-5x44"], "assigner": "VulnCheck", "epss": 0.65, "enisaIdProduct": [{"id": "a4f18ad0-4ab5-3f33-bc4e-7eefd2c3e666", "product": {"name": "Ghost", "vendor": {"name": "TryGhost"}}, "product_version": "6.10.3 <6.64.0"}], "enisaIdVendor": [{"id": "3d645ca5-250a-3cad-b71b-c2d3f70989f6", "vendor": {"name": "TryGhost"}}], "isExploited": false}