{"id": "EUVD-2026-88379", "enisaUuid": "1a652ab7-d3bc-3637-880c-4fa48b57e0b0", "description": "A flaw was found in the StreamsHub Console for Apache Kafka. Tenant-supplied Kafka client properties from the Console custom resource are copied into the console-api AdminClient configuration without filtering security-sensitive keys, allowing a Console CR author to set config.providers and bootstrap.servers to exfiltrate the console-api ServiceAccount token to an attacker-controlled broker.", "datePublished": "2026-09-28T17:27:44", "dateUpdated": "2026-10-05T08:56:02", "baseScore": 6.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N", "references": ["https://access.redhat.com/security/cve/CVE-2026-96740", "https://bugzilla.redhat.com/show_bug.cgi?id=2539427", "https://github.com/advisories/GHSA-3rpr-3qjq-fg52", "https://github.com/streamshub/console/commit/d45897e12", "https://github.com/streamshub/console/commit/ef13971", "https://github.com/streamshub/console/pull/2957"], "aliases": ["CVE-2026-96740", "GHSA-3rpr-3qjq-fg52"], "assigner": "redhat", "epss": 0.41, "enisaIdProduct": [{"id": "7fae745c-8368-32be-8b20-520d9b9acf13", "product": {"name": "StreamsHub Console for Apache Kafka\u00ae", "vendor": {"name": "Red Hat"}}, "product_version": "0.13.0 <0.14.1"}, {"id": "f00c24a1-85d8-3749-b4c4-9840bf1629e3", "product": {"name": "StreamsHub Console for Apache Kafka\u00ae", "vendor": {"name": "Red Hat"}}, "product_version": "0.2.1 <0.12.9"}], "enisaIdVendor": [{"id": "8a0c14a8-f040-3c5a-8076-5b6257fb2f65", "vendor": {"name": "Red Hat"}}], "isExploited": false}