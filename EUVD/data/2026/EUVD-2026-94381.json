{"id": "EUVD-2026-94381", "enisaUuid": "f3d889ef-86f1-32b8-a68d-fc13e32cee70", "description": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-32, delegate symlink cleanup does not check the MAGICK_SHRED_PASSES environment variable, allowing a local privileged workflow to overwrite a file with random data. This issue is fixed in version 7.1.2-32.", "datePublished": "2026-10-07T15:21:39", "dateUpdated": "2026-10-07T17:04:17", "baseScore": 4.0, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:L/AC:H/PR:H/UI:R/S:U/C:N/I:H/A:N", "references": ["https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-54hm-vrmh-75qj", "https://github.com/ImageMagick/ImageMagick/commit/48e5ce1779fc640a389f0020fd7d965d0c08236e", "https://github.com/ImageMagick/ImageMagick6/commit/11d2af00a948e9ca2919d9a8684d335a48484094", "https://github.com/ImageMagick/ImageMagick/releases/tag/7.1.2-32", "https://github.com/ImageMagick/ImageMagick6/releases/tag/6.9.13-57"], "aliases": ["CVE-2026-106566"], "assigner": "GitHub_M", "epss": 0.12, "enisaIdProduct": [{"id": "0f1407dc-b53d-3195-83a5-1a59bdea1ccf", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "< 6.9.13-57"}, {"id": "ff75e1e0-9f4b-3616-bdc1-b2f17e8a82ac", "product": {"name": "ImageMagick", "vendor": {"name": "ImageMagick"}}, "product_version": "7.0.0, < 7.1.2-32"}], "enisaIdVendor": [{"id": "a3fefe95-b240-399b-b2d7-5bb16a0a33c7", "vendor": {"name": "ImageMagick"}}], "isExploited": false}