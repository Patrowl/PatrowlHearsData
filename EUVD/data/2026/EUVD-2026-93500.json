{"id": "EUVD-2026-93500", "enisaUuid": "a36a88ae-4dc3-37e4-a878-062ed1ec5ce3", "description": "Payload is a free and open source headless content management system. Prior to 3.90.0 and 4.0.0-canary.34, an attacker with read and create or update access to a collection containing a json field or a blocks field with blocksAsJSON enabled can inject SQL through a crafted field path and operators. Collections without those fields are not affected, and richText fields are not affected. The SQLite packages are fixed in versions 3.90.0 and 4.0.0-canary.34, and the Postgres packages are fixed in version 3.73.0.", "datePublished": "2026-10-06T16:23:58", "dateUpdated": "2026-10-06T17:39:22", "baseScore": 8.6, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/payloadcms/payload/security/advisories/GHSA-pj7x-6wpf-pgvp", "https://github.com/payloadcms/payload/commit/03b78c7e0901d19c67f07bdf6396a276010adbcc", "https://github.com/payloadcms/payload/releases/tag/v3.90.0"], "aliases": ["GHSA-pj7x-6wpf-pgvp", "CVE-2026-105856"], "assigner": "GitHub_M", "epss": 0.29, "enisaIdProduct": [{"id": "3ff14e28-6b2b-3bf5-955d-5114489fbeec", "product": {"name": "db-vercel-postgres", "vendor": {"name": "@payloadcms"}}, "product_version": "3.0.0 < 3.73.0"}, {"id": "4247a7b2-894b-3521-9888-394d38be62ae", "product": {"name": "db-sqlite", "vendor": {"name": "@payloadcms"}}, "product_version": "4.0.0-canary.0, < 4.0.0-canary.34"}, {"id": "73347419-4246-3c11-923d-25675bd593b6", "product": {"name": "db-d1-sqlite", "vendor": {"name": "@payloadcms"}}, "product_version": "4.0.0-canary.0, < 4.0.0-canary.34"}, {"id": "9396d277-335d-3668-b8b9-5eee35f842d5", "product": {"name": "db-postgres", "vendor": {"name": "@payloadcms"}}, "product_version": "3.0.0 < 3.73.0"}, {"id": "98dba6eb-6bb4-308d-9d4f-b196f86f7a4c", "product": {"name": "db-d1-sqlite", "vendor": {"name": "@payloadcms"}}, "product_version": "3.0.0, < 3.90