{"id": "EUVD-2026-95994", "enisaUuid": "be83f515-3e85-311b-b297-0ddf0d40a3e3", "description": "Vikunja is an open-source self-hosted task management platform. Versions prior to 2.4.0 store password-reset, email-confirmation, and account-deletion tokens in the `user_tokens` table in plaintext. If an attacker gains read access to the database through a backup leak, misconfigured storage, or SQL-level exposure, they can immediately use pending tokens to take over user accounts without knowing passwords. Version 2.4.0 fixes the issue.", "datePublished": "2026-10-09T20:50:35", "dateUpdated": "2026-10-13T18:31:03", "baseScore": 8.1, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H", "references": ["https://github.com/go-vikunja/vikunja/security/advisories/GHSA-r6w9-259g-gwrv", "https://github.com/go-vikunja/vikunja/commit/00fd2c6155c01faae99be4226b931d8091fd6323", "https://github.com/go-vikunja/vikunja/commit/3a0ea15d8c18ff960bc98ae39950fa7a14b0af7d", "https://github.com/go-vikunja/vikunja/commit/e31ea2de5040fa63bc97cf4df63bafed3bd9ad85", "https://github.com/go-vikunja/vikunja/releases/tag/v2.4.0"], "aliases": ["GHSA-r6w9-259g-gwrv", "CVE-2026-62376"], "assigner": "GitHub_M", "epss": 0.22, "enisaIdProduct": [{"id": "8da2fbd7-6b61-3de9-b6b1-acb09521527c", "product": {"name": "vikunja", "vendor": {"name": "go-vikunja"}}, "product_version": "< 2.4.0"}], "enisaIdVendor": [{"id": "1a426d49-6ad3-3458-aec7-06e21517bc1e", "vendor": {"name": "go-vikunja"}}], "isExploited": false}