{"id": "EUVD-2026-105152", "enisaUuid": "661e6b04-0aa4-311e-a724-2e23381da07f", "description": "Vitest is a Vite-native testing framework for JavaScript and TypeScript projects. From 4.1.11 until 4.1.12 and 5.0.3, isFileLoadingAllowed and the filesystem read interpret backslashes differently on Windows in packages/mocker/src/node/interceptorPlugin.ts. When a client can reach the Vite dev server on Windows and register a redirect mock containing backslash traversal, POSIX joining preserves a Windows backslash traversal that the later filesystem read interprets as a path separator, so the client can read a file outside server.fs.allow that the Vitest process can access. This issue is fixed in versions 4.1.12 and 5.0.3.", "datePublished": "2026-10-20T15:21:32", "dateUpdated": "2026-10-20T15:21:32", "baseScore": 5.9, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:N/A:N", "references": ["https://github.com/vitest-dev/vitest/security/advisories/GHSA-xp26-3454-mjgp", "https://github.com/vitest-dev/vitest/commit/15cc006aa9f8683dc5f7e895d011fa7dc751ce35", "https://github.com/vitest-dev/vitest/commit/b825313243dc55757e8d7c0f9e7a792135e13473", "https://github.com/vitest-dev/vitest/releases/tag/v4.1.12", "https://github.com/vitest-dev/vitest/releases/tag/v5.0.3"], "aliases": ["CVE-2026-112950", "GHSA-xp26-3454-mjgp"], "assigner": "GitHub_M", "epss": 0.38, "enisaIdProduct": [{"id": "17961d28-7b0c-33b0-bb49-6106193bbb74", "product": {"name": "mocker", "vendor": {"name": "@vitest"}}, "product_version": "5.0.0-rc.2, < 5.0.3"}, {"id": "5f733200-1e2c-3b1e-8975-5bdf4a3e7c76", "product": {"name": "vitest", "vendor": {"name": "vitest-dev"}}, "product_version": "5.0.0-rc.2, < 5.0.3"}, {"id": "b1193c67-053f-3119-a962-79a3b12287a9", "product": {"name": "vitest", "vendor": {"name": "vitest-dev"}}, "product_version": "4.1.11, < 4.1.12"}, {"id": "db51f21d-d558-3e93-bdaa-95e668e38dfe", "product": {"name": "mocker", "vendor": {"name": "@vitest"}}, "product_version": "4.1.11, < 4.1.12"}], "enisaIdVendor": [{"id": "1b0000af-16e6-373e-9b66-79b177d28e96", "vendor": {"name": "@vitest"}}, {"id": "531653ac-1c28-3541-bf87-b3027c8164ed", "vendor": {"name": "vitest-dev"}}], "isExploited": false}