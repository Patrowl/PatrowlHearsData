{"id": "EUVD-2026-81621", "enisaUuid": "4a57b31c-34f4-3e4b-872c-32d728aaca3f", "description": "HUBzero CMS through 2.2.32 accepts session identifiers from query strings and request variables instead of cookies alone, allowing unauthenticated attackers to fixate victim sessions. Attackers can obtain a valid session identifier, send victims a crafted link containing it, and replay the identifier after the victim authenticates to hijack their account and access.", "datePublished": "2026-09-17T14:22:08", "dateUpdated": "2026-09-21T20:43:24", "baseScore": 8.5, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:A/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/hubzero/hubzero-cms/commit/e60e8ebee5e1d38b1db1fc41bd9164b265b24356", "https://github.com/hubzero/hubzero-cms", "https://github.com/hubzero/hubzero-cms/blob/v2.2.32/core/libraries/Hubzero/Session/Manager.php#L123-L132", "https://www.vulncheck.com/advisories/hubzero-cms-through-2.2.32-session-fixation-via-query-string-session-identifier"], "aliases": ["CVE-2026-92984", "GHSA-jq63-mx4g-ww7g"], "assigner": "VulnCheck", "epss": 0.46, "enisaIdProduct": [{"id": "f47568e0-c68e-3fe8-91c6-4d30e6ddc1fe", "product": {"name": "hubzero-cms", "vendor": {"name": "hubzero"}}, "product_version": "0 \u22642.2.32"}], "enisaIdVendor": [{"id": "67a724ec-2e0a-3de2-8750-a62746c19fb9", "vendor": {"name": "hubzero"}}], "isExploited": false}