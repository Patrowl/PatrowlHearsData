{"id": "EUVD-2026-97300", "enisaUuid": "861bed1d-ec8f-36e6-ad38-f491ea4b2d6a", "description": "A SQL Injection (SQLi) affects the Kong Gateway (Enterprise and Open Source) clustering communication logic when operating in Hybrid Mode. The issue can be triggered by sending specially crafted RPC requests to the Control Plane (CP), leading to potential unauthorized database access. Leveraging the issue requires network access to the Control Plane\u2019s clustering port and a valid client certificate and key.", "datePublished": "2026-10-12T08:38:54", "dateUpdated": "2026-10-15T18:07:25", "baseScore": 7.5, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:A/AC:L/AT:P/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://developer.konghq.com/gateway/changelog/#3-13-0-2", "https://github.com/Kong/kong/security/advisories/GHSA-vwxq-38j7-x48j"], "aliases": ["CVE-2026-1907", "GHSA-gjvg-7rjg-jm9f"], "assigner": "Kong", "epss": 0.13, "enisaIdProduct": [{"id": "6f93d9c5-ac86-328f-9db9-9a49315d8166", "product": {"name": "Kong Enterprise Gateway", "vendor": {"name": "Kong"}}, "product_version": "3.11.0.0 <3.11.0.8"}, {"id": "7cdeb7b8-6709-3a1b-ae70-a846a48c15b3", "product": {"name": "Kong Enterprise Gateway", "vendor": {"name": "Kong"}}, "product_version": "3.12.0.0 <3.12.0.4"}, {"id": "b0c6a613-02f0-3313-8093-f46cd49e5d14", "product": {"name": "Kong Gateway", "vendor": {"name": "Kong"}}, "product_version": "0 <3.9.4"}, {"id": "d497195d-d3d8-312f-b91d-ac53978838fe", "product": {"name": "Kong Enterprise Gateway", "vendor": {"name": "Kong"}}, "product_version": "3.13.0.0 <3.13.0.2"}, {"id": "ed783546-f14d-3791-b227-e9bbcd98640e", "product": {"name": "Kong Enterprise Gateway", "vendor": {"name": "Kong"}}, "product_version": "3.10.0.0 <3.10.0.9"}], "enisaIdVendor": [{"id": "63db71b9-1de2-3ae4-afad-9aa79a401cea", "vendor": {"name": "Kong"}}], "isExploited": false}