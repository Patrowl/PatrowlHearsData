{"id": "EUVD-2026-72390", "enisaUuid": "43a6ebc6-cb56-312f-8868-230086fa42c0", "description": "commonmark versions from 2.0.0 before 2.8.4 contain a denial of service vulnerability in XmlRenderer that emits depth-proportional indentation for every XML tag. Attackers can provide deeply nested Markdown or AST structures to cause quadratic memory consumption and output amplification, exhausting server resources.", "datePublished": "2026-09-07T12:53:51", "dateUpdated": "2026-10-08T15:25:53", "baseScore": 6.9, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/thephpleague/commonmark/security/advisories/GHSA-mj63-m3rc-8ppr", "https://www.vulncheck.com/advisories/commonmark-2.0.0-before-2.8.4-denial-of-service-via-xml"], "aliases": ["CVE-2026-86432", "GHSA-f58g-hmv8-g97m"], "assigner": "VulnCheck", "epss": 0.42, "enisaIdProduct": [{"id": "1dc400fe-7658-3c0c-9599-a750bfb6db90", "product": {"name": "commonmark", "vendor": {"name": "thephpleague"}}, "product_version": "2.0.0 <2.8.4"}], "enisaIdVendor": [{"id": "fd692729-237f-3610-b22f-56700fafebd7", "vendor": {"name": "thephpleague"}}], "isExploited": false}