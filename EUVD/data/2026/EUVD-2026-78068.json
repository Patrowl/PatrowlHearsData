{"id": "EUVD-2026-78068", "enisaUuid": "ccb9d5c7-808c-3c32-9428-396eb205c19a", "description": "IBM WebSphere Application Server 8.5 and 9.0, and IBM WebSphere Application Server - Liberty 17.0.0.3\u00a0through 26.0.0.8\u00a0are vulnerable to HTTP request smuggling, caused by improper parsing of the HTTP transfer-encoding request header. By sending a specially crafted HTTP transfer-encoding request header, an attacker could exploit this vulnerability to poison the web cache, bypass web application firewall protection, and conduct XSS attacks.", "datePublished": "2026-09-14T20:08:38", "dateUpdated": "2026-10-22T18:55:25", "baseScore": 6.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:N", "references": ["https://www.ibm.com/support/pages/node/7286610", "https://www.ibm.com/support/pages/node/7286611"], "aliases": ["CVE-2026-15396", "GHSA-2fc8-vf8h-jfvw"], "assigner": "ibm", "epss": 0.25, "enisaIdProduct": [{"id": "30a8ed88-251f-39d1-976b-112502dcba9c", "product": {"name": "WebSphere Application Server", "vendor": {"name": "IBM"}}, "product_version": "8.5"}, {"id": "b19b4841-8732-31d2-a723-9a7ad58e1b1f", "product": {"name": "WebSphere Application Server - Liberty", "vendor": {"name": "IBM"}}, "product_version": "17.0.0.3 \u226426.0.0.5"}, {"id": "f790191c-c9e2-3f38-83a3-e868a052e450", "product": {"name": "WebSphere Application Server", "vendor": {"name": "IBM"}}, "product_version": "9.0"}], "enisaIdVendor": [{"id": "9e92f303-337d-36b0-9fc3-a576370bbb49", "vendor": {"name": "IBM"}}], "isExploited": false}