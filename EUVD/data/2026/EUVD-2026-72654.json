{"id": "EUVD-2026-72654", "enisaUuid": "5cb84c94-2fbc-35a2-a69c-a684bdae3624", "description": "A flaw was found in Dogtag PKI, as used by FreeIPA's certificate authority component. The certificate profile import functionality does not fully validate uploaded profile content beyond the profile ID. An authenticated user with CA Administrator privileges can exploit Dogtag's ExternalProcessConstraint mechanism to execute arbitrary commands with attacker-controlled environment variables, achieving code execution as the pkiuser account.", "datePublished": "2026-09-08T07:55:29", "dateUpdated": "2026-10-21T11:19:43", "baseScore": 7.2, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:H", "references": ["https://access.redhat.com/errata/RHSA-2026:73765", "https://access.redhat.com/errata/RHSA-2026:73766", "https://access.redhat.com/errata/RHSA-2026:75573", "https://access.redhat.com/errata/RHSA-2026:86621", "https://access.redhat.com/errata/RHSA-2026:86623", "https://access.redhat.com/errata/RHSA-2026:86624", "https://access.redhat.com/errata/RHSA-2026:86625", "https://access.redhat.com/security/cve/CVE-2026-76561", "https://bugzilla.redhat.com/show_bug.cgi?id=2519523"], "aliases": ["GHSA-pp8g-7wxg-9php", "CVE-2026-76561"], "assigner": "redhat", "epss": 0.68, "enisaIdProduct": [{"id": "1543aeaa-2fa7-3454-a4c1-bfe8fcf53747", "product": {"name": "Red Hat Enterprise Linux 9.6 Extended Update Support", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:11.6.0-4.el9_6"}, {"id": "23573190-dba1-3b3c-8134-837fa16f7dad", "product": {"name": "Red Hat Enterprise Linux 9.4 Update Services for SAP Solutions", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:11.5.0-3.el9_4"}, {"id": "accc6045-4c67-35a8-a2da-1efc3b844b19", "product": {"name": "Red Hat Enterprise Linux 9", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 0:11.7.1-2.el9_8"}, {"id": "bea52eea-decd-39e0-82b7-3c35ffb0b889", "product": {"name": "Red Hat Ente