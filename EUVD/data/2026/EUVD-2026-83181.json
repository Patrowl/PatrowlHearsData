{"id": "EUVD-2026-83181", "enisaUuid": "9b4b729d-55e9-3078-90fa-f814ef28d394", "description": "Semantic MediaWiki is a free, open-source extension to MediaWiki that lets users store and query data within the wiki's pages. Prior to version 7.2.0, `sep` was inserted verbatim into HTML cell joins. This made it possible to inject HTML through the separator value. Version 7.2.0 fixes the issue.", "datePublished": "2026-09-18T16:51:10", "dateUpdated": "2026-09-18T19:55:00", "baseScore": 6.1, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N", "references": ["https://github.com/SemanticMediaWiki/SemanticMediaWiki/security/advisories/GHSA-7xv3-gf2g-498h", "https://github.com/SemanticMediaWiki/SemanticMediaWiki/releases/tag/7.2.0"], "aliases": ["GHSA-7xv3-gf2g-498h", "CVE-2026-77607"], "assigner": "GitHub_M", "epss": 0.28, "enisaIdProduct": [{"id": "153270af-f2a4-31b1-aeac-96b51d83eda0", "product": {"name": "SemanticMediaWiki", "vendor": {"name": "SemanticMediaWiki"}}, "product_version": "< 7.2.0"}], "enisaIdVendor": [{"id": "39355996-b269-3053-928f-b4e3a8a12390", "vendor": {"name": "SemanticMediaWiki"}}], "isExploited": false}