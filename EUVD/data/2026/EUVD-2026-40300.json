{"id": "EUVD-2026-40300", "enisaUuid": "9ac5e9fb-c30d-358e-9cf1-7c48e88def04", "description": "A flaw was found in Keycloak. A highly privileged user with `manage-clients` permission can exploit this vulnerability by injecting a hardcoded role mapper into any client. This action allows the user to bypass existing scope restrictions and inject the `realm-admin` role into generated tokens, resulting in privilege escalation and full administrative access to the realm.", "datePublished": "2026-06-30T12:00:28", "dateUpdated": "2026-10-22T20:39:25", "baseScore": 6.5, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:N", "references": ["https://access.redhat.com/errata/RHSA-2026:50846", "https://access.redhat.com/errata/RHSA-2026:50847", "https://access.redhat.com/errata/RHSA-2026:50848", "https://access.redhat.com/security/cve/CVE-2026-4629", "https://bugzilla.redhat.com/show_bug.cgi?id=2450244"], "aliases": ["CVE-2026-4629", "GHSA-m4j4-8chj-8g5f"], "assigner": "redhat", "epss": 0.49, "enisaIdProduct": [{"id": "1346da4c-c7ca-303f-8418-72c62d3828fe", "product": {"name": "Red Hat build of Keycloak 26.4", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.4.14-1"}, {"id": "94d2b0f2-3aa3-3846-b5e7-11b6eb2483bf", "product": {"name": "Red Hat build of Keycloak 26.4", "vendor": {"name": "Red Hat"}}, "product_version": "patch: 26.4-22"}], "enisaIdVendor": [{"id": "4f200398-33a8-3f08-976a-f64a10979ab2", "vendor": {"name": "Red Hat"}}], "isExploited": false}