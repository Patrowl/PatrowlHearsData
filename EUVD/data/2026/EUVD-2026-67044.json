{"id": "EUVD-2026-67044", "enisaUuid": "86e7fd8d-301a-3b56-b9b1-8d8239417424", "description": "openssl_encrypt versions before 1.4.9 store an unkeyed SHA-256 hash of the plaintext in the cleartext file header metadata. Attackers can read this hash without the password to confirm guessed plaintexts offline or fingerprint identical plaintexts across separately-encrypted files.", "datePublished": "2026-08-27T14:50:53", "dateUpdated": "2026-10-01T15:21:22", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://github.com/jahlives/openssl_encrypt/security/advisories/GHSA-7c3q-gp4v-q29q", "https://www.vulncheck.com/advisories/openssl-encrypt-before-1.4.9-plaintext-confirmation-oracle-via-sha-256"], "aliases": ["PYSEC-2026-3795", "CVE-2026-81688", "GHSA-pr7j-w8v9-qr7r"], "assigner": "VulnCheck", "epss": 0.27, "enisaIdProduct": [{"id": "40ac9240-c3ae-3526-ad31-eaae7003c94c", "product": {"name": "openssl_encrypt", "vendor": {"name": "jahlives"}}, "product_version": "0 <1.4.9"}], "enisaIdVendor": [{"id": "08fd7a88-75c9-3eb1-ae5b-c148544d7fa9", "vendor": {"name": "jahlives"}}], "isExploited": false}