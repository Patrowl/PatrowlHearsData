{"id": "EUVD-2026-81030", "enisaUuid": "d708faa7-ffa7-378a-a345-56f58bfab2a4", "description": "Pelican Panel versions before 1.0.0-beta35 enforce startup write permissions only through disabled form controls rather than server-side authorization checks. Attackers with startup.read permission can craft Livewire state updates to invoke afterStateUpdated callbacks and modify startup commands, docker images, and variables to execute arbitrary commands in the container.", "datePublished": "2026-09-16T20:32:29", "dateUpdated": "2026-09-18T18:29:21", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/pelican/panel/security/advisories/GHSA-4x28-f89q-2276", "https://github.com/pelican/panel/blob/fab5da496f7d837574b404e34dc42764a1d6b2c3/app/Filament/Server/Pages/Startup.php#L52-L77", "https://github.com/pelican/panel", "https://www.vulncheck.com/advisories/pelican-panel-before-1.0.0-beta35-authorization-bypass-via-startup"], "aliases": ["CVE-2026-92762", "GHSA-4mff-px8m-g899"], "assigner": "VulnCheck", "epss": 0.65, "enisaIdProduct": [{"id": "c6794af4-f4e5-3ac6-ab6d-673e8cebfd00", "product": {"name": "panel", "vendor": {"name": "ConvoyPanel"}}, "product_version": "0 <1.0.0-beta35"}], "enisaIdVendor": [{"id": "93f55020-bbfa-3548-bcf8-9f28ae0133f6", "vendor": {"name": "pelican"}}], "isExploited": false}