{"id": "EUVD-2026-105217", "enisaUuid": "f922bee2-13ae-35de-ab39-67391103cc91", "description": "ApostropheCMS is an open-source Node.js content management system. Prior to 1.5.5 of the Form add-on, 1.2.1 of login-recaptcha, and 1.3.0 of login-hcaptcha, these three CAPTCHA integrations interpolate an unencoded user-supplied response token into the provider verification request. Crafted tokens can smuggle request parameters and disrupt CAPTCHA verification and CAPTCHA-gated form or login flows; automated bypass probing is possible, but a successful CAPTCHA bypass or secret disclosure is not established. This issue is fixed in Form 1.5.5, login-recaptcha 1.2.1, and login-hcaptcha 1.3.0.", "datePublished": "2026-10-20T17:33:28", "dateUpdated": "2026-10-21T15:53:18", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:L/VA:L/SC:N/SI:N/SA:N", "references": ["https://github.com/apostrophecms/apostrophe/security/advisories/GHSA-44qr-rrjg-2cqq", "https://github.com/apostrophecms/apostrophe/commit/9500b8b0e1d630d5e07fbb5fd2c25ed0943845ce", "https://github.com/apostrophecms/apostrophe/commit/f84fd41cbf6c22eb8d0008fc9c25df1f7130b350", "https://github.com/apostrophecms/apostrophe/releases/tag/@apostrophecms/form@1.5.5"], "aliases": ["GHSA-44qr-rrjg-2cqq", "CVE-2026-113667"], "assigner": "GitHub_M", "epss": 0.35, "enisaIdProduct": [{"id": "0e663dbf-9d75-3150-87ff-8eeb8053672b", "product": {"name": "Apostrophe ", "vendor": {"name": "apostrophecms"}}, "product_version": "< 4.33.0"}, {"id": "941a4b68-0a60-3a6d-ae75-b8773a150859", "product": {"name": "login-recaptcha", "vendor": {"name": "@apostrophecms"}}, "product_version": "< 1.2.1"}, {"id": "bfa78ffb-66f7-3c1b-bdc4-e8d76e514a3c", "product": {"name": "login-hcaptcha", "vendor": {"name": "@apostrophecms"}}, "product_version": "< 1.3.0"}, {"id": "ce0767e0-67e9-306b-928a-157e1a26af71", "product": {"name": "form", "vendor": {"name": "neos"}}, "product_version": "< 1.5.5"}], "enisa