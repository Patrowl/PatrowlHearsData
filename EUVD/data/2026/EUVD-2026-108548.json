{"id": "EUVD-2026-108548", "enisaUuid": "7db24ecf-50ce-3677-91b4-1f35024fc76c", "description": "The system control service on affected Kiloview E3 NDI encoder firmware fails to sanitize the hostname parameter accepted by its device naming endpoint, passing it unquoted into a shell command. An authenticated web user with access to this function can embed characters to execute arbitrary operating system commands as root, resulting in full device compromise.", "datePublished": "2026-10-22T22:04:32", "dateUpdated": "2026-10-23T10:56:08", "baseScore": 9.4, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:H/SI:H/SA:H", "references": ["https://www.kiloview.com/en/download/e3-firmware-downloadlatest-12/", "https://www.cisa.gov/news-events/ics-advisories/icsa-26-295-01", "https://github.com/cisagov/CSAF/blob/develop/csaf_files/OT/white/2026/icsa-26-295-01.json"], "aliases": ["GHSA-f3x3-gqxc-76c6", "CVE-2026-107861"], "assigner": "icscert", "epss": 0.0, "enisaIdProduct": [{"id": "00fe595d-d9d7-3629-9e69-1390ea228180", "product": {"name": "E3 Firmware", "vendor": {"name": "Kiloview"}}, "product_version": "0 <1.30"}], "enisaIdVendor": [{"id": "d454182f-d68c-3861-9076-4183790888ac", "vendor": {"name": "Kiloview"}}], "isExploited": false}