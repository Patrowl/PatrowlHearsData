{"id": "EUVD-2012-6611", "enisaUuid": "a96fba2f-a1a4-3d5c-ae36-6de39aea1e09", "description": "Custom Tables plugin for WordPress before 3.4.6 contains a reflected cross-site scripting vulnerability that allows unauthenticated attackers to inject scripts through the unsanitized 'key' parameter in iframe.php. Attackers can craft GET requests to /wp-content/plugins/custom-tables/iframe.php with s=1 and a malicious key value to execute script in victims' browsers and steal cookies. Exploitation evidence was first observed by the Shadowserver Foundation on 2023-10-20.", "datePublished": "2026-10-20T20:31:19", "dateUpdated": "2026-10-20T20:31:19", "baseScore": 5.1, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:A/VC:N/VI:N/VA:N/SC:L/SI:L/SA:N", "references": ["https://www.exploit-db.com/exploits/37482", "https://wpscan.com/vulnerability/211a4286-4747-4b62-acc3-fd9a57b06252", "https://www.acunetix.com/vulnerabilities/web/wordpress-plugin-custom-tables-key-parameter-cross-site-scripting-3-4-4/", "https://github.com/projectdiscovery/nuclei-templates/blob/main/http/vulnerabilities/wordpress/wp-custom-tables-xss.yaml", "https://wordpress.org/plugins/custom-tables/", "https://www.vulncheck.com/advisories/custom-tables-wordpress-plugin-3.4.6-reflected-xss-via-iframe-php"], "aliases": ["CVE-2012-20003", "GHSA-wvm8-6956-c3j5"], "assigner": "VulnCheck", "epss": 0.22, "enisaIdProduct": [{"id": "eb75df6f-78e5-3b16-9249-647179c56948", "product": {"name": "Custom Tables", "vendor": {"name": "Web Updates KMU"}}, "product_version": "0 <3.4.6"}], "enisaIdVendor": [{"id": "63facc72-2718-332a-aade-b3dbd183ec3b", "vendor": {"name": "Web Updates KMU"}}], "isExploited": false}