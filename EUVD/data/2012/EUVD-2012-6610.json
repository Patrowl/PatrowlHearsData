{"id": "EUVD-2012-6610", "enisaUuid": "9b2cabbc-3cde-3f5b-a4e1-e0074a222932", "description": "TinyMCE Thumbnail Gallery plugin for WordPress before 1.1.0 contains a path traversal vulnerability that allows unauthenticated attackers to read arbitrary files via the href parameter. Attackers can send GET requests to /php/download-image.php with traversal sequences like ../../../../wp-config.php to retrieve database credentials and system files. Exploitation evidence was first observed by the Shadowserver Foundation on 2023-10-19.", "datePublished": "2026-10-20T20:31:18", "dateUpdated": "2026-10-20T20:31:18", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N", "references": ["https://packetstorm.news/files/id/113417/", "https://www.exploit-db.com/exploits/19022", "https://wpscan.com/vulnerability/4a49b023-c1c9-4cc4-a2fd-af5f911bb400", "https://github.com/projectdiscovery/nuclei-templates/blob/main/http/vulnerabilities/wordpress/wp-tinymce-lfi.yaml", "https://wordpress.org/plugins/tinymce-thumbnail-gallery/", "https://www.vulncheck.com/advisories/tinymce-thumbnail-gallery-wordpress-plugin-1.1.0-path-traversal-via-download-image-php"], "aliases": ["GHSA-58pf-x5g7-jcfh", "CVE-2012-20002"], "assigner": "VulnCheck", "epss": 0.41, "enisaIdProduct": [{"id": "56cff85a-2033-3ef5-8897-2c2e4fb4ed31", "product": {"name": "TinyMCE Thumbnail Gallery", "vendor": {"name": "James Charlesworth"}}, "product_version": "0.10 <1.1.0"}], "enisaIdVendor": [{"id": "3be4052e-26af-3983-a0ef-3eb583be1ff8", "vendor": {"name": "James Charlesworth"}}], "isExploited": false}