{"id": "EUVD-2020-30887", "enisaUuid": "599309ac-88e6-3b9b-ad36-32be5cd3dc09", "description": "Tendenci 12.3.1 contains a CSV formula injection vulnerability in the contact form message field that allows attackers to inject malicious formulas during export. Attackers can submit crafted payloads like '=10+20+cmd|' /C calc'!A0' in the message field to trigger arbitrary command execution when the CSV is opened in spreadsheet applications.", "datePublished": "2026-01-28T17:35:08", "dateUpdated": "2026-10-08T15:20:48", "baseScore": 5.3, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:P/VC:L/VI:L/VA:N/SC:N/SI:N/SA:N", "references": ["https://www.exploit-db.com/exploits/49145", "https://www.tendenci.com/", "https://github.com/tendenci/tendenci", "https://www.vulncheck.com/advisories/tendenci-csv-formula-injection"], "aliases": ["PYSEC-2026-136", "CVE-2020-36962", "GHSA-4q3w-jgfx-4792"], "assigner": "VulnCheck", "epss": 12.19, "enisaIdProduct": [{"id": "2567c17d-cc62-3c74-9eb2-af7caf12957d", "product": {"name": "tendenci", "vendor": {"name": "tendenci"}}, "product_version": "12.3.1"}], "enisaIdVendor": [{"id": "eeab8ff5-b4f5-3842-8574-5a09d30ff732", "vendor": {"name": "tendenci"}}], "isExploited": false}