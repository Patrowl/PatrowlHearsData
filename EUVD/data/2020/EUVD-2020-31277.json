{"id": "EUVD-2020-31277", "enisaUuid": "9c1c302b-cd3d-39c3-920e-1fe1c88a0568", "description": "cbor-sync through 1.0.4 contains a resource exhaustion vulnerability in CBOR.decode that trusts declared array and map lengths without checking remaining input. Remote attackers can supply a tiny crafted CBOR payload declaring huge lengths to drive billions of iterations, exhausting CPU and process memory.", "datePublished": "2026-10-12T20:55:04", "dateUpdated": "2026-10-13T16:52:41", "baseScore": 8.7, "baseScoreVersion": "4.0", "baseScoreVector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", "references": ["https://github.com/PelionIoT/cbor-sync/pull/4", "https://github.com/PelionIoT/cbor-sync/issues/6", "https://github.com/PelionIoT/cbor-sync", "https://www.vulncheck.com/advisories/cbor-sync-through-1.0.4-memory-exhaustion-via-unchecked-cbor-array-lengths"], "aliases": ["GHSA-fpg7-639f-4v49", "CVE-2020-37280"], "assigner": "VulnCheck", "epss": 0.54, "enisaIdProduct": [{"id": "028f4135-5cd6-3024-8782-84fd2aba756a", "product": {"name": "cbor-sync", "vendor": {"name": "PelionIoT"}}, "product_version": "0 \u22641.0.4"}], "enisaIdVendor": [{"id": "fc6fdae0-06c0-3dbc-833e-f7831daa43a9", "vendor": {"name": "PelionIoT"}}], "isExploited": false}