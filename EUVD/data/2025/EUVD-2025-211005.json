{"id": "EUVD-2025-211005", "enisaUuid": "a64f8de0-d8ec-361f-887d-d4ba253907ac", "description": "The mysqlnd wire protocol parser reads fields out of server packets before checking that the packet still holds enough bytes for them. A malicious or compromised MySQL server can send a truncated packet and make the client read past the end of the packet buffer, which is undefined behaviour and can crash the process.", "datePublished": "2026-09-25T20:48:21", "dateUpdated": "2026-09-28T13:31:31", "baseScore": 3.4, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:A/AC:H/PR:N/UI:N/S:C/C:L/I:N/A:N", "references": ["https://github.com/php/php-src/security/advisories/GHSA-r6x9-5r99-36j7"], "aliases": ["CVE-2025-1218"], "assigner": "php", "epss": 0.18, "enisaIdProduct": [{"id": "2f8cc879-a56a-30ee-9eda-58dd65b02239", "product": {"name": "PHP", "vendor": {"name": "PHP Group"}}, "product_version": "8.3.* <8.3.35"}, {"id": "5ff6afbe-0f2e-3c74-bd5b-4756646e7523", "product": {"name": "PHP", "vendor": {"name": "PHP Group"}}, "product_version": "8.4.* <8.4.26"}, {"id": "721b891a-4e1e-3a3c-af2a-3a69dbaa7076", "product": {"name": "PHP", "vendor": {"name": "PHP Group"}}, "product_version": "8.5.* <8.5.11"}, {"id": "b2b3d6d2-1355-3585-a41f-c90f228563f1", "product": {"name": "PHP", "vendor": {"name": "PHP Group"}}, "product_version": "8.2.* <8.2.34"}], "enisaIdVendor": [{"id": "53e0923e-ee2a-3270-a4c0-e450ba139bce", "vendor": {"name": "PHP Group"}}], "isExploited": false}