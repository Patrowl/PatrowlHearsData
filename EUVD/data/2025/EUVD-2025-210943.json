{"id": "EUVD-2025-210943", "enisaUuid": "5907fc53-04d1-398d-bbc6-5040ee8222f7", "description": "Semantic MediaWiki is a free, open-source extension to MediaWiki that lets users store and query data within the wiki's pages. Versions starting in 3.1.0 and prior to 7.0.0 insert the unsanitized value of a data attribute into the DOM as HTML, allowing for stored XSS through wikitext. Version 7.0.0 patches the issue.", "datePublished": "2026-09-18T16:09:06", "dateUpdated": "2026-09-18T17:23:49", "baseScore": 8.6, "baseScoreVersion": "3.1", "baseScoreVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:L/A:L", "references": ["https://github.com/SemanticMediaWiki/SemanticMediaWiki/security/advisories/GHSA-hg8h-557g-q8pp", "https://github.com/SemanticMediaWiki/SemanticMediaWiki/releases/tag/7.0.0"], "aliases": ["GHSA-hg8h-557g-q8pp", "CVE-2025-61682"], "assigner": "GitHub_M", "epss": 0.29, "enisaIdProduct": [{"id": "23ac92db-5dfd-32aa-977b-7f22d02a91cc", "product": {"name": "SemanticMediaWiki", "vendor": {"name": "SemanticMediaWiki"}}, "product_version": "3.1.0, < 7.0.0"}], "enisaIdVendor": [{"id": "12d33d5c-1ab4-38fa-83b4-16f8e549afdc", "vendor": {"name": "SemanticMediaWiki"}}], "isExploited": false}